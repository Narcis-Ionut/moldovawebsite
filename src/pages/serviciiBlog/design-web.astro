---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import "../../styles/dev-ru-blog-services.css";

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      name: "Design Web Profesional în Moldova | Interfețe Moderne",
      description:
        "Design web în Moldova pentru interfețe clare, responsive și ușor de folosit, realizat direct de un dezvoltator web independent din Chișinău.",
      url: "https://chisinauweb.com/serviciiBlog/design-web/",
      inLanguage: "ro-MD",
      breadcrumb: {
        "@type": "BreadcrumbList",
        itemListElement: [
          {
            "@type": "ListItem",
            position: 1,
            name: "Acasă",
            item: "https://chisinauweb.com/",
          },
          {
            "@type": "ListItem",
            position: 2,
            name: "Servicii",
            item: "https://chisinauweb.com/serviciiBlog/",
          },
          {
            "@type": "ListItem",
            position: 3,
            name: "Design Web",
            item: "https://chisinauweb.com/serviciiBlog/design-web/",
          },
        ],
      },
    },
    {
      "@type": "Service",
      serviceType: "Design web",
      name: "Servicii de design web în Moldova",
      description:
        "Structură, UX/UI și interfețe responsive pentru site-uri de prezentare, magazine online și aplicații web.",
      provider: {
        "@type": "Person",
        name: "Narcis",
        url: "https://chisinauweb.com/about/",
        jobTitle: "Dezvoltator web independent",
        worksFor: {
          "@type": "Organization",
          name: "ChisinauWeb.com",
          url: "https://chisinauweb.com/",
        },
      },
      areaServed: { "@type": "Country", name: "Moldova" },
      availableLanguage: ["ro", "ru"],
      url: "https://chisinauweb.com/serviciiBlog/design-web/",
      offers: {
        "@type": "Offer",
        url: "https://chisinauweb.com/contact/",
        priceCurrency: "EUR",
        availability: "https://schema.org/InStock",
      },
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Designul este adaptat pentru mobil?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Da. Interfața este verificată pentru telefoane, tablete și ecrane desktop, iar componentele sunt adaptate la conținutul real al proiectului.",
          },
        },
        {
          "@type": "Question",
          name: "Includeți și partea de UX, nu doar aspect vizual?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Da. Serviciul acoperă structura paginii, ierarhia informației, navigarea și stările importante ale interfeței, nu doar culorile.",
          },
        },
        {
          "@type": "Question",
          name: "Se poate continua cu dezvoltarea după design?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Da. Pot continua cu implementarea site-ului sau pot preda materialele stabilite pentru a fi folosite de alt dezvoltator.",
          },
        },
      ],
    },
  ],
};
---

<!doctype html>
<html lang="ro">
  <head>
    <BaseHead
      title="Design Web Profesional în Moldova"
      description="Design web în Moldova pentru site-uri clare și responsive. Structură UX/UI, pagini pentru mobil și implementare directă cu Narcis."
      canonicalUrl="https://chisinauweb.com/serviciiBlog/design-web/"
      hreflangRo="https://chisinauweb.com/serviciiBlog/design-web/"
      hreflangRu="https://chisinauweb.com/ru/serviciiBlog/design-web/"
      ogType="article"
      jsonLd={jsonLd}
    />
  </head>
  <body class="dev-ru-theme">
    <Header lang="ro" />

    <!-- Hero Section -->
    <section class="hero">
      <div class="container grid">
        <div class="hero-content">
          <h1>
            Design web profesional în Moldova pentru interfețe clare și utile
          </h1>
          <p class="subheading">
            Sunt Narcis, dezvoltator web independent în Chișinău. Organizez
            conținutul și interfața astfel încât site-ul să fie ușor de urmărit
            pe telefon și desktop, fără efecte care îngreunează folosirea lui.
          </p>
          <div class="hero-actions">
            <a href="/contact/" class="btn btn-primary">Descrie proiectul</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Main Content -->
    <section class="content-section">
      <div class="container">
        <div class="section-title">
          <h2>Ce înseamnă un design web de calitate pentru afacerea ta</h2>
          <p>
            Un design bun explică oferta, păstrează acțiunile importante la
            vedere și folosește conținutul pe care îl poți susține în realitate.
          </p>
        </div>

        <div class="content-grid">
          <div class="content-block">
            <h3>Prima impresie contează</h3>
            <p>
              Vizitatorul trebuie să înțeleagă repede cine ești, ce oferi și
              care este următorul pas. De aceea încep cu mesajul, ordinea
              secțiunilor și acțiunile importante, nu cu animațiile.
            </p>
            <p>
              Pentru un proiect de design web în Chișinău sau Moldova folosesc
              limba, exemplele, datele de contact și obiceiurile de cumpărare
              relevante pentru publicul afacerii tale. Nu inventez recenzii,
              rezultate sau elemente de încredere care nu pot fi demonstrate.
            </p>
          </div>
          <div class="content-image">
            <img
              src="/assets/design-web-1.webp"
              alt="Design web profesional pentru afaceri din Moldova"
              width="500"
              height="300"
              loading="lazy"
            />
          </div>
        </div>

        <div class="content-grid reverse">
          <div class="content-block">
            <h3>Experiența utilizatorului (UX) este prioritară</h3>
            <p>
              Un site poate arăta bine și totuși să fie confuz. În proiect
              verific:
            </p>
            <ul>
              <li>navigarea și ierarhia informației;</li>
              <li>stările butoanelor, formularelor și mesajelor de eroare;</li>
              <li>lungimea realistă a textelor și titlurilor;</li>
              <li>contrastul, lizibilitatea și folosirea tastaturii;</li>
              <li>traseul de la pagină la contact, comandă sau autentificare.</li>
            </ul>
            <p>
              Designul poate face acțiunile mai clare, dar nu poate garanta
              vânzări sau conversii. Oferta, prețul, reputația și traficul rămân
              factori separați.
            </p>
          </div>
          <div class="content-image">
            <img
              src="/assets/design-web-2.webp"
              alt="Structură UX pentru un site din Moldova"
              width="500"
              height="300"
              loading="lazy"
            />
          </div>
        </div>

        <div class="content-grid">
          <div class="content-block">
            <h3>Design adaptat tuturor dispozitivelor (Responsive)</h3>
            <p>
              Proiectez începând cu ecranele mici și verific apoi comportamentul
              pe dimensiuni mai mari. Un design responsive nu este aceeași
              pagină micșorată, ci o interfață care își reorganizează conținutul.
            </p>
            <ul>
              <li>meniuri și butoane ușor de folosit prin atingere;</li>
              <li>texte și imagini care nu depășesc ecranul;</li>
              <li>formulare potrivite pentru tastatura telefonului;</li>
              <li>layout verificat pe telefon, tabletă și desktop.</li>
            </ul>
            <p>
              Verificarea acoperă browsere și dimensiuni uzuale. Dispozitivele
              vechi sau comportamentele speciale se includ numai dacă sunt
              importante pentru publicul proiectului.
            </p>
          </div>
          <div class="content-image">
            <img
              src="/assets/design-web-3.webp"
              alt="Interfață responsive pe telefon și desktop"
              width="500"
              height="300"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Process Section -->
    <section class="process">
      <div class="container">
        <div class="section-title">
          <h2>Cum creez designul site-ului tău</h2>
          <p>
            Primești explicații directe și vezi progresul înainte ca interfața
            să fie implementată integral.
          </p>
        </div>

        <div class="process-steps">
          <div class="step">
            <div class="step-number">1</div>
            <h3 class="step-title">Analiză și cercetare</h3>
            <p class="step-desc">
              Îmi explici afacerea, publicul, conținutul disponibil și ce trebuie
              să poată face pagina.
            </p>
          </div>
          <div class="step">
            <div class="step-number">2</div>
            <h3 class="step-title">Wireframe și structură</h3>
            <p class="step-desc">
              Așez informația și acțiunile principale într-o schiță simplă,
              înainte de detaliile vizuale.
            </p>
          </div>
          <div class="step">
            <div class="step-number">3</div>
            <h3 class="step-title">Design vizual</h3>
            <p class="step-desc">
              Aplic identitatea vizuală existentă sau definesc un sistem vizual
              restrâns pentru site, în limitele agreate.
            </p>
          </div>
          <div class="step">
            <div class="step-number">4</div>
            <h3 class="step-title">Feedback și ajustări</h3>
            <p class="step-desc">
              Îți arăt direcția, discutăm observațiile și ajustez elementele
              incluse în scopul proiectului.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Services Section -->
    <section class="services">
      <div class="container">
        <div class="section-title">
          <h2>Ce poate include serviciul de design web</h2>
          <p>Livrabilele exacte se stabilesc după ce văd conținutul și funcțiile proiectului.</p>
        </div>

        <div class="service-grid">
          <div class="service-card">
            <div class="service-icon">🎨</div>
            <h3 class="service-title">Design personalizat</h3>
            <p class="service-desc">
              O structură adaptată conținutului și identității tale, nu o
              machetă prezentată ca proiect real.
            </p>
          </div>
          <div class="service-card">
            <div class="service-icon">📱</div>
            <h3 class="service-title">Responsive Design</h3>
            <p class="service-desc">
              Componente și pagini adaptate pentru dimensiuni uzuale de telefon,
              tabletă și desktop.
            </p>
          </div>
          <div class="service-card">
            <div class="service-icon">🖼️</div>
            <h3 class="service-title">Selecție imagini</h3>
            <p class="service-desc">
              Folosirea fotografiilor și materialelor tale sau alegerea unor
              resurse licențiate, cu sursa explicată.
            </p>
          </div>
          <div class="service-card">
            <div class="service-icon">🔍</div>
            <h3 class="service-title">Optimizare UX/UI</h3>
            <p class="service-desc">
              Ierarhie, navigare, formulare și stări de interacțiune explicate
              clar.
            </p>
          </div>
          <div class="service-card">
            <div class="service-icon">📊</div>
            <h3 class="service-title">Testare utilizabilitate</h3>
            <p class="service-desc">
              Verificare practică a traseelor importante; cercetarea formală cu
              utilizatori se estimează separat dacă este necesară.
            </p>
          </div>
          <div class="service-card">
            <div class="service-icon">🚀</div>
            <h3 class="service-title">Pregătire pentru implementare</h3>
            <p class="service-desc">
              Componente, dimensiuni și comportamente care pot fi transpuse
              coerent în cod.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="faq">
      <div class="container">
        <div class="section-title">
          <h2>Întrebări frecvente despre design web</h2>
          <p>
            Detalii practice despre materialele necesare, revizii și predare.
          </p>
        </div>

        <div class="faq-list">
          <details>
            <summary
              >Cât durează crearea unui design web pentru afaceri din Moldova?</summary
            >
            <p>
              Termenul depinde de numărul de pagini și stări, de conținut și de
              viteza cu care primesc feedback. Îți comunic estimarea după ce
              văd cerințele; nu promit un termen fix înainte de analiză.
            </p>
          </details>
          <details>
            <summary
              >De ce aveți nevoie pentru a începe procesul de design?</summary
            >
            <p>
              Am nevoie de obiectivul site-ului, serviciile sau produsele,
              textele disponibile, logo și materiale vizuale dacă există,
              datele reale de contact și exemplele care îți plac sau nu îți
              plac.
            </p>
          </details>
          <details>
            <summary>Pot face modificări la design după ce îl văd?</summary>
            <p>
              Da. Numărul de runde și ce înseamnă o revizie se notează în ofertă.
              O schimbare completă de direcție sau funcții noi se estimează
              separat, ca să fie clar pentru ambele părți.
            </p>
          </details>
          <details>
            <summary>Ce se întâmplă după finalizarea designului?</summary>
            <p>
              Pot continua cu dezvoltarea și publicarea sau pot preda
              livrabilele convenite pentru alt dezvoltator. Accesul la domeniu,
              hosting și conturile cumpărate pentru proiect rămâne la client.
            </p>
          </details>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="cta-section">
      <div class="container grid">
        <div class="cta-container">
          <h2>Ai nevoie de un design web mai clar?</h2>
          <p class="subheading">
            Trimite-mi pagina existentă sau explică-mi ce vrei să construiești.
            Îți spun ce merită proiectat, ce poate fi simplificat și ce materiale
            lipsesc.
          </p>
          <a href="/contact/" class="btn btn-primary">Descrie proiectul</a>
        </div>
      </div>
    </section>

    <Footer lang="ro" />

    <script src="/script.js" defer></script>
  </body>
</html>







