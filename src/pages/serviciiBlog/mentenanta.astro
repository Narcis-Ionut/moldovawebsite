---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import "../../styles/dev-ru-blog-services.css";

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      name: "Mentenanță Site Web în Moldova | Actualizări și Suport",
      description:
        "Mentenanță site web în Moldova de la 25 EUR pe lună, cu scop stabilit după audit: actualizări, backup, verificări și intervenții tehnice.",
      url: "https://chisinauweb.com/serviciiBlog/mentenanta/",
      inLanguage: "ro-MD",
      breadcrumb: {
        "@type": "BreadcrumbList",
        itemListElement: [
          {
            "@type": "ListItem",
            position: 1,
            name: "Acasă",
            item: "https://chisinauweb.com/",
          },
          {
            "@type": "ListItem",
            position: 2,
            name: "Servicii",
            item: "https://chisinauweb.com/serviciiBlog/",
          },
          {
            "@type": "ListItem",
            position: 3,
            name: "Mentenanță",
            item: "https://chisinauweb.com/serviciiBlog/mentenanta/",
          },
        ],
      },
    },
    {
      "@type": "Service",
      serviceType: "Mentenanță site web",
      name: "Servicii de mentenanță site în Moldova",
      description:
        "Evaluare și mentenanță pentru site-uri și magazine online, cu actualizări, backup și intervenții definite în oferta proiectului.",
      provider: {
        "@type": "Person",
        name: "Narcis",
        url: "https://chisinauweb.com/about/",
        jobTitle: "Dezvoltator web independent",
        worksFor: {
          "@type": "Organization",
          name: "ChisinauWeb.com",
          url: "https://chisinauweb.com/",
        },
      },
      areaServed: { "@type": "Country", name: "Moldova" },
      availableLanguage: ["ro", "ru"],
      url: "https://chisinauweb.com/serviciiBlog/mentenanta/",
      offers: {
        "@type": "Offer",
        url: "https://chisinauweb.com/contact/",
        price: "25",
        priceCurrency: "EUR",
        name: "Mentenanță site de la 25 EUR pe lună",
        availability: "https://schema.org/InStock",
      },
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Ce include mentenanța lunară a site-ului?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Scopul se stabilește după audit și poate include actualizări, verificarea backupului, remedierea erorilor și modificări mici. Frecvența și limitele sunt scrise în ofertă.",
          },
        },
        {
          "@type": "Question",
          name: "Mentenanța ajută la viteză și stabilitate?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Mentenanța poate identifica erori și degradări de performanță, dar rezultatul depinde de cod, hosting, trafic și servicii externe. Intervențiile se prioritizează după impact.",
          },
        },
        {
          "@type": "Question",
          name: "Puteți prelua și site-uri făcute de alte echipe?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Da, după o evaluare tehnică și după ce primesc accesul necesar. Pot refuza sau estima separat un site care are probleme structurale ori tehnologii pe care nu le pot întreține responsabil.",
          },
        },
      ],
    },
  ],
};
---

<!doctype html>
<html lang="ro">
  <head>
    <BaseHead
      title="Mentenanță Site Web în Moldova"
      description="Mentenanță site web în Moldova de la 25 EUR/lună. Audit inițial, actualizări, backup și intervenții cu scop și limite stabilite clar."
      canonicalUrl="https://chisinauweb.com/serviciiBlog/mentenanta/"
      hreflangRo="https://chisinauweb.com/serviciiBlog/mentenanta/"
      hreflangRu="https://chisinauweb.com/ru/serviciiBlog/mentenanta/"
      ogType="article"
      jsonLd={jsonLd}
    />
  </head>
  <body class="dev-ru-theme">
    <Header lang="ro" />

    <!-- Hero Section -->
    <section class="hero">
      <div class="container grid">
        <div class="hero-content">
          <h1>
            Mentenanță site web în Moldova, cu scop și limite clare
          </h1>
          <p class="subheading">
            Sunt Narcis, dezvoltator web independent în Chișinău. Mentenanța
            pornește de la <strong>25 EUR/lună</strong>, după o verificare a
            site-ului și stabilirea exactă a actualizărilor, backupului și
            intervențiilor incluse.
          </p>
          <div class="hero-actions">
            <a href="/contact/" class="btn btn-primary">Cere evaluare</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Main Content -->
    <section class="content-section">
      <div class="container">
        <div class="section-title">
          <h2>Ce rezolvă mentenanța unui site</h2>
          <p>
            Mentenanța reduce riscul ca actualizările, erorile sau schimbările
            serviciilor externe să rămână neobservate. Nu este o garanție că un
            site nu va avea incidente.
          </p>
        </div>

        <div class="content-grid">
          <div class="content-block">
            <p class="service-card-title">Actualizări și verificări tehnice</p>
            <p>
              După ce înțeleg tehnologia și accesul disponibil, pot include:
            </p>
            <ul>
              <li>actualizarea componentelor care intră în responsabilitatea mea;</li>
              <li>verificarea erorilor apărute după o actualizare;</li>
              <li>controlul formularelor, certificatelor și rutelor importante;</li>
              <li>verificarea existenței și utilizabilității unei copii de siguranță.</li>
            </ul>
            <p>
              Frecvența backupului și locul unde este păstrat depind de hosting,
              baza de date și cât de des se schimbă conținutul. Aceste detalii
              se scriu în ofertă, nu se presupun.
            </p>
          </div>
          <div class="content-image">
            <img
              src="/assets/mentenanta-1.webp"
              alt="Verificări tehnice pentru mentenanța unui site"
              width="500"
              height="300"
              loading="lazy"
            />
          </div>
        </div>

        <div class="content-grid reverse">
          <div class="content-block">
            <p class="service-card-title">Erori și performanță</p>
            <p>
              Un site poate încetini din cauza imaginilor, codului, bazei de
              date, hostingului sau unui serviciu terț. În funcție de proiect,
              verific:
            </p>
            <ul>
              <li>resursele și imaginile încărcate pe paginile importante;</li>
              <li>erorile din aplicație sau din răspunsurile serverului;</li>
              <li>schimbări de performanță după actualizări;</li>
              <li>problemele care pot fi reproduse pe mobil sau desktop.</li>
            </ul>
            <p>
              Recomandarea poate fi o corecție locală, o schimbare de hosting
              sau un proiect separat. Mentenanța nu garantează un scor, o
              poziție în Google sau disponibilitate neîntreruptă.
            </p>
          </div>
          <div class="content-image">
            <img
              src="/assets/mentenanta-2.webp"
              alt="Diagnostic de performanță pentru un site web"
              width="500"
              height="300"
              loading="lazy"
            />
          </div>
        </div>

        <div class="content-grid">
          <div class="content-block">
            <p class="service-card-title">Intervenții și modificări convenite</p>
            <p>În ofertă se notează exact ce tip de cereri intră în abonament:</p>
            <ul>
              <li>corectarea unei erori reproductibile;</li>
              <li>schimbări mici de text, imagine sau date de contact;</li>
              <li>verificarea unei integrări deja existente;</li>
              <li>recomandări pentru probleme care cer un proiect separat.</li>
            </ul>
            <p>
              Funcțiile noi, redesignul, migrarea, recuperarea după un incident
              major și intervențiile urgente sunt estimate separat dacă nu apar
              explicit în acord.
            </p>
          </div>
          <div class="content-image">
            <img
              src="/assets/mentenanta-3.webp"
              alt="Intervenții de mentenanță pentru un site web"
              width="500"
              height="300"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Process Section -->
    <section class="process">
      <div class="container">
        <div class="section-title">
          <h2>Cum funcționează mentenanța</h2>
          <p>
            Nu preiau un site fără să înțeleg mai întâi starea lui și accesul
            disponibil.
          </p>
        </div>

        <div class="process-steps">
          <div class="step">
            <div class="step-number">1</div>
            <p class="step-title">Analiză inițială</p>
            <p class="step-desc">
              Verific tehnologia, hostingul, actualizările, erorile vizibile și
              modul în care sunt făcute copiile de siguranță.
            </p>
          </div>
          <div class="step">
            <div class="step-number">2</div>
            <p class="step-title">Plan de mentenanță</p>
            <p class="step-desc">
              Propun ce merită verificat, frecvența, canalul de comunicare,
              timpul de răspuns și ce rămâne în afara abonamentului.
            </p>
          </div>
          <div class="step">
            <div class="step-number">3</div>
            <p class="step-title">Mentenanță regulată</p>
            <p class="step-desc">
              Fac verificările și intervențiile agreate și notez schimbările
              care pot afecta funcționarea site-ului.
            </p>
          </div>
          <div class="step">
            <div class="step-number">4</div>
            <p class="step-title">Raportare și recomandări</p>
            <p class="step-desc">
              Primești o explicație scurtă despre ce am schimbat, ce rămâne de
              urmărit și ce necesită o ofertă separată.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Services Section -->
    <section class="services">
      <div class="container">
        <div class="section-title">
          <h2>Ce poate include serviciul de mentenanță web</h2>
          <p>
            Elementele de mai jos se aleg după audit și se scriu cu frecvență și
            limite concrete în oferta de mentenanță.
          </p>
        </div>

        <div class="service-grid">
          <div class="service-card">
            <div class="service-icon">🔒</div>
            <p class="service-title">Actualizări de securitate</p>
            <p class="service-desc">
              Actualizarea componentelor întreținute și verificarea problemelor
              apărute după schimbare.
            </p>
          </div>
          <div class="service-card">
            <div class="service-icon">💾</div>
            <p class="service-title">Backup regulat</p>
            <p class="service-desc">
              Verificarea sau configurarea copiilor de siguranță în funcție de
              hosting și ritmul de modificare a datelor.
            </p>
          </div>
          <div class="service-card">
            <div class="service-icon">⚡</div>
            <p class="service-title">Optimizare performanță</p>
            <p class="service-desc">
              Diagnostic și corecții punctuale; refactorizările mari se
              estimează separat.
            </p>
          </div>
          <div class="service-card">
            <div class="service-icon">📊</div>
            <p class="service-title">Verificări de disponibilitate</p>
            <p class="service-desc">
              Monitorizare numai dacă este inclusă și configurată; nu presupune
              supraveghere sau intervenție permanentă.
            </p>
          </div>
          <div class="service-card">
            <div class="service-icon">📝</div>
            <p class="service-title">Actualizări conținut</p>
            <p class="service-desc">
              Modificări mici convenite; paginile noi și schimbările de structură
              nu sunt incluse implicit.
            </p>
          </div>
          <div class="service-card">
            <div class="service-icon">🛠️</div>
            <p class="service-title">Suport tehnic</p>
            <p class="service-desc">
              Comunicare directă cu mine, în canalul și intervalul de răspuns
              stabilite în ofertă.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Packages Section -->
    <section class="pricing">
      <div class="container">
        <div class="section-title">
          <h2>Mentenanță site web de la 25 EUR pe lună</h2>
          <p>
            Prețul de pornire este pentru un scop restrâns, stabilit după audit.
            Oferta finală depinde de tehnologie, risc, acces și frecvența
            schimbărilor.
          </p>
        </div>

        <div class="pricing-grid">
          <div class="price-card card1">
            <p class="service-card-title">Mentenanță de bază</p>
            <div class="price">de la 25 EUR/lună</div>
            <ul>
              <li>audit inițial înainte de preluare;</li>
              <li>lista exactă a componentelor întreținute;</li>
              <li>frecvența actualizărilor și a verificărilor agreată;</li>
              <li>reguli clare pentru backup și restaurare;</li>
              <li>canal și interval de răspuns stabilite în ofertă.</li>
            </ul>
            <a href="/contact/" class="btn btn-primary">Solicită ofertă</a>
          </div>

          <div class="price-card card2">
            <p class="service-card-title">Ce poate schimba prețul</p>
            <div class="price">după audit</div>
            <ul>
              <li>magazin online sau date care se schimbă frecvent;</li>
              <li>mai multe integrări și servicii externe;</li>
              <li>cod vechi ori fără documentație;</li>
              <li>cereri de conținut sau funcții noi;</li>
              <li>nevoia unui timp de răspuns mai scurt.</li>
            </ul>
            <a href="/contact/" class="btn btn-primary">Cere evaluare</a>
          </div>

          <div class="price-card card3">
            <p class="service-card-title">Ce nu este inclus automat</p>
            <div class="price">se estimează separat</div>
            <ul>
              <li>suport permanent sau intervenții non-stop;</li>
              <li>modificări în afara limitei scrise în ofertă;</li>
              <li>redesign, migrare sau funcții noi;</li>
              <li>recuperare după incidente anterioare;</li>
              <li>costurile hostingului și ale furnizorilor terți.</li>
            </ul>
            <a href="/contact/" class="btn btn-primary">Descrie site-ul</a>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="faq">
      <div class="container">
        <div class="section-title">
          <h2>Întrebări frecvente despre mentenanța site-urilor web</h2>
          <p>
            Ce trebuie verificat înainte să preiau un site și cum se stabilește
            scopul lunar.
          </p>
        </div>

        <div class="faq-list">
          <details>
            <summary
              >Ce se întâmplă dacă nu fac mentenanță la site-ul web?</summary
            >
            <p>
              Componentele și serviciile externe se schimbă. Fără verificări,
              actualizările pot rămâne nefăcute, formularele se pot opri, iar o
              eroare poate fi observată târziu. Riscul diferă mult între un site
              static și un magazin cu conturi și plăți.
            </p>
          </details>
          <details>
            <summary>Pot face mentenanța singur pentru site-ul meu?</summary>
            <p>
              Da, dacă ai documentație, acces și un proces de backup testat.
              Actualizările de conținut pot fi simple. Înainte de schimbări de
              cod, baze de date sau integrări este important să știi cum revii
              la versiunea anterioară dacă apare o problemă.
            </p>
          </details>
          <details>
            <summary>Cât de des trebuie să fac backup la site-ul meu?</summary>
            <p>
              Frecvența depinde de cât de multe date s-ar pierde între două
              copii și de ce oferă hostingul. O copie este utilă doar dacă poate
              fi găsită și restaurată. De aceea stabilesc frecvența și
              responsabilitatea după audit, nu folosesc aceeași regulă pentru
              toate site-urile.
            </p>
          </details>
          <details>
            <summary>Mă puteți ajuta cu un site creat de altă companie?</summary
            >
            <p>
              Da, după o evaluare a codului, tehnologiei, accesului și problemelor
              cunoscute. Dacă site-ul nu poate fi întreținut responsabil fără o
              reparație inițială sau o migrare, explic acest lucru și estimez
              separat lucrarea.
            </p>
          </details>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="cta-section">
      <div class="container grid">
        <div class="cta-container">
          <h2>Ai un site care trebuie verificat sau întreținut?</h2>
          <p class="subheading">
            Trimite-mi adresa site-ului, tehnologia dacă o cunoști și problemele
            observate. Îți spun ce pot prelua, ce trebuie reparat întâi și ce
            ar include abonamentul.
          </p>
          <a href="/contact/" class="btn btn-primary">Cere evaluare</a>
        </div>
      </div>
    </section>

    <Footer lang="ro" />

    <script src="/script.js" defer></script>
  </body>
</html>







