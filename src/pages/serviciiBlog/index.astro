---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import "../../styles/dev-pages.css";
import { roLandingCards } from "../../data/landingPages.ro";

const services = [
  {
    href: "/serviciiBlog/design-web/",
    title: "Design web",
    description:
      "Structură vizuală, ierarhie și interfețe responsive pentru site-uri ușor de înțeles și de folosit.",
  },
  {
    href: "/serviciiBlog/dezvoltare-web/",
    title: "Dezvoltare web",
    description:
      "Site-uri de prezentare și aplicații web construite în jurul funcțiilor de care proiectul are nevoie în realitate.",
  },
  {
    href: "/serviciiBlog/seo-on-page/",
    title: "SEO on-page",
    description:
      "Audit tehnic, meta-taguri, conținut și legături interne care ajută motoarele de căutare să înțeleagă site-ul.",
  },
  {
    href: "/serviciiBlog/magazin-online/",
    title: "Magazin online",
    description:
      "Catalog, coș sau formular de comandă și integrări de plată ori livrare alese după fluxul real al afacerii.",
  },
  {
    href: "/serviciiBlog/mentenanta/",
    title: "Mentenanță",
    description:
      "Verificări, actualizări și intervenții tehnice cu un scop stabilit clar după evaluarea site-ului.",
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Acasă",
          item: "https://chisinauweb.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Servicii",
          item: "https://chisinauweb.com/serviciiBlog/",
        },
      ],
    },
    {
      "@type": "CollectionPage",
      name: "Servicii web în Moldova",
      description:
        "Servicii de design web, dezvoltare web, SEO on-page, magazine online și mentenanță oferite direct de un dezvoltator web independent din Chișinău.",
      url: "https://chisinauweb.com/serviciiBlog/",
      inLanguage: "ro-MD",
    },
    {
      "@type": "ItemList",
      itemListElement: services.map((service, index) => ({
        "@type": "ListItem",
        position: index + 1,
        url: `https://chisinauweb.com${service.href}`,
        name: service.title,
      })),
    },
  ],
};
---

<!doctype html>
<html lang="ro">
  <head>
    <BaseHead
      title="Servicii web în Moldova | Design, dezvoltare, SEO"
      description="Servicii web pentru afaceri din Moldova: creare site, design web, dezvoltare, SEO on-page, magazin online și mentenanță."
      canonicalUrl="https://chisinauweb.com/serviciiBlog/"
      hreflangRo="https://chisinauweb.com/serviciiBlog/"
      hreflangRu="https://chisinauweb.com/ru/serviciiBlog/"
      jsonLd={jsonLd}
    />
  </head>
  <body>
    <div class="dev-grid-pattern"></div>
    <Header lang="ro" />

    <section class="dev-hero">
      <div class="container">
        <div class="dev-hero-content">
          <span class="dev-section-tag">Servicii</span>
          <h1>Servicii web pentru afaceri din Moldova</h1>
          <p>
            Sunt Narcis, dezvoltator web independent în Chișinău. Lucrezi
            direct cu mine pentru design web, dezvoltare, magazine online, SEO
            on-page sau mentenanța unui site existent.
          </p>
          <p>
            Încep de la ce trebuie să facă site-ul pentru afacerea ta: să
            explice un serviciu, să primească cereri, să vândă produse sau să
            susțină un flux de lucru. Apoi aleg o structură și o implementare
            potrivite, fără funcții adăugate doar ca să mărească proiectul.
          </p>
          <p>
            Pot lucra cu afaceri din Chișinău și din restul Moldovei. Pentru o
            estimare utilă am nevoie de obiectiv, conținutul disponibil,
            funcțiile importante și accesul la serviciile care trebuie
            conectate.
          </p>
          <div class="dev-hero-actions">
            <a href="/preturi/" class="dev-btn dev-btn-primary">Vezi prețuri</a>
            <a href="/contact/" class="dev-btn dev-btn-secondary">Solicită ofertă</a>
          </div>
        </div>
      </div>
    </section>

    <section class="dev-section dev-section-alt">
      <div class="container">
        <div class="dev-section-header">
          <span class="dev-section-tag">Hub</span>
          <h2>Alege serviciul potrivit</h2>
          <p>Vezi ce include fiecare serviciu, ce trebuie să pregătești și care sunt limitele practice.</p>
        </div>
        <div class="dev-info-grid">
          {
            services.map((service) => (
              <article class="dev-info-card">
                <span class="dev-card-title">{service.title}</span>
                <p>{service.description}</p>
                <a href={service.href} class="dev-link-accent">{service.title}</a>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="dev-section">
      <div class="container">
        <div class="dev-section-header">
          <span class="dev-section-tag">Cum alegi</span>
          <h2>De unde poți începe</h2>
          <p>Dacă nu știi denumirea tehnică a serviciului, pornește de la problema pe care vrei să o rezolvi.</p>
        </div>
        <div class="dev-info-grid">
          <div class="dev-info-card">
            <span class="dev-card-title">Ai nevoie de identitate vizuală</span>
            <p>
              Începe cu <a href="/serviciiBlog/design-web/">design web profesional</a>
              dacă informația este greu de urmărit sau interfața nu funcționează
              bine pe telefon.
            </p>
          </div>
          <div class="dev-info-card">
            <span class="dev-card-title">Ai nevoie de implementare</span>
            <p>
              Intră pe <a href="/serviciiBlog/dezvoltare-web/">dezvoltare web în Moldova</a>
              pentru partea tehnică, formulare, baze de date, autentificare sau
              alte funcții definite în proiect.
            </p>
          </div>
          <div class="dev-info-card">
            <span class="dev-card-title">Site-ul este greu de găsit în Google</span>
            <p>
              Mergi direct la <a href="/serviciiBlog/seo-on-page/">SEO on-page pentru Google</a>
              pentru audit, structură, meta-taguri și probleme tehnice de
              indexare. Pozițiile nu pot fi garantate.
            </p>
          </div>
          <div class="dev-info-card">
            <span class="dev-card-title">Vrei să vinzi online</span>
            <p>
              Pentru produse și comenzi, pagina corectă este
              <a href="/serviciiBlog/magazin-online/">creare magazin online</a>.
              Plățile și livrarea se integrează numai după verificarea
              furnizorilor și a conturilor tale.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="dev-section dev-section-alt">
      <div class="container">
        <div class="dev-section-header">
          <span class="dev-section-tag">Servicii conexe</span>
          <h2>Informații pentru tipuri concrete de proiect</h2>
          <p>
            Găsești separat detalii despre site la comandă, site de prezentare,
            creare site în Chișinău, web design în Moldova și SEO în Moldova.
          </p>
        </div>
        <div class="dev-info-grid">
          {
            roLandingCards.map((page) => (
              <article class="dev-info-card">
                <span class="dev-card-title">{page.title}</span>
                <p>{page.description}</p>
                <a href={page.href} class="dev-link-accent">Vezi {page.title}</a>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="dev-cta">
      <div class="container">
        <div class="dev-cta-content">
          <h2>Nu e nevoie să pregătești un document tehnic</h2>
          <p>
            Spune-mi ce face afacerea, ce trebuie să poată face site-ul și ce ai
            deja pregătit. Îți răspund direct cu o variantă realistă, limitele
            ei și primul pas util.
          </p>
          <a href="/contact/" class="dev-btn dev-btn-primary dev-btn-lg">
            Descrie proiectul
          </a>
        </div>
      </div>
    </section>

    <Footer lang="ro" />
    <script src="/script.js" defer></script>
  </body>
</html>
