---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import "../../styles/dev-ru-blog-services.css";

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      name: "SEO Moldova | Audit on-page și optimizare Google",
      description:
        "Audit SEO on-page, meta-taguri, structură, indexare și verificări tehnice pentru site-uri din Moldova și Chișinău.",
      url: "https://chisinauweb.com/serviciiBlog/seo-on-page/",
      inLanguage: "ro-MD",
      breadcrumb: {
        "@type": "BreadcrumbList",
        itemListElement: [
          {
            "@type": "ListItem",
            position: 1,
            name: "Acasă",
            item: "https://chisinauweb.com/",
          },
          {
            "@type": "ListItem",
            position: 2,
            name: "Servicii",
            item: "https://chisinauweb.com/serviciiBlog/",
          },
          {
            "@type": "ListItem",
            position: 3,
            name: "SEO On-Page",
            item: "https://chisinauweb.com/serviciiBlog/seo-on-page/",
          },
        ],
      },
    },
    {
      "@type": "Service",
      serviceType: "SEO on-page",
      name: "Servicii SEO on-page în Moldova",
      description:
        "Audit și implementare SEO on-page pentru structură, meta-date, indexare, legături interne și performanță.",
      provider: {
        "@type": "Person",
        name: "Narcis",
        url: "https://chisinauweb.com/about/",
        jobTitle: "Dezvoltator web independent",
        worksFor: {
          "@type": "Organization",
          name: "ChisinauWeb.com",
          url: "https://chisinauweb.com/",
        },
      },
      areaServed: { "@type": "Country", name: "Moldova" },
      availableLanguage: ["ro", "ru"],
      url: "https://chisinauweb.com/serviciiBlog/seo-on-page/",
      offers: {
        "@type": "Offer",
        url: "https://chisinauweb.com/contact/",
        priceCurrency: "EUR",
        availability: "https://schema.org/InStock",
      },
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "În cât timp apar rezultatele SEO on-page?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Nu există un termen garantat. Google decide recrawl-ul, indexarea și clasarea, iar rezultatul depinde și de concurență, conținut, autoritatea domeniului și schimbările ulterioare.",
          },
        },
        {
          "@type": "Question",
          name: "Includeți audit tehnic și implementare?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Pot livra auditul, prioritizarea și implementarea modificărilor convenite dacă primesc accesul necesar și tehnologia site-ului poate fi modificată în siguranță.",
          },
        },
        {
          "@type": "Question",
          name: "Lucrați și pe site-uri deja lansate?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Da. Încep cu o verificare a structurii, indexării, paginilor și accesului, apoi separ corecțiile on-page de problemele care țin de conținut, autoritate sau platformă.",
          },
        },
      ],
    },
  ],
};
---

<!doctype html>
<html lang="ro">
  <head>
    <BaseHead
      title="SEO Moldova | Audit on-page și optimizare Google"
      description="Servicii SEO în Moldova și Chișinău: audit tehnic, meta-taguri, structură, indexare și optimizare on-page. Pachete de la 50 EUR."
      canonicalUrl="https://chisinauweb.com/serviciiBlog/seo-on-page/"
      hreflangRo="https://chisinauweb.com/serviciiBlog/seo-on-page/"
      hreflangRu="https://chisinauweb.com/ru/serviciiBlog/seo-on-page/"
      ogType="article"
      jsonLd={jsonLd}
    />
  </head>
  <body class="dev-ru-theme">
    <Header lang="ro" />

    <!-- Hero Section -->
    <section class="hero">
      <div class="container grid">
        <div class="hero-content">
          <h1>
            Servicii SEO în Moldova: audit și optimizare on-page
          </h1>
          <p class="subheading">
            Sunt Narcis, dezvoltator web independent în Chișinău. Verific și
            corectez elementele pe care site-ul le poate controla: structură,
            meta-date, indexare, conținut, legături interne și performanță.
          </p>
          <div class="hero-actions">
            <a href="/contact/" class="btn btn-primary">Cere audit</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Main Content -->
    <section class="content-section">
      <div class="container">
        <div class="section-title">
          <h2>De ce contează SEO on-page pentru afacerea ta</h2>
          <p>
            SEO on-page face paginile mai ușor de înțeles pentru oameni și
            motoare de căutare. Nu poate garanta o anumită poziție în Google.
          </p>
        </div>

        <div class="content-grid">
          <div class="content-block">
            <p class="service-card-title">Vizibilitate în căutările locale din Moldova</p>
            <p>
              Clienții compară afaceri și servicii în Google înainte să ceară o
              ofertă. De aceea contează ca pagina să fie clară, rapidă și ușor
              de înțeles:
            </p>
            <ul>
              <li>titlu și descriere care spun exact ce oferă pagina;</li>
              <li>headings care explică serviciul și zona deservită;</li>
              <li>conținut util pentru întrebările clienților;</li>
              <li>legături interne către paginile importante.</li>
            </ul>
            <p>
              Pentru SEO în Moldova și SEO în Chișinău păstrez formulările
              locale acolo unde sunt adevărate și utile. Nu repet localitatea
              sau expresiile-cheie doar pentru densitate.
            </p>
          </div>
          <div class="content-image">
            <img
              src="/assets/seo-on-page-1.webp"
              alt="Structură SEO on-page pentru un site din Moldova"
              width="500"
              height="300"
              loading="lazy"
            />
          </div>
        </div>

        <div class="content-grid reverse">
          <div class="content-block">
            <p class="service-card-title">Ce poate și ce nu poate face SEO on-page</p>
            <p>
              Modificările on-page pot elimina obstacole și pot clarifica
              paginile. Clasarea depinde însă și de factori din afara site-ului:
            </p>
            <ul>
              <li>nivelul concurenței și calitatea paginilor concurente;</li>
              <li>vechimea și autoritatea domeniului;</li>
              <li>mențiunile și legăturile externe reale;</li>
              <li>cererea existentă pentru serviciu;</li>
              <li>modul în care Google recitește și evaluează site-ul.</li>
            </ul>
            <p>
              De aceea nu promit trafic, clienți sau venituri. Pot arăta ce am
              verificat, ce am schimbat și ce limitări rămân după implementare.
            </p>
          </div>
          <div class="content-image">
            <img
              src="/assets/seo-on-page-2.webp"
              alt="Audit SEO pentru paginile unei afaceri din Moldova"
              width="500"
              height="300"
              loading="lazy"
            />
          </div>
        </div>

        <div class="content-grid">
          <div class="content-block">
            <p class="service-card-title">Baza tehnică și experiența pe mobil</p>
            <p>
              SEO on-page nu înseamnă doar optimizare pentru motoarele de
              căutare:
            </p>
            <ul>
              <li>pagini care pot fi accesate și indexate corect;</li>
              <li>structură logică și navigare ușor de urmărit;</li>
              <li>conținut organizat, fără secțiuni scrise doar pentru algoritm;</li>
              <li>afișare și interacțiuni verificate pe mobil;</li>
              <li>canonical, sitemap și hreflang unde proiectul le folosește.</li>
            </ul>
            <p>
              Datele structurate se adaugă numai când descriu conținut vizibil
              și factual. Nu adaug ratinguri, recenzii sau informații comerciale
              inventate.
            </p>
          </div>
          <div class="content-image">
            <img
              src="/assets/seo-on-page-3.webp"
              alt="Verificare SEO și afișare mobilă pentru un site"
              width="500"
              height="300"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Process Section -->
    <section class="process">
      <div class="container">
        <div class="section-title">
          <h2>Cum verific și optimizez site-ul</h2>
          <p>
            Separ problemele tehnice de conținut și implementez numai
            modificările pe care le pot verifica.
          </p>
        </div>

        <div class="process-steps">
          <div class="step">
            <div class="step-number">1</div>
            <p class="step-title">Audit SEO on-page</p>
            <p class="step-desc">
              Verific paginile, indexarea, meta-datele, canonicalele, sitemapul,
              legăturile și problemele tehnice vizibile.
            </p>
          </div>
          <div class="step">
            <div class="step-number">2</div>
            <p class="step-title">Limbajul clienților</p>
            <p class="step-desc">
              Compar serviciile reale cu formulările folosite de clienți și
              păstrez expresiile relevante fără umplerea artificială a textului.
            </p>
          </div>
          <div class="step">
            <div class="step-number">3</div>
            <p class="step-title">Implementare optimizări</p>
            <p class="step-desc">
              Corectez elementele convenite dacă primesc accesul necesar și pot
              face schimbarea fără să stric alte părți ale site-ului.
            </p>
          </div>
          <div class="step">
            <div class="step-number">4</div>
            <p class="step-title">Verificare și predare</p>
            <p class="step-desc">
              Verific paginile după modificare și explic ce s-a făcut, ce trebuie
              urmărit și ce depinde de Google sau de alte lucrări.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Services Section -->
    <section class="services">
      <div class="container">
        <div class="section-title">
          <h2>Ce poate include serviciul de SEO on-page</h2>
          <p>Scopul se stabilește după audit, acces și numărul de tipuri de pagini.</p>
        </div>

        <div class="service-grid">
          <div class="service-card">
            <div class="service-icon">🔍</div>
            <p class="service-title">Optimizare meta taguri</p>
            <p class="service-desc">
              Titluri, descrieri și headings care reflectă conținutul vizibil al
              paginii.
            </p>
          </div>
          <div class="service-card">
            <div class="service-icon">📱</div>
            <p class="service-title">Optimizare mobile</p>
            <p class="service-desc">
              Verificarea lizibilității, navigării și interacțiunilor pe ecrane
              mici.
            </p>
          </div>
          <div class="service-card">
            <div class="service-icon">⚡</div>
            <p class="service-title">Optimizare viteză</p>
            <p class="service-desc">
              Diagnostic pentru resurse, imagini și randare; lucrările mari se
              estimează separat.
            </p>
          </div>
          <div class="service-card">
            <div class="service-icon">📋</div>
            <p class="service-title">Structură și arhitectură</p>
            <p class="service-desc">
              Organizarea conținutului, URL-uri clare și legături interne între
              pagini utile.
            </p>
          </div>
          <div class="service-card">
            <div class="service-icon">📄</div>
            <p class="service-title">Optimizare conținut</p>
            <p class="service-desc">
              Rescrierea pasajelor neclare și recomandări pentru informațiile
              care lipsesc clientului.
            </p>
          </div>
          <div class="service-card">
            <div class="service-icon">📊</div>
            <p class="service-title">Schema markup</p>
            <p class="service-desc">
              JSON-LD factual pentru tipurile acceptate; afișarea unui rezultat
              special în Google nu este garantată.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Packages Section -->
    <section class="pricing">
      <div class="container">
        <div class="section-title">
          <h2>Pachete SEO on-page pentru afaceri din Moldova</h2>
          <p>
            Prețurile sunt puncte de pornire. Numărul de pagini și
            implementările incluse se confirmă după verificarea site-ului.
          </p>
        </div>

        <div class="pricing-grid">
          <div class="price-card card1">
            <p class="service-card-title">Pachet Basic</p>
            <div class="price">de la 50 EUR</div>
            <ul>
              <li>verificare concentrată pe paginile principale;</li>
              <li>probleme on-page prioritizate;</li>
              <li>meta-date și structură verificate;</li>
              <li>corecții punctuale convenite;</li>
              <li>explicație scurtă la predare.</li>
            </ul>
            <a href="/contact/" class="btn btn-primary">Solicită ofertă</a>
          </div>

          <div class="price-card card2 featured">
            <p class="service-card-title">Pachet Business</p>
            <div class="price">de la 150 EUR</div>
            <ul>
              <li>audit pentru mai multe tipuri de pagini;</li>
              <li>meta-date, headings și legături interne;</li>
              <li>verificări de indexare și canonical;</li>
              <li>ajustări de conținut incluse în scop;</li>
              <li>date structurate unde sunt potrivite;</li>
              <li>implementare în limita accesului disponibil.</li>
            </ul>
            <a href="/contact/" class="btn btn-primary">Solicită ofertă</a>
          </div>

          <div class="price-card card3">
            <p class="service-card-title">Pachet Premium</p>
            <div class="price">de la 300 EUR</div>
            <ul>
              <li>audit mai larg pentru site-uri cu structură complexă;</li>
              <li>compararea paginilor importante cu rezultatele relevante;</li>
              <li>prioritizarea problemelor tehnice și de conținut;</li>
              <li>implementări convenite pe mai multe șabloane;</li>
              <li>verificare locală pentru Chișinău și Moldova;</li>
              <li>predare cu limite și pași următori explicați.</li>
            </ul>
            <a href="/contact/" class="btn btn-primary">Solicită ofertă</a>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="faq">
      <div class="container">
        <div class="section-title">
          <h2>Întrebări frecvente despre SEO on-page</h2>
          <p>
            Limite, acces necesar și diferența dintre optimizarea paginii și
            factorii externi.
          </p>
        </div>

        <div class="faq-list">
          <details>
            <summary
              >Cât durează până vedem rezultate după optimizarea SEO?</summary
            >
            <p>
              Nu există un termen garantat. Unele corecții tehnice se văd
              imediat pe site, dar Google decide când recitește, indexează și
              reclasează pagina. Concurența, conținutul, autoritatea domeniului
              și schimbările ulterioare influențează rezultatul.
            </p>
          </details>
          <details>
            <summary>Ce diferențiază SEO on-page de SEO off-page?</summary>
            <p>
              SEO on-page se referă la toate optimizările care se fac direct pe
              site: structură, meta-date, conținut, legături interne, indexare și
              performanță. SEO off-page ține de mențiuni, reputație și legături
              externe reale. Acest serviciu nu include cumpărarea de linkuri și
              nu poate controla autoritatea altor site-uri.
            </p>
          </details>
          <details>
            <summary
              >Cum adaptați strategia SEO pentru piața din Moldova?</summary
            >
            <p>
              Folosesc limba și localitatea numai unde reflectă serviciul real.
              Verific paginile în română și rusă dacă ambele există, datele
              locale, legăturile dintre versiuni și informațiile de contact.
              Google Business Profile se poate verifica doar cu accesul
              proprietarului și nu este inclus automat într-un audit al site-ului.
            </p>
          </details>
          <details>
            <summary>SEO on-page este o investiție unică sau continuă?</summary>
            <p>
              Poate fi un proiect punctual pentru corectarea bazei tehnice și a
              paginilor importante. O nouă verificare are sens când apar pagini,
              produse, schimbări de platformă sau probleme în Search Console.
              Monitorizarea periodică se stabilește separat; pachetul acoperă
              doar perioada și operațiunile scrise în ofertă.
            </p>
          </details>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="cta-section">
      <div class="container grid">
        <div class="cta-container">
          <h2>Vrei să știi ce poate fi corectat pe site?</h2>
          <p class="subheading">
            Trimite-mi adresa site-ului și paginile importante. Îți spun ce pot
            verifica, ce acces este necesar și ce nu poate fi promis prin SEO
            on-page.
          </p>
          <a href="/contact/" class="btn btn-primary">Cere audit</a>
        </div>
      </div>
    </section>

    <Footer lang="ro" />

    <script src="/script.js" defer></script>
  </body>
</html>







