---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import "../../styles/dev-pages.css";

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "AboutPage",
      name: "Нарцис — независимый веб-разработчик в Кишинёве",
      description:
        "О Нарцисе, независимом веб-разработчике из Кишинёва: практический опыт, технологии, ответственное использование AI и прямой процесс работы.",
      url: "https://chisinauweb.com/ru/about/",
      inLanguage: "ru-MD",
      about: { "@id": "https://chisinauweb.com/about/#narcis" },
      mainEntity: { "@id": "https://chisinauweb.com/about/#narcis" },
    },
    {
      "@type": "Person",
      "@id": "https://chisinauweb.com/about/#narcis",
      name: "Narcis",
      jobTitle: "Независимый веб-разработчик",
      url: "https://chisinauweb.com/ru/about/",
      worksFor: { "@id": "https://chisinauweb.com/#business" },
      knowsAbout: [
        "JavaScript",
        "TypeScript",
        "React",
        "Astro",
        "Cloudflare Workers",
        "Веб-приложения",
      ],
    },
    {
      "@type": "ProfessionalService",
      "@id": "https://chisinauweb.com/#business",
      name: "ChisinauWeb.com",
      founder: { "@id": "https://chisinauweb.com/about/#narcis" },
      areaServed: { "@type": "Country", name: "Молдова" },
      url: "https://chisinauweb.com/ru/",
    },
  ],
};

const collaborationCards = [
  {
    number: "01",
    title: "Прямая коммуникация",
    description:
      "Вы общаетесь напрямую с человеком, который работает над проектом: без аккаунт-менеджера и без потери информации между несколькими людьми.",
  },
  {
    number: "02",
    title: "Практические решения",
    description:
      "Я начинаю с того, что сайт должен делать для бизнеса, а не со списка ненужных эффектов или технологий.",
  },
  {
    number: "03",
    title: "Ответственное использование AI",
    description:
      "Я использую современные инструменты, чтобы работать эффективнее, но не передаю AI проверку и ответственность за результат.",
  },
  {
    number: "04",
    title: "Реальные проекты",
    description:
      "В портфолио показаны существующие продукты и сайты, а не купленные макеты или придуманные результаты.",
  },
];

const collaborationSteps = [
  {
    number: "01",
    title: "Задача",
    description:
      "Вы объясняете мне, чем занимается ваш бизнес и чего должен достичь сайт.",
  },
  {
    number: "02",
    title: "Разбор",
    description:
      "Я анализирую требования и прямо говорю, что стоит создавать, что можно упростить и где есть ограничения.",
  },
  {
    number: "03",
    title: "Создание проекта",
    description:
      "Я создаю проект, проверяю функции и показываю вам прогресс по ходу работы.",
  },
  {
    number: "04",
    title: "Проверка и публикация",
    description:
      "После проверки мы публикуем сайт, а вы получаете доступ ко всему, что относится к вашему проекту.",
  },
];
---

<!doctype html>
<html lang="ru">
  <head>
    <BaseHead
      title="Нарцис — веб-разработчик в Кишинёве | ChisinauWeb"
      description="Я Нарцис, независимый веб-разработчик в Кишинёве. Создаю сайты и веб-приложения, открыто использую AI-инструменты и отвечаю за итоговый результат."
      canonicalUrl="https://chisinauweb.com/ru/about/"
      lang="ru"
      hreflangRo="https://chisinauweb.com/about/"
      hreflangRu="https://chisinauweb.com/ru/about/"
      image="/assets/og-image.webp"
      jsonLd={jsonLd}
    />
    
  </head>
  <body>
    <div class="dev-grid-pattern"></div>
    <Header lang="ru" />

    <!-- Hero Section -->
    <section class="dev-hero" id="acasa">
      <div class="container">
        <div class="dev-hero-grid">
          <div class="dev-hero-content">
            <span class="dev-section-tag">О ChisinauWeb</span>
            <h1>Я Нарцис, независимый веб-разработчик в Кишинёве.</h1>
            <p>
              Создаю сайты и веб-приложения для бизнеса и проектов, которым
              нужен понятный, быстрый и удобный в использовании продукт. Я не
              представляю большое агентство и не делаю вид, что за этим сайтом
              стоит команда из десятков людей. Когда вы мне пишете, вы говорите напрямую с
              человеком, который анализирует, создаёт, проверяет и публикует
              проект.
            </p>
            <div class="dev-hero-actions">
              <a href="/ru/contact/" class="dev-btn dev-btn-primary"
                >Описать проект</a
              >
              <a href="/ru/#portofoliu" class="dev-btn dev-btn-secondary"
                >Посмотреть проекты</a
              >
            </div>
          </div>

          <div class="dev-hero-visual">
            <div class="dev-code-window">
              <div class="dev-code-header">
                <span class="dev-code-dot red"></span>
                <span class="dev-code-dot yellow"></span>
                <span class="dev-code-dot green"></span>
              </div>
              <div class="dev-code-body">
                <div class="dev-code-line">
                  <span class="dev-code-num">1</span>
                  <span
                    ><span class="dev-code-keyword">const</span>
                    <span class="dev-code-func">developer</span> = {
                      `{`
                    }</span
                  >
                </div>
                <div class="dev-code-line">
                  <span class="dev-code-num">2</span>
                  <span>
                    <span class="dev-code-keyword">name</span>: <span
                      class="dev-code-string">"Narcis"</span
                    >,</span
                  >
                </div>
                <div class="dev-code-line">
                  <span class="dev-code-num">3</span>
                  <span>
                    <span class="dev-code-keyword">learningSince</span>: <span
                      class="dev-code-string">2019</span
                    >,</span
                  >
                </div>
                <div class="dev-code-line">
                  <span class="dev-code-num">4</span>
                  <span>
                    <span class="dev-code-keyword">stack</span>: [<span
                      class="dev-code-string">"JS"</span
                    >, <span class="dev-code-string">"React"</span>, <span
                      class="dev-code-string">"Astro"</span>],</span
                  >
                </div>
                <div class="dev-code-line">
                  <span class="dev-code-num">5</span>
                  <span>
                    <span class="dev-code-keyword">workflow</span>: <span
                      class="dev-code-string">"AI + проверка"</span
                    ></span
                  >
                </div>
                <div class="dev-code-line">
                  <span class="dev-code-num">6</span>
                  <span>{`}`};</span>
                </div>
                <div class="dev-code-line">
                  <span class="dev-code-num">7</span>
                  <span></span>
                </div>
                <div class="dev-code-line">
                  <span class="dev-code-num">8</span>
                  <span
                    ><span class="dev-code-comment"
                      >// ответственность остаётся у меня</span
                    ></span
                  >
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="dev-section dev-section-alt" id="despre">
      <div class="container">
        <div class="dev-section-header">
          <span class="dev-section-tag">Опыт</span>
          <h2>Как я пришёл к веб-разработке</h2>
        </div>
        <div class="dev-content-text">
          <p>
            Я начал серьёзно изучать веб-разработку в 2019 году: проходил
            структурированные учебные программы, практические курсы и много
            работал самостоятельно. Сначала я изучил JavaScript, React и
            full-stack разработку — ещё до того, как современные AI-инструменты
            стали центральной частью моего рабочего процесса. Затем я продолжил
            учиться главным образом на реальных проектах и задачах, которые
            появляются, когда продукт должен работать за пределами учебного
            примера.
          </p>
          <p>
            Сейчас я работаю с JavaScript, TypeScript, React, Astro, Cloudflare
            Workers, базами данных, формами, аутентификацией, платёжными
            интеграциями, хостингом и процессами публикации. Я не использую весь
            этот набор в каждом проекте — выбираю только то, что действительно
            подходит конкретной задаче.
          </p>
        </div>
      </div>
    </section>

    <section class="dev-section" id="ai">
      <div class="container">
        <div class="dev-section-header">
          <span class="dev-section-tag">Инструменты</span>
          <h2>Я использую AI и говорю об этом открыто</h2>
        </div>
        <div class="dev-content-text">
          <p>
            Я ежедневно использую AI-инструменты в разработке. Не утверждаю, что
            пишу каждую строку без помощи, и не считаю это единственной мерой
            качества продукта. AI помогает быстрее анализировать задачи,
            исследовать решения, сокращать повторяющуюся работу и проверять
            больше вариантов.
          </p>
          <p>
            Но AI-инструмент сам по себе не понимает бизнес клиента и не отвечает
            за результат. Моя роль — понять, что нужно создать, превратить
            требования в понятный план, направлять реализацию, проверять
            изменения, тестировать функции и исправлять то, что не работает. AI
            даёт мне больше рабочих возможностей; ответственность за продукт
            остаётся у меня.
          </p>
          <p>
            Я не использую AI, чтобы вслепую отдать первый сгенерированный
            результат. Это набор сильных инструментов, которыми нужно управлять,
            а их работу — проверять и корректировать.
          </p>
        </div>
      </div>
    </section>

    <section class="dev-section dev-section-alt" id="cum-lucrez">
      <div class="container">
        <div class="dev-section-header">
          <span class="dev-section-tag">Подход</span>
          <h2>Как я работаю</h2>
        </div>
        <div class="dev-content-text">
          <p>
            Моя сильная практическая сторона — взять ещё не до конца ясную идею,
            в которой много движущихся частей, и довести её до продукта,
            пригодного для реального использования. Мне нравится находить
            практический путь между «хорошо бы иметь это» и версией, которая
            работает на телефоне, компьютере и после публикации.
          </p>
          <p>
            Я работаю напрямую и объясняю решения без лишнего технического
            жаргона. Если функция не оправдывает затраты, я так и говорю. Если у
            решения есть ограничение, объясняю его. Если проект нужно упростить,
            чтобы его можно было запустить, предлагаю реалистичный вариант.
          </p>
          <p>
            Мне близок быстрый и экспериментальный способ работы, но моя
            публичная ответственность — проверять результат и исправлять
            ошибки, а не обещать скорость любой ценой.
          </p>
          <p>
            Я не публикую цифры о клиентах, удовлетворённости или результатах,
            которые не могу подтвердить. Предпочитаю показывать реальные
            проекты, объяснять, что именно создано, и ясно отмечать, что уже
            закончено, а что ещё находится в разработке.
          </p>
        </div>
      </div>
    </section>

    <!-- Collaboration Section -->
    <section class="dev-section" id="proces">
      <div class="container">
        <div class="dev-section-header">
          <span class="dev-section-tag">Процесс</span>
          <h2>Как мы работаем вместе</h2>
          <p>Четыре понятных шага от задачи до опубликованного проекта.</p>
        </div>
        <div class="dev-process-grid">
          {
            collaborationSteps.map((step) => (
              <div class="dev-process-step">
                <div class="dev-process-num">{step.number}</div>
                <span class="dev-card-title">{step.title}</span>
                <p>{step.description}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="dev-section dev-section-alt" id="de-ce-noi">
      <div class="container">
        <div class="dev-section-header">
          <span class="dev-section-tag">Прямое сотрудничество</span>
          <h2>Что значит работать напрямую со мной</h2>
        </div>
        <div class="dev-values-grid">
          {
            collaborationCards.map((card) => (
              <div class="dev-value-card">
                <div class="dev-value-num">{card.number}</div>
                <span class="dev-card-title">{card.title}</span>
                <p>{card.description}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="dev-cta" id="contact">
      <div class="container">
        <div class="dev-cta-content">
          <h2>Расскажите, что вы хотите создать</h2>
          <p>
            Вам не нужно готовить техническое задание. Объясните, чем занимается
            бизнес, в чём проблема и что должен уметь сайт. Я отвечу с
            реалистичным вариантом, объясню, что для него потребуется и с чего
            лучше начать.
          </p>
          <div class="dev-hero-actions">
            <a href="/ru/contact/" class="dev-btn dev-btn-primary dev-btn-lg">
              Описать проект
            </a>
            <a href="/ru/#portofoliu" class="dev-btn dev-btn-secondary dev-btn-lg">
              Посмотреть проекты
            </a>
          </div>
        </div>
      </div>
    </section>

    <Footer lang="ru" />
    <script src="/script.js" defer></script>
  </body>
</html>
