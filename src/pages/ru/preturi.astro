          item: "https://chisinauweb.com/ru/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Цены",
          item: "https://chisinauweb.com/ru/preturi/",
        },
      ],
    },
    {
      "@type": "Service",
      serviceType: "Создание сайта",
      name: "Создание сайтов в Молдове",
      description:
        "Пакеты для лендинга, сайта-визитки и мини-магазина с ценами от 50€.",
      provider: {
        "@type": "Person",
        "@id": "https://chisinauweb.com/about/#narcis",
        name: "Narcis",
        jobTitle: "Независимый веб-разработчик",
        url: "https://chisinauweb.com/ru/about/",
      },
      areaServed: { "@type": "Country", name: "Молдова" },
      url: "https://chisinauweb.com/ru/preturi/",
