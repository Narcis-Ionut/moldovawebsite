          itemOffered: {
            "@type": "Service",
            name: "Продвинутый сайт / мини-магазин",
            areaServed: { "@type": "Country", name: "Молдова" },
          },
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Сколько стоит создание сайта в Молдове?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Лендинг начинается от 50€, сайт-визитка от 150€, а мини-магазин от 300€. Финальная цена зависит от структуры, контента и функциональности.",
          },
        },
        {
          "@type": "Question",
          name: "Могу ли я оплатить в MDL или двумя частями?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Да. Счёт может быть выставлен в EUR или эквиваленте MDL. Для пакетов Standard/Pro также возможна оплата двумя частями: 50% аванс и 50% после согласованной сдачи.",
          },
        },
        {
          "@type": "Question",
          name: "Что включает SEO на странице?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Мета-теги, правильная структура страницы (H1–H3), оптимизация скорости, схема JSON-LD (где это актуально) и базовые настройки для индексации.",
          },
        },
        {
          "@type": "Question",
          name: "Включены ли домен и хостинг?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Нет. Я могу предложить подходящие варианты и помочь с настройкой DNS, SSL и электронной почты, если это входит в согласованный объём.",
          },
        },
        {
          "@type": "Question",
          name: "Смогу ли я самостоятельно изменять контент после запуска?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Если согласованный проект включает CMS или другой редактор, я передаю доступ и объясняю, как менять предусмотренный контент.",
          },
        },
      ],
    },
  ],
};

const packages = [
  {
    id: "pachet-basic",
    name: "Basic",
    price: "50€",
    description: "Лендинг на одну страницу с согласованной структурой",
    features: [
      "Адаптивный дизайн для мобильных/планшетов",
      "Контактная форма, карта Google",
      "SSL, базовая оптимизация скорости",
      "Базовое SEO на странице (Заголовок, Meta, H1–H3)",
      "1 правка включена",
      "Проверка формы и мобильной версии перед публикацией",
    ],
    note: "Домен и хостинг не включены. Я могу помочь с настройкой.",
    featured: false,
  },
  {
    id: "pachet-standard",
    name: "Standard",
    price: "150€",
    description: "Сайт-визитка (до 5 страниц) + основная настройка",
    features: [
      "Современный дизайн и понятная структура",
      "Способ обновления контента по согласованию",
      "Техническое SEO + JSON-LD там, где это уместно",
      "Настройка GA4 и Search Console",
      "2–3 правки включены",
      "Передача согласованных доступов к проекту",
    ],
    note: "Идеально для локального бизнеса, который хочет видимости в поиске.",
    featured: true,
  },
  {
    id: "pachet-pro",
    name: "Pro",
    price: "300€",
    description: "Продвинутый сайт (до 12 страниц) или мини-магазин",
    features: [
      "Структура и компоненты под согласованный проект",
      "Мини-магазин (до 10 товаров), корзина, доставка и оплата",
      "Техническое SEO, скорость и структурированные данные",
      "RO + RU (многоязычность) – опционально",
      "5 правок включены + 1 час обучения",
      "Проверка корзины и ключевых сценариев заказа",
    ],
    note: "Домен, хостинг и сторонние сервисы оплачиваются отдельно, если иное не указано в предложении.",
    featured: false,
  },
];

const factors = [
  {
    title: "Количество страниц",
    description:
      "Сайт-визитка с 3–5 страницами проще, чем сайт с 10–15 страницами, что влияет на время работы и бюджет.",
  },
  {
    title: "Дизайн и идентичность",
    description:
      "Адаптированный шаблон или индивидуальный дизайн? Чем выше уровень персонализации, тем выше цена.",
  },
  {
    title: "Специальные функции",
    description:
      "Расширенные формы, бронирования, интеграция оплаты или мини-магазин требуют дополнительной разработки.",
  },
  {
    title: "SEO и контент",
    description:
      "SEO-оптимизация, тексты и изображения могут влиять на стоимость и результаты в Google.",
  },
];

const addons = [
  {
    title: "Логотип и визуальная идентичность",
    description: "От 30€ – основной вариант + набор для веба.",
  },
  {
    title: "SEO-копирайтинг",
    description: "От 10€/страница – оптимизированные тексты для RO/RU.",
  },
  {
    title: "Многоязычность RO/RU",
    description: "От 30€ – переведенные страницы + переключатель.",
  },
  {
    title: "Обслуживание",
    description:
      "От 25€/месяц – обновления, безопасность, резервное копирование.",
  },
];

const faqs = [
  {
    question: "Сколько стоит создание сайта в Молдове?",
    answer:
      "Лендинг начинается от 50€, сайт-визитка от 150€, а мини-магазин от 300€. Финальная цена зависит от структуры, контента и функциональности.",
  },
  {
    question: "Могу ли я оплатить в MDL или двумя частями?",
    answer:
      "Да. Счёт может быть выставлен в EUR или эквиваленте MDL. Для пакетов Standard/Pro также возможна оплата двумя частями: 50% аванс и 50% после согласованной сдачи.",
  },
  {
    question: "Что включает SEO на странице?",
    answer:
      "Мета-теги, правильная структура страницы (H1–H3), оптимизация скорости, схема JSON-LD (где это актуально) и базовые настройки для индексации.",
  },
  {
    question: "Включены ли домен и хостинг?",
    answer:
      "Нет. Я могу предложить подходящие варианты и помочь с настройкой DNS, SSL и электронной почты, если это входит в согласованный объём.",
  },
  {
    question: "Смогу ли я самостоятельно изменять контент после запуска?",
    answer:
      "Если согласованный проект включает CMS или другой редактор, я передаю доступ и объясняю, как менять предусмотренный контент.",
  },
];

const whatToExpect = [
  {
    icon: "🧾",
    title: "Понятная смета",
    description:
      "До начала работы я фиксирую согласованный объём, стоимость и то, что оплачивается отдельно.",
  },
  {
    icon: "💬",
    title: "Прямая коммуникация",
    description:
      "Вы обсуждаете требования и изменения напрямую со мной, без посредников.",
  },
  {
    icon: "✓",
    title: "Проверка перед публикацией",
    description:
      "Я проверяю согласованные функции и ключевые сценарии до публикации проекта.",
  },
];

const collaborationSteps = [
  {
    number: "01",
    title: "Задача",
    description:
      "Вы объясняете мне, чем занимается ваш бизнес и чего должен достичь сайт.",
  },
  {
    number: "02",
    title: "Разбор",
    description:
      "Я анализирую требования и прямо говорю, что стоит создавать, что можно упростить и где есть ограничения.",
  },
  {
    number: "03",
    title: "Создание проекта",
    description:
      "Я создаю проект, проверяю функции и показываю вам прогресс по ходу работы.",
  },
  {
    number: "04",
    title: "Проверка и публикация",
    description:
      "После проверки мы публикуем сайт, а вы получаете доступ ко всему, что относится к вашему проекту.",
  },
];
---

<!doctype html>
<html lang="ru">
  <head>
    <BaseHead
      title="Сколько стоит сайт в Молдове? Цены от 50 EUR"
      description="Цены на сайт в Молдове: лендинг от 50 EUR, сайт-визитка от 150 EUR, мини-магазин от 300 EUR. Итоговая стоимость зависит от структуры, контента и функций."
      canonicalUrl="https://chisinauweb.com/ru/preturi/"
      lang="ru"
      ogLocale="ru_MD"
      hreflangRo="https://chisinauweb.com/preturi/"
      hreflangRu="https://chisinauweb.com/ru/preturi/"
      image="/assets/og-image-preturi.webp"
      jsonLd={jsonLd}
    />
    
  </head>
  <body>
    <div class="dev-grid-pattern"></div>
    <Header lang="ru" />

    <!-- Hero -->
    <section class="dev-hero">
      <div class="container">
        <div class="dev-hero-content">
          <span class="dev-section-tag">Цены</span>
          <h1>Сколько стоит сайт в Молдове? Цены и пакеты 2026</h1>
          <p>Сравните стоимость лендинга, сайта-визитки и мини-магазина: Basic 50€, Standard 150€, Pro 300€.</p>
          <p>Ориентиры для веб-дизайна в Кишиневе и по всей Молдове.</p>
          <div class="dev-hero-actions">
            <a href="/ru/contact/" class="dev-btn dev-btn-primary">
              Получить точную цену
            </a>
            <a href="/ru/serviciiBlog/magazin-online/" class="dev-btn dev-btn-secondary">
              Интернет-магазин от 300 EUR
            </a>
          </div>
        </div>
        <div class="dev-hero-intro">
          <p>
            Здесь собраны ориентиры на создание сайтов в Молдове. Я указываю
            цены в евро; оплату в леях можно рассчитать по актуальному курсу.
            Перед началом я уточняю структуру, контент и функции, потому что
            именно они определяют итоговую стоимость.
          </p>
          <p>
            В карточке каждого пакета перечислены основные включения. Если
            проекту нужны платёжные сервисы, дополнительный язык, нестандартная
            интеграция или больше контента, я указываю это отдельно до начала
            работы.
          </p>
        </div>
      </div>
    </section>

    <!-- Quick Estimate -->
    <section class="dev-section dev-section-alt" id="bystraya-ocenka">
      <div class="container">
        <div class="dev-section-header">
          <span class="dev-section-tag">Ориентир</span>
          <h2>Сравните основные ориентиры по цене</h2>
          <p>Финальное предложение появляется после короткого описания проекта.</p>
        </div>
        <div class="dev-pricing-grid">
          <article class="dev-price-card">
            <span class="dev-card-title">Лендинг</span>
            <div class="dev-price">~50€</div>
            <p>1 страница, согласованная структура и форма заявки.</p>
            <a href="/ru/contact/" class="dev-btn dev-btn-secondary dev-btn-block">
              Выбрать Basic
            </a>
          </article>
          <article class="dev-price-card featured">
            <span class="dev-card-title">Сайт-визитка</span>
            <div class="dev-price">~150€</div>
            <p>3-5 страниц, базовое SEO и готовая структура.</p>
            <a href="/ru/contact/" class="dev-btn dev-btn-primary dev-btn-block">
              Выбрать Standard
            </a>
          </article>
          <article class="dev-price-card">
            <span class="dev-card-title">Мини-магазин</span>
            <div class="dev-price">~300€</div>
            <p>Каталог, корзина, доставка и старт e-commerce.</p>
            <a href="/ru/contact/" class="dev-btn dev-btn-secondary dev-btn-block">
              Выбрать Pro
            </a>
          </article>
        </div>
        <p class="dev-inline-note">
          Это ориентир. Финальная стоимость рассчитывается после брифа.
        </p>
      </div>
    </section>

    <section class="dev-section" id="sait-ceny">
      <div class="container">
        <div class="dev-section-header">
          <span class="dev-section-tag">Цены на сайт</span>
          <h2>Разработка сайтов: цена для бизнеса в Молдове</h2>
          <p>
            Прямые ориентиры: лендинг от 50 EUR, сайт-визитка от 150 EUR,
            мини-магазин от 300 EUR. Цена создания сайта зависит от структуры,
            количества страниц, готовности контента и нужных интеграций.
          </p>
        </div>
        <div class="dev-info-grid">
          <article class="dev-info-card">
            <span class="dev-card-title">Сайт-визитка от 150 EUR</span>
            <p>3-5 страниц, понятная структура услуг, форма заявки, базовое SEO и подготовка к локальному поиску.</p>
            <a href="/ru/sait-vizitka/" class="dev-link-accent">сайт-визитка</a>
          </article>
          <article class="dev-info-card">
            <span class="dev-card-title">Интернет-магазин от 300 EUR</span>
            <p>Каталог, корзина, доставка, способы оплаты и стартовая e-commerce структура для Молдовы.</p>
            <a href="/ru/serviciiBlog/magazin-online/" class="dev-link-accent">интернет-магазин</a>
          </article>
          <article class="dev-info-card">
            <span class="dev-card-title">Создание сайтов в Кишиневе</span>
            <p>Работа напрямую с независимым разработчиком: от разбора задачи до проверки и передачи доступов.</p>
            <a href="/ru/sozdanie-saitov-kishinev/" class="dev-link-accent">создание сайтов</a>
          </article>
        </div>
      </div>
    </section>

    <!-- Breadcrumbs -->
    <nav class="dev-breadcrumbs" aria-label="breadcrumb">
      <div class="container">
        <ol>
          <li><a href="/ru/">Главная</a></li>
          <li aria-hidden="true">/</li>
          <li><span aria-current="page">Цены</span></li>
        </ol>
      </div>
    </nav>

    <!-- Pricing Section -->
    <section class="dev-section dev-section-alt" id="preturi">
      <div class="container">
        <div class="dev-section-header">
          <span class="dev-section-tag">Пакеты</span>
          <h2>Выберите подходящий вариант</h2>
          <p>Для малого бизнеса или личных проектов</p>
        </div>
        <div class="dev-pricing-grid">
          {
            packages.map((pkg) => (
              <article
                class={`dev-price-card ${pkg.featured ? "featured" : ""}`}
                id={pkg.id}
              >
                <span class="dev-card-title">{pkg.name}</span>
                <div class="dev-price">{pkg.price}</div>
                <p>{pkg.description}</p>
                <ul class="dev-price-features">
                  {pkg.features.map((f) => (
                    <li>{f}</li>
                  ))}
                </ul>
                <p class="dev-price-note">* {pkg.note}</p>
                <a href="/ru/contact/" class="dev-btn dev-btn-primary">
                  Запросить предложение
                </a>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- What To Expect Section -->
    <section class="dev-section">
      <div class="container">
        <div class="dev-section-header">
          <span class="dev-section-tag">Что ожидать</span>
          <h2>Понятные условия до начала работы</h2>
          <p>Вы общаетесь напрямую со мной и заранее видите согласованный объём.</p>
        </div>
        <div class="dev-why-grid">
          {
            whatToExpect.map((w) => (
              <div class="dev-why-card">
                <div class="dev-why-icon">{w.icon}</div>
                <span class="dev-card-title">{w.title}</span>
                <p>{w.description}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Factors Section -->
    <section class="dev-section dev-section-alt" id="preturi-explicate">
      <div class="container">
        <div class="dev-section-header">
          <span class="dev-section-tag">Информация</span>
          <h2>Что влияет на цену?</h2>
          <p>Основные факторы, влияющие на итоговую стоимость</p>
        </div>
        <div class="dev-info-grid">
          {
            factors.map((f) => (
              <div class="dev-info-card">
                <span class="dev-card-title">{f.title}</span>
                <p>{f.description}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="dev-section">
      <div class="container">
        <div class="dev-section-header">
          <span class="dev-section-tag">Виды проектов</span>
          <h2>Подробнее о разных форматах сайта</h2>
          <p>
            Посмотрите, что входит в сайт-визитку, создание сайта в Кишинёве,
            веб-дизайн и другие услуги для бизнеса в Молдове.
          </p>
        </div>
        <div class="dev-info-grid">
          {
            ruLandingCards.map((page) => (
              <article class="dev-info-card">
                <span class="dev-card-title">{page.title}</span>
                <p>Состав работы, подходящие задачи, практические ограничения и следующий шаг.</p>
                <a href={page.href} class="dev-link-accent">Подробнее: {page.title}</a>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Addons Section -->
    <section class="dev-section" id="adaugiri">
      <div class="container">
        <div class="dev-section-header">
          <span class="dev-section-tag">Дополнительно</span>
          <h2>Дополнительные опции</h2>
          <p>Расширяйте выбранный пакет при необходимости</p>
        </div>
        <div class="dev-info-grid">
          {
            addons.map((a) => (
              <div class="dev-info-card">
                <span class="dev-card-title">{a.title}</span>
                <p>{a.description}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Collaboration Section -->
    <section class="dev-section dev-section-alt">
      <div class="container">
        <div class="dev-section-header">
          <span class="dev-section-tag">Процесс</span>
          <h2>Как мы работаем вместе</h2>
          <p>Четыре понятных шага от задачи до опубликованного проекта.</p>
        </div>
        <div class="dev-process-grid">
          {
            collaborationSteps.map((step) => (
              <div class="dev-process-step">
                <div class="dev-process-num">{step.number}</div>
                <span class="dev-card-title">{step.title}</span>
                <p>{step.description}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="dev-section" id="faq">
      <div class="container">
        <div class="dev-section-header">
          <span class="dev-section-tag">FAQ</span>
          <h2>Часто задаваемые вопросы</h2>
          <p>Практические детали о ценовых пакетах</p>
        </div>
        <div class="dev-faq-list">
          {
            faqs.map((faq) => (
              <details class="dev-faq-item">
                <summary>{faq.question}</summary>
                <p>{faq.answer}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="dev-cta" id="contact">
      <div class="container">
        <div class="dev-cta-content">
          <h2>Нашли подходящий пакет?</h2>
          <p>
            Опишите задачу, и я уточню, какой объём реалистичен для выбранного бюджета.
          </p>
          <a
            href="/ru/contact/"
            class="dev-btn dev-btn-primary dev-btn-lg"
          >
            Описать проект
          </a>
        </div>
      </div>
    </section>

    <Footer lang="ru" />
    <script src="/script.js" defer></script>
  </body>
</html>
