        "@type": "AggregateOffer",
        lowPrice: "50",
        highPrice: "300",
        offerCount: "3",
        priceCurrency: "EUR",
        availability: "https://schema.org/InStock",
      },
    },
    {
      "@type": "OfferCatalog",
      name: "Пакеты создания сайтов - Молдова",
      url: "https://chisinauweb.com/ru/preturi/",
      itemListElement: [
        {
          "@type": "Offer",
          name: "Basic",
          url: "https://chisinauweb.com/ru/preturi/#pachet-basic",
          price: "50",
          priceCurrency: "EUR",
          availability: "https://schema.org/InStock",
          itemOffered: {
            "@type": "Service",
            name: "Лендинг (1 страница)",
            areaServed: { "@type": "Country", name: "Молдова" },
          },
        },
        {
          "@type": "Offer",
          name: "Standard",
          url: "https://chisinauweb.com/ru/preturi/#pachet-standard",
          price: "150",
          priceCurrency: "EUR",
          availability: "https://schema.org/InStock",
          itemOffered: {
            "@type": "Service",
            name: "Сайт-визитка (до 5 страниц)",
            areaServed: { "@type": "Country", name: "Молдова" },
