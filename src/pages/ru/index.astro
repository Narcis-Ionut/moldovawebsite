    <!-- CTA Section -->
    <section class="dev-cta" id="contact">
      <div class="container">
        <div class="dev-cta-content">
          <h2>Хотите сайт по доступной цене в Молдове?</h2>
          <p>
            Расскажите, чем занимается ваш бизнес и что должен делать сайт. Я
            отвечу с реалистичным вариантом и первым шагом.
          </p>
          <a
            href="/ru/contact/"
            class="dev-btn dev-btn-primary dev-btn-lg"
          >
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
