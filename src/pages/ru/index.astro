---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import "../../styles/dev-pages.css";
import { ruLandingCards } from "../../data/landingPages.ru";
import { portfolioRu } from "../../data/portfolio";

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      name: "ChisinauWeb.com",
      url: "https://chisinauweb.com/ru/",
      inLanguage: "ru-MD",
    },
    {
      "@type": "ProfessionalService",
      "@id": "https://chisinauweb.com/#business",
      name: "ChisinauWeb.com",
      description:
        "Создание сайтов и веб-приложений в Молдове напрямую с независимым разработчиком из Кишинёва.",
      areaServed: { "@type": "Country", name: "Молдова" },
      url: "https://chisinauweb.com/ru/",
      email: "contact@chisinauweb.com",
      telephone: "+37361211739",
      founder: { "@id": "https://chisinauweb.com/about/#narcis" },
      address: {
        "@type": "PostalAddress",
        addressLocality: "Кишинёв",
        addressCountry: "MD",
      },
    },
    {
      "@type": "Person",
      "@id": "https://chisinauweb.com/about/#narcis",
      name: "Narcis",
      jobTitle: "Независимый веб-разработчик",
      url: "https://chisinauweb.com/ru/about/",
      worksFor: { "@id": "https://chisinauweb.com/#business" },
      knowsAbout: [
        "JavaScript",
        "TypeScript",
        "React",
        "Astro",
        "Cloudflare Workers",
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Сколько стоит создание сайта в Молдове?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Лендинг начинается от 50€, сайт-визитка от 150€, а мини-магазин от 300€. Финальная цена зависит от структуры, контента и функциональности.",
          },
        },
        {
          "@type": "Question",
          name: "Вы работаете в Кишиневе и по всей Молдове?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Да. Я работаю из Кишинёва и могу вести проекты онлайн для клиентов по всей Молдове.",
          },
        },
        {
          "@type": "Question",
          name: "Вы включаете SEO на странице?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Да. Я настраиваю мета-теги, структуру страниц, технические условия для быстрой загрузки и JSON-LD там, где это уместно.",
          },
        },
        {
          "@type": "Question",
          name: "Вы создаете интернет-магазины?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Да. Я создаю интернет-магазины с каталогом, корзиной, оплатой и доставкой в объёме, согласованном для конкретного проекта.",
          },
        },
      ],
    },
  ],
};

const linkedServices = [
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9.53 16.122a3 3 0 00-5.78 1.128 2.25 2.25 0 01-2.4 2.245 4.5 4.5 0 008.4-2.245c0-.399-.078-.78-.22-1.128zm0 0a15.998 15.998 0 003.388-1.62m-5.048 4.025a3 3 0 01-4.293 0l-1.172-1.172a3 3 0 010-4.242l7.586-7.586a3 3 0 014.242 0l1.172 1.172a3 3 0 010 4.242l-7.586 7.586z"/><path d="M14.25 9.75L16.5 12m0 0l2.25 2.25M16.5 12l2.25-2.25M16.5 12l-2.25 2.25"/></svg>`,
    title: "Современный дизайн и UX",
    description:
      "Понятные интерфейсы, в которых важная информация и действия удобно находить на телефоне и компьютере.",
    cardClass: "dev-card-amber",
    href: "/ru/serviciiBlog/design-web/",
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z"/></svg>`,
    title: "Производительность и скорость",
    description:
      "Чистая структура, хорошая загрузка и надежная техническая реализация под коммерческий сайт.",
    cardClass: "dev-card-emerald",
    href: "/ru/serviciiBlog/dezvoltare-web/",
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"/></svg>`,
    title: "SEO-оптимизация для Молдовы",
    description:
      "Мета-теги, структура страниц и оптимизация под локальные коммерческие запросы в Google.",
    cardClass: "dev-card-violet",
    href: "/ru/serviciiBlog/seo-on-page/",
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 00-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 00-16.536-1.84M7.5 14.25L5.106 5.272M6 20.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm12.75 0a.75.75 0 11-1.5 0 .75.75 0 011.5 0z"/></svg>`,
    title: "Доступный интернет-магазин",
    description:
      "Каталог, корзина, оплаты и доставка для ecommerce-проектов на рынке Молдовы.",
    cardClass: "dev-card-pink",
    href: "/ru/serviciiBlog/magazin-online/",
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 11-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 004.486-6.336l-3.276 3.277a3.004 3.004 0 01-2.25-2.25l3.276-3.276a4.5 4.5 0 00-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085m-1.745 1.437L5.909 7.5H4.5L2.25 3.75l1.5-1.5L7.5 4.5v1.409l4.26 4.26m-1.745 1.437l1.745-1.437m6.615 8.206L15.75 15.75M4.867 19.125h.008v.008h-.008v-.008z"/></svg>`,
    title: "Поддержка и обслуживание",
    description:
      "Обновления, мониторинг и технические работы после запуска можно согласовать отдельно.",
    cardClass: "dev-card-cyan",
    href: "/ru/serviciiBlog/mentenanta/",
  },
];

const collaborationSteps = [
  {
    number: "01",
    title: "Задача",
    description:
      "Вы объясняете мне, чем занимается ваш бизнес и чего должен достичь сайт.",
  },
  {
    number: "02",
    title: "Разбор",
    description:
      "Я анализирую требования и прямо говорю, что стоит создавать, что можно упростить и где есть ограничения.",
  },
  {
    number: "03",
    title: "Создание проекта",
    description:
      "Я создаю проект, проверяю функции и показываю вам прогресс по ходу работы.",
  },
  {
    number: "04",
    title: "Проверка и публикация",
    description:
      "После проверки мы публикуем сайт, а вы получаете доступ ко всему, что относится к вашему проекту.",
  },
];

const faqs = [
  {
    question: "Сколько стоит создание сайта в Молдове?",
    answer:
      "Лендинг начинается от 50€, сайт-визитка от 150€, а мини-магазин от 300€. Финальная цена зависит от структуры, контента и функциональности.",
  },
  {
    question: "Вы работаете в Кишиневе и по всей Молдове?",
    answer:
      "Да. Я работаю из Кишинёва и могу вести проекты онлайн для клиентов по всей Молдове.",
  },
  {
    question: "Вы включаете SEO на странице?",
    answer:
      "Да. Я настраиваю мета-теги, структуру страниц, технические условия для быстрой загрузки и JSON-LD там, где это уместно.",
  },
  {
    question: "Вы создаете интернет-магазины?",
    answer:
      "Да. Я создаю интернет-магазины с каталогом, корзиной, оплатой и доставкой в объёме, согласованном для конкретного проекта.",
  },
];
---

<!doctype html>
<html lang="ru">
  <head>
    <BaseHead
      title="Создание сайтов в Молдове | Нарцис, веб-разработчик"
      description="Создание сайтов и веб-приложений в Молдове напрямую с независимым разработчиком из Кишинёва: сайт-визитка, интернет-магазин, SEO и веб-дизайн."
      canonicalUrl="https://chisinauweb.com/ru/"
      lang="ru"
      ogLocale="ru_MD"
      hreflangRo="https://chisinauweb.com/"
      hreflangRu="https://chisinauweb.com/ru/"
      jsonLd={jsonLd}
    />
    
  </head>
  <body class="dev-theme">
    <div class="dev-grid-pattern"></div>
    <Header lang="ru" />

    <!-- Hero Section -->
    <section class="dev-hero" id="acasa">
      <div class="container">
        <div class="dev-hero-grid">
          <div class="dev-hero-content">
            <div class="dev-hero-badge">Независимый веб-разработчик в Кишинёве</div>
            <h1>Создание сайтов в Молдове напрямую с разработчиком</h1>
            <p class="dev-hero-subtitle">
              Я — Нарцис. Создаю понятные сайты и веб-приложения для бизнеса в
              Кишинёве и по всей Молдове: <strong>сайт-визитка</strong>, <strong
                >интернет-магазин</strong
              >,
              <strong>сайт на заказ</strong> и более сложные веб-продукты.
              Вы общаетесь напрямую с человеком, который анализирует,
              разрабатывает и проверяет проект.
            </p>
            <p class="dev-hero-subtitle">
              Современная веб-разработка, включая инструменты AI, которые я
              использую открыто и проверяю перед публикацией.
            </p>
            <div class="dev-hero-actions">
              <a href="/ru/contact/" class="dev-btn dev-btn-primary">
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path
                    d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"
                  ></path>
                </svg>
                Описать проект
              </a>
              <a href="/ru/preturi/" class="dev-btn dev-btn-secondary">
                Цены на создание сайта
              </a>
              <a href="#portofoliu" class="dev-btn dev-btn-secondary">
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path
                    d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z"
                  ></path>
                  <path d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
                Посмотреть портфолио
              </a>
            </div>
            <div class="dev-hero-stats">
              <div class="dev-stat">
                <div class="dev-stat-value">Нарцис</div>
                <div class="dev-stat-label">Независимый разработчик</div>
              </div>
              <div class="dev-stat">
                <div class="dev-stat-value">Напрямую</div>
                <div class="dev-stat-label">Без посредников</div>
              </div>
              <div class="dev-stat">
                <div class="dev-stat-value">RO / RU</div>
                <div class="dev-stat-label">Контекст рынка Молдовы</div>
              </div>
            </div>
          </div>

          <div class="dev-terminal">
            <div class="dev-terminal-header">
              <span class="dev-terminal-dot red"></span>
              <span class="dev-terminal-dot yellow"></span>
              <span class="dev-terminal-dot green"></span>
              <span class="dev-terminal-title"
                >ChisinauWeb.com — bash — 80x24</span
              >
            </div>
            <div class="dev-terminal-body">
              <div class="dev-terminal-line">
                <span class="dev-terminal-prompt">➜</span>
                <span class="dev-terminal-command"
                  ><span class="syntax-function">init</span>
                  <span class="syntax-string">"новый-проект"</span></span
                >
              </div>
              <div class="dev-terminal-output">
                ✓ Анализ требований завершен<br />
                ✓ Сгенерирована дизайн-система<br />
                ✓ Настроено SEO
              </div>
              <div class="dev-terminal-line">
                <span class="dev-terminal-prompt">➜</span>
                <span class="dev-terminal-command"
                  ><span class="syntax-function">build</span>
                  <span class="syntax-keyword">--prod</span></span
                >
              </div>
              <div class="dev-terminal-output">
                <span class="syntax-comment"
                  ># Сборка успешно завершена</span
                ><br />
                ✓ Оптимизирована скорость загрузки<br />
                ✓ Проверена доступность<br />
                ✓ Настроена SEO-структура
              </div>
              <div class="dev-terminal-line">
                <span class="dev-terminal-prompt">➜</span>
                <span class="dev-terminal-command"
                  ><span class="syntax-function">deploy</span>
                  <span class="syntax-keyword">--live</span></span
                >
              </div>
              <div class="dev-terminal-output">
                ✓ Сайт опубликован на ChisinauWeb.com<br />
                ✓ Домен подключен<br />
                ✓ SSL активирован
              </div>
              <div class="dev-terminal-line">
                <span class="dev-terminal-prompt">➜</span>
                <span class="dev-terminal-cursor"></span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Services Section -->
    <section class="dev-section dev-section-alt" id="servicii">
      <div class="container">
        <div class="dev-section-header">
          <span class="dev-section-tag">Услуги</span>
          <h2>Комплексные решения для малого бизнеса</h2>
          <p>
            Проектирую и создаю сайты, приложения и необходимые технические
            интеграции
          </p>
        </div>
        <div class="dev-services-grid">
          {
            linkedServices.map((service) => (
              <article class={`dev-service-card ${service.cardClass}`}>
                <div class="dev-service-icon" set:html={service.icon} />
                <span class="dev-card-title">{service.title}</span>
                <p>{service.description}</p>
                <a href={service.href} class="dev-link-accent">{service.title}</a>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="dev-section" id="popular-searches">
      <div class="container">
        <div class="dev-section-header">
          <span class="dev-section-tag">Форматы проектов</span>
          <h2>Какой сайт вам нужен?</h2>
          <p>
            Выберите близкий формат, чтобы увидеть, что входит в работу, для
            каких задач он подходит и что нужно подготовить.
          </p>
        </div>
        <div class="dev-services-grid">
          {
            ruLandingCards.map((page, index) => (
              <article class={`dev-service-card ${linkedServices[index % linkedServices.length].cardClass}`}>
                <div class="dev-service-icon">{String(index + 1).padStart(2, "0")}</div>
                <span class="dev-card-title">{page.title}</span>
                <p>Практическая информация о составе проекта, процессе и ограничениях.</p>
                <a href={page.href} class="dev-link-accent">Подробнее: {page.title}</a>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Collaboration Section -->
    <section class="dev-section" id="sovmestnaya-rabota">
      <div class="container">
        <div class="dev-section-header">
          <span class="dev-section-tag">Процесс</span>
          <h2>Как мы работаем вместе</h2>
          <p>Четыре понятных шага от задачи до опубликованного проекта.</p>
        </div>
        <div class="dev-process-grid">
          {
            collaborationSteps.map((step) => (
              <div class="dev-process-step">
                <div class="dev-process-number">{step.number}</div>
                <span class="dev-card-title">{step.title}</span>
                <p>{step.description}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Portfolio Section -->
    <section class="dev-section dev-section-alt" id="portofoliu">
      <div class="container">
        <div class="dev-section-header">
          <span class="dev-section-tag">Портфолио</span>
          <h2>Реальные веб-проекты</h2>
          <p>
            Здесь только существующие сайты и продукты без выдуманных результатов
            и шаблонных проектов.
          </p>
        </div>
        <div class="dev-portfolio-grid">
          {
            portfolioRu.map((item) => (
              <article class="dev-portfolio-card">
                <div class="dev-portfolio-image">
                  <img
                    src={item.image}
                    alt={item.imageAlt}
                    loading="lazy"
                    width="400"
                    height="220"
                  />
                  <div class="dev-portfolio-overlay">
                    <span class="dev-portfolio-category">{item.category}</span>
                  </div>
                </div>
                <div class="dev-portfolio-content">
                  <span class="dev-card-title">{item.title}</span>
                  <p>{item.description}</p>
                  <ul class="dev-portfolio-features">
                    {item.features.map((feature) => (
                      <li>{feature}</li>
                    ))}
                  </ul>
                  <a
                    href={item.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="dev-portfolio-link"
                  >
                    Открыть {item.title}
                  </a>
                </div>
              </article>
            ))
          }
        </div>
        <div class="dev-center-cta">
          <a href="/ru/contact/" class="dev-btn dev-btn-primary"
            >Описать похожую задачу</a
          >
        </div>
      </div>
    </section>

    <!-- Pricing Section -->
    <section class="dev-section" id="preturi">
      <div class="container">
        <div class="dev-section-header">
          <span class="dev-section-tag">Цены</span>
          <h2>Прозрачные цены для малого бизнеса</h2>
          <p>
            Выберите подходящее решение: сайт-визитка, лендинг, интернет-магазин
          </p>
        </div>
        <div class="dev-pricing-grid">
          <div class="dev-pricing-card">
            <span class="dev-card-title">Сайт-визитка</span>
            <p>
              Идеально для бизнеса, которому нужен профессиональный онлайн‑образ
            </p>
            <ul class="dev-pricing-features">
              <li>Современный дизайн + 5 страниц</li>
              <li>SEO на странице</li>
              <li>Контактная форма и карты</li>
              <li>Адаптивный дизайн</li>
              <li>Передача согласованных доступов</li>
            </ul>
            <a
              href="/ru/contact/"
              class="dev-btn dev-btn-secondary dev-btn-block">Запросить предложение</a
            >
          </div>
          <div class="dev-pricing-card featured">
            <span class="dev-card-title">Интернет-магазин</span>
            <p>Полное ecommerce‑решение для онлайн‑продаж</p>
            <ul class="dev-pricing-features">
              <li>Каталог товаров + корзина</li>
              <li>Методы оплаты и доставки</li>
              <li>Техническое SEO и структура</li>
              <li>Удобная панель управления</li>
              <li>Интеграция курьерских служб</li>
              <li>Проверка ключевых сценариев заказа</li>
            </ul>
            <a
              href="/ru/contact/"
              class="dev-btn dev-btn-primary dev-btn-block">Запросить предложение</a
            >
          </div>
          <div class="dev-pricing-card">
            <span class="dev-card-title">SEO и обслуживание</span>
            <p>Поддерживайте сайт актуальным и оптимизированным</p>
            <ul class="dev-pricing-features">
              <li>Обновления и безопасность</li>
              <li>Оптимизация контента и скорости</li>
              <li>Ежемесячная отчетность</li>
              <li>Ежедневные автоматические бэкапы</li>
              <li>Мониторинг доступности</li>
            </ul>
            <a
              href="/ru/contact/"
              class="dev-btn dev-btn-secondary dev-btn-block">Запросить предложение</a
            >
          </div>
        </div>
        <p class="dev-pricing-note">
          Подробности о <a
            href="/ru/preturi/"
            class="dev-link-accent">ценах на создание сайтов</a
          > на отдельной странице
        </p>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="dev-section" id="faq">
      <div class="container">
        <div class="dev-section-header">
          <span class="dev-section-tag">FAQ</span>
          <h2>Часто задаваемые вопросы</h2>
          <p>Краткие ответы для осознанного выбора</p>
        </div>
        <div class="dev-faq-list">
          {
            faqs.map((faq) => (
              <details class="dev-faq-item">
                <summary>{faq.question}</summary>
                <p>{faq.answer}</p>
              </details>
            ))
          }
        </div>
      </div>
