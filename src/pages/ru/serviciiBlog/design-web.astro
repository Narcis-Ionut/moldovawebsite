---
import BaseHead from "../../../components/BaseHead.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import "../../../styles/dev-ru-blog-services.css";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "UX-дизайн сайта",
  description:
    "UX-дизайн сайта: структура страниц, адаптивные интерфейсы и понятные действия для малого бизнеса в Молдове.",
  provider: {
    "@type": "Person",
    name: "Narcis",
    url: "https://chisinauweb.com/ru/about/",
    jobTitle: "Независимый веб-разработчик",
    worksFor: {
      "@type": "Organization",
      name: "ChisinauWeb.com",
      url: "https://chisinauweb.com/",
    },
  },
  areaServed: {
    "@type": "Country",
    name: "Moldova",
  },
  serviceType: "Web Design",
};

const features = [
  {
    icon: "🎨",
    title: "Индивидуальный дизайн",
    description:
      "Визуальное решение строится вокруг содержания, задач и уже существующего стиля вашего бренда.",
  },
  {
    icon: "📱",
    title: "Адаптивный дизайн",
    description:
      "Макеты учитывают смартфоны, планшеты и компьютеры. Контрольные размеры и важные состояния согласовываются для конкретного проекта.",
  },
  {
    icon: "⚡",
    title: "Учет производительности",
    description:
      "На этапе дизайна учитываю вес изображений, шрифты и сложность эффектов. Фактическая скорость также зависит от разработки, контента и хостинга.",
  },
  {
    icon: "🔍",
    title: "Основа для технического SEO",
    description:
      "Логичная иерархия заголовков, навигация и блоки контента упрощают дальнейшую техническую SEO-настройку.",
  },
  {
    icon: "🎯",
    title: "Понятные действия",
    description:
      "Кнопки, навигация и формы размещаются по понятному пути пользователя, без обещаний гарантированного роста заявок.",
  },
  {
    icon: "🔄",
    title: "Согласованные правки",
    description:
      "Количество раундов правок и границы этапа фиксируются до начала работы. Дополнительные изменения согласовываются отдельно.",
  },
];

const process = [
  {
    step: "01",
    title: "Бриф и исследование",
    description:
      "Я уточняю, чем занимается бизнес, кому нужен сайт, какие материалы уже есть и что пользователь должен сделать на странице.",
  },
  {
    step: "02",
    title: "Прототипирование",
    description:
      "Готовлю схематичные макеты страниц, чтобы согласовать структуру и содержание до визуальной проработки.",
  },
  {
    step: "03",
    title: "Визуальный дизайн",
    description:
      "Формирую интерфейс на основе согласованной структуры, фирменных материалов и практических требований проекта.",
  },
  {
    step: "04",
    title: "Адаптация и сдача",
    description:
      "Показываю адаптивные состояния, вношу согласованные правки и передаю подготовленные к разработке макеты.",
  },
];

const benefits = [
  {
    title: "Понятная подача",
    description:
      "Последовательная визуальная система помогает посетителю быстрее понять, чем занимается бизнес и где найти важную информацию.",
  },
  {
    title: "Удобный путь пользователя",
    description:
      "Продуманный UX/UI-дизайн делает навигацию, формы и основные действия заметными и предсказуемыми.",
  },
  {
    title: "Выделение среди конкурентов",
    description:
      "Собственная визуальная подача помогает не выглядеть как случайный шаблон и сохраняет характер бренда.",
  },
];

const faqs = [
  {
    question: "Сколько стоит веб-дизайн в Молдове?",
    answer:
      "Ориентировочная цена начинается от 50€ за простой одностраничный дизайн. Дизайн сайта-визитки на 5–7 страниц стоит от 150€, а дизайн магазина или портала — от 300€. Точная стоимость зависит от количества уникальных экранов, состояний и готовности материалов.",
  },
  {
    question: "Сколько времени занимает создание дизайна?",
    answer:
      "Срок зависит от количества страниц и состояний, готовности текстов и изображений, а также времени на обратную связь. Реалистичный график я называю после брифа и фиксирую до начала работы.",
  },
  {
    question: "Могу ли я вносить изменения в дизайн?",
    answer:
      "Да. Количество раундов правок заранее указывается в предложении. Изменения за пределами согласованного объёма можно оценить и выполнить отдельно.",
  },
  {
    question: "Вы создаете только дизайн или готовый сайт?",
    answer:
      "Я могу подготовить только дизайн-макеты или взять на себя дизайн, разработку и запуск сайта. Состав работы фиксируется до начала проекта.",
  },
  {
    question: "Какие инструменты вы используете?",
    answer:
      "Для макетов и прототипов могу использовать Figma: там удобно просматривать экраны и оставлять комментарии. Инструменты выбираю по задаче, а формат передачи согласовываю заранее.",
  },
];
---

<!doctype html>
<html lang="ru">
  <head>
    <BaseHead
      title="UX-дизайн сайта | Интерфейс и конверсии"
      description="UX-дизайн сайта в Молдове: понятная структура страниц, адаптивные интерфейсы и подготовка макетов к разработке."
      canonicalUrl="https://chisinauweb.com/ru/serviciiBlog/design-web/"
      lang="ru"
      hreflangRo="https://chisinauweb.com/serviciiBlog/design-web/"
      hreflangRu="https://chisinauweb.com/ru/serviciiBlog/design-web/"
      ogType="article"
      jsonLd={jsonLd}
    />
  </head>
  <body class="dev-ru-theme">
    <Header lang="ru" />

    <!-- Hero Section -->
    <section class="hero">
      <div class="container grid">
        <div class="hero-content">
          <h1>
            Веб-дизайн в Молдове — понятные интерфейсы для бизнеса
          </h1>
          <p class="subheading">
            Я проектирую структуру и внешний вид сайтов для бизнеса в Молдове:
            от первого экрана и навигации до форм и адаптивных состояний для
            телефона и компьютера.
          </p>
          <div class="hero-actions">
            <a href="/ru/contact/" class="btn btn-primary"
              >Обсудить дизайн сайта</a
            >
          </div>
        </div>
      </div>
    </section>

    <!-- Intro Section -->
    <section class="content-section services-alt">
      <div class="container">
        <div class="section-title">
          <h2>Почему веб-дизайн важен для вашего бизнеса</h2>
          <p>
            В современном цифровом мире ваш сайт — это часто первый контакт
            потенциального клиента с вашим бизнесом. Веб-дизайн должен быстро
            объяснять предложение, помогать найти важную информацию и не мешать
            человеку связаться с вами или оформить заказ.
          </p>
          <p>
            Я начинаю с содержания и задач, а не с декоративных эффектов. Учитываю
            язык, привычные для местной аудитории способы связи и материалы,
            которые бизнес действительно сможет поддерживать после запуска.
          </p>
        </div>
      </div>
    </section>

    <!-- Main Content -->
    <section class="content-section">
      <div class="container">
        <div class="section-title">
          <h2>Что значит качественный веб-дизайн для вашего бизнеса</h2>
          <p>
            Веб-дизайн в Молдове — это не только внешний вид. Он связывает
            содержание, навигацию, мобильную версию и действия, ради которых
            создаётся сайт.
          </p>
        </div>

        <div class="content-grid">
          <div class="content-block">
            <p class="service-card-title">Первое впечатление и ясность</p>
            <p>
              Посетитель быстро оценивает, понятен ли сайт и может ли он найти
              нужную услугу, цену или контакт. Последовательная типографика,
              реальные материалы и ясная структура делают эту оценку проще.
            </p>
            <p>
              В проектах для Молдовы я также учитываю выбранные языки, локальные
              контактные сценарии и то, как содержание будет выглядеть на
              небольшом экране.
            </p>
          </div>
          <div class="content-image">
            <img
              src="/assets/design-web-1.webp"
              alt="Профессиональный веб-дизайн для бизнеса в Молдове"
              width="500"
              height="300"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>

        <div class="content-grid reverse">
          <div class="content-block">
            <p class="service-card-title">Пользовательский опыт (UX) — в приоритете</p>
            <p>
              Красивый, но неудобный сайт не решает задачу. Я делаю упор
              на:
            </p>
            <ul>
              <li>Интуитивную и простую навигацию</li>
              <li>Логичную структуру информации</li>
              <li>Умеренный объём изображений и эффектов</li>
              <li>Заметные интерактивные элементы</li>
              <li>Короткие и понятные формы</li>
            </ul>
            <p>
              Цель — помочь посетителю найти нужное и выполнить следующий шаг
              без лишних догадок. Количество заявок также зависит от предложения,
              трафика и работы самого бизнеса.
            </p>
          </div>
          <div class="content-image">
            <img
              src="/assets/design-web-2.webp"
              alt="Оптимизированный пользовательский опыт для сайтов в Молдове"
              width="500"
              height="300"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>

        <div class="content-grid">
          <div class="content-block">
            <p class="service-card-title">Адаптивный дизайн для всех устройств (Responsive)</p>
            <p>
              Многие посетители открывают сайт с телефона, поэтому мобильная
              версия рассматривается с самого начала. Макеты обычно охватывают:
            </p>
            <ul>
              <li>Типовые размеры смартфонов</li>
              <li>Планшеты</li>
              <li>Ноутбуки и настольные ПК</li>
            </ul>
            <p>
              Во время разработки интерфейс дополнительно проверяется на
              согласованном наборе экранов и браузеров.
            </p>
          </div>
          <div class="content-image">
            <img
              src="/assets/design-web-3.webp"
              alt="Адаптивный дизайн для всех типов устройств"
              width="500"
              height="300"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Features Section -->
    <section class="services services-alt">
      <div class="container">
        <div class="section-title">
          <h2>Что может входить в услугу веб-дизайна</h2>
          <p>Точный набор экранов и материалов зависит от задачи и бюджета.</p>
        </div>

        <div class="service-grid">
          {
            features.map((feature) => (
              <div class="service-card">
                <div class="service-icon">{feature.icon}</div>
                <p class="service-title">{feature.title}</p>
                <p class="service-desc">{feature.description}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Process Section -->
    <section class="process">
      <div class="container">
        <div class="section-title">
          <h2>Как я создаю дизайн вашего сайта</h2>
          <p>
            Последовательный процесс: от требований и структуры до согласованных
            макетов для разработки.
          </p>
        </div>

        <div class="process-steps">
          {
            process.map((p) => (
              <div class="step">
                <div class="step-number">{p.step}</div>
                <p class="step-title">{p.title}</p>
                <p class="step-desc">{p.description}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Benefits Section -->
    <section class="content-section services-alt">
      <div class="container">
        <div class="section-title">
          <h2>Преимущества профессионального веб-дизайна</h2>
          <p>Практическая польза понятного и последовательного интерфейса</p>
        </div>
        <div class="content-grid content-grid-tight">
          {
            benefits.map((benefit) => (
              <div class="content-block content-block-plain">
                <p class="service-card-title">{benefit.title}</p>
                <p>{benefit.description}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="faq">
      <div class="container">
        <div class="section-title">
          <h2>Часто задаваемые вопросы о веб-дизайне</h2>
        </div>

        <div class="faq-list">
          {
            faqs.map((faq) => (
              <details class="faq-item">
                <summary class="faq-question">{faq.question}</summary>
                <div class="faq-answer">
                  <p>{faq.answer}</p>
                </div>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="cta">
      <div class="container">
        <div class="cta-content">
          <h2>Нужен веб-дизайн для вашего проекта?</h2>
          <p>
            Опишите бизнес, нужные страницы и материалы, которые уже есть. Я
            отвечу, какой объём дизайна имеет смысл и что потребуется до начала.
          </p>
          <a href="/ru/contact/" class="btn btn-primary"
            >Запросить предложение</a
          >
        </div>
      </div>
    </section>

    <Footer lang="ru" />

    <script src="/script.js" defer></script>
  </body>
</html>
