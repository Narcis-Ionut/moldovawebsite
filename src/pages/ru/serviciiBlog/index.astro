---
import BaseHead from "../../../components/BaseHead.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import "../../../styles/dev-pages.css";
import { ruLandingCards } from "../../../data/landingPages.ru";

const services = [
  {
    href: "/ru/serviciiBlog/design-web/",
    title: "Веб-дизайн",
    description:
      "Понятная структура, адаптивный интерфейс и визуальная подача, подходящая вашему бизнесу.",
  },
  {
    href: "/ru/serviciiBlog/dezvoltare-web/",
    title: "Веб-разработка",
    description:
      "Техническая реализация, производительность и чистая структура для сайтов и кастомных проектов.",
  },
  {
    href: "/ru/serviciiBlog/seo-on-page/",
    title: "SEO-аудит",
    description:
      "Техническая проверка, мета-теги, структура и практические исправления для поисковой видимости.",
  },
  {
    href: "/ru/serviciiBlog/magazin-online/",
    title: "Интернет-магазин",
    description:
      "E-commerce решения для каталога, заказа, оплат и доставки на рынке Молдовы.",
  },
  {
    href: "/ru/serviciiBlog/mentenanta/",
    title: "Техническая поддержка",
    description:
      "Согласованные обновления, резервные копии, мониторинг и изменения уже работающего сайта.",
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Главная",
          item: "https://chisinauweb.com/ru/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Услуги",
          item: "https://chisinauweb.com/ru/serviciiBlog/",
        },
      ],
    },
    {
      "@type": "CollectionPage",
      name: "Веб-услуги в Молдове",
      description:
        "Услуги веб-дизайна, разработки, SEO-аудита, создания интернет-магазинов и поддержки сайтов в Молдове.",
      url: "https://chisinauweb.com/ru/serviciiBlog/",
      inLanguage: "ru-MD",
    },
    {
      "@type": "ItemList",
      itemListElement: services.map((service, index) => ({
        "@type": "ListItem",
        position: index + 1,
        url: `https://chisinauweb.com${service.href}`,
        name: service.title,
      })),
    },
  ],
};
---

<!doctype html>
<html lang="ru">
  <head>
    <BaseHead
      title="Веб-услуги в Молдове | Дизайн, разработка, SEO"
      description="Веб-услуги для бизнеса в Молдове: создание сайта, веб-дизайн, разработка, SEO-аудит, интернет-магазин и поддержка."
      canonicalUrl="https://chisinauweb.com/ru/serviciiBlog/"
      hreflangRo="https://chisinauweb.com/serviciiBlog/"
      hreflangRu="https://chisinauweb.com/ru/serviciiBlog/"
      lang="ru"
      jsonLd={jsonLd}
    />
  </head>
  <body>
    <div class="dev-grid-pattern"></div>
    <Header lang="ru" />

    <section class="dev-hero">
      <div class="container">
        <div class="dev-hero-content">
          <span class="dev-section-tag">Услуги</span>
          <h1>Веб-услуги для бизнеса в Молдове</h1>
          <p>
            Я создаю и дорабатываю сайты для бизнеса в Кишинёве и по всей
            Молдове. Вы общаетесь напрямую со мной: я разбираю задачу,
            предлагаю практичный объём работы, реализую и проверяю результат.
          </p>
          <p>
            Можно начать с нового сайта, обновить дизайн, подключить нужные
            функции, провести SEO-аудит или договориться об обслуживании уже
            работающего проекта.
          </p>
          <p>
            Сайт-визитка подходит для ясного представления услуг и контактов,
            интернет-магазин — для каталога и заказов, а отдельная
            веб-разработка — когда нужны формы, интеграции, личные кабинеты или
            другая логика.
          </p>
          <p>
            На страницах ниже указано, что может входить в каждую услугу, как
            строится работа и от чего зависят цена и сроки. Точный состав
            согласовывается после того, как я увижу требования и исходные материалы.
          </p>
          <p>
            Если сайт уже существует, сначала можно определить, что действительно
            мешает работе: содержание, мобильная версия, техническая реализация,
            путь оформления заказа или базовая SEO-настройка. Я прямо скажу, что
            стоит исправить сейчас, а что можно отложить.
          </p>
          <div class="dev-hero-actions">
            <a href="/ru/preturi/" class="dev-btn dev-btn-primary">Посмотреть цены</a>
            <a href="/ru/contact/" class="dev-btn dev-btn-secondary">Обсудить проект</a>
          </div>
        </div>
      </div>
    </section>

    <section class="dev-section dev-section-alt">
      <div class="container">
        <div class="dev-section-header">
          <span class="dev-section-tag">Направления</span>
          <h2>Выберите нужную услугу</h2>
          <p>Откройте описание услуги, которая ближе всего к задаче проекта.</p>
        </div>
        <div class="dev-info-grid">
          {
            services.map((service) => (
              <article class="dev-info-card">
                <span class="dev-card-title">{service.title}</span>
                <p>{service.description}</p>
                <a href={service.href} class="dev-link-accent">{service.title}</a>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="dev-section">
      <div class="container">
        <div class="dev-section-header">
          <span class="dev-section-tag">Как выбрать</span>
          <h2>С чего начать работу над сайтом</h2>
          <p>Несколько практичных ориентиров, если формат проекта ещё не определён.</p>
        </div>
        <div class="dev-info-grid">
          <div class="dev-info-card">
            <span class="dev-card-title">Нужно обновить внешний вид</span>
            <p>
              Начните с <a href="/ru/serviciiBlog/design-web/">Веб-дизайна</a>,
              если текущая подача устарела или пользователям трудно разобраться
              в структуре страницы.
            </p>
          </div>
          <div class="dev-info-card">
            <span class="dev-card-title">Нужна техническая реализация</span>
            <p>
              Переходите в
              <a href="/ru/serviciiBlog/dezvoltare-web/">Веб-разработку</a> для
              структуры, реализации и запуска.
            </p>
          </div>
          <div class="dev-info-card">
            <span class="dev-card-title">Есть технические вопросы по SEO</span>
            <p>
              Страница <a href="/ru/serviciiBlog/seo-on-page/">SEO-аудит</a>
              описывает проверку индексации, мета-данных, структуры, скорости и
              других факторов, которые можно исправить на самом сайте.
            </p>
          </div>
          <div class="dev-info-card">
            <span class="dev-card-title">Нужны онлайн-продажи</span>
            <p>
              Для каталога и заказов идите в
              <a href="/ru/serviciiBlog/magazin-online/">Интернет-магазин</a>.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="dev-section dev-section-alt">
      <div class="container">
        <div class="dev-section-header">
          <span class="dev-section-tag">Варианты проекта</span>
          <h2>От сайта-визитки до интернет-магазина</h2>
          <p>
            Здесь собраны более конкретные варианты: создание сайта в Кишинёве,
            сайт-визитка, веб-дизайн и SEO в Молдове.
          </p>
        </div>
        <div class="dev-info-grid">
          {
            ruLandingCards.map((page) => (
              <article class="dev-info-card">
                <span class="dev-card-title">{page.title}</span>
                <p>{`Что обычно входит в услугу «${page.title}», кому она подходит и что нужно уточнить до начала работы.`}</p>
                <a href={page.href} class="dev-link-accent">Открыть {page.title}</a>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="dev-cta">
      <div class="container">
        <div class="dev-cta-content">
          <h2>Расскажите, что должен делать сайт</h2>
          <p>
            Опишите бизнес, задачу и то, что уже есть. Я помогу определить
            реалистичный первый этап, объясню ограничения и предложу понятный
            объём работ.
          </p>
          <a href="/ru/contact/" class="dev-btn dev-btn-primary dev-btn-lg">
            Обсудить проект
          </a>
        </div>
      </div>
    </section>

    <Footer lang="ru" />
    <script src="/script.js" defer></script>
  </body>
</html>
