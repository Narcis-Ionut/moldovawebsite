---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import "../../styles/dev-pages.css";

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ContactPage",
      name: "Контакты",
      url: "https://chisinauweb.com/ru/contact/",
      inLanguage: "ru-MD",
      about: { "@id": "https://chisinauweb.com/about/#narcis" },
      mainEntity: { "@id": "https://chisinauweb.com/about/#narcis" },
    },
    {
      "@type": "Person",
      "@id": "https://chisinauweb.com/about/#narcis",
      name: "Narcis",
      jobTitle: "Независимый веб-разработчик",
      url: "https://chisinauweb.com/ru/about/",
      email: "contact@chisinauweb.com",
      telephone: "+37361211739",
      workLocation: {
        "@type": "Place",
        address: {
          "@type": "PostalAddress",
          addressLocality: "Кишинёв",
          addressCountry: "MD",
        },
      },
    },
  ],
};

const features = [
  {
    icon: "💬",
    title: "Прямая коммуникация",
    description:
      "Вы обсуждаете задачу напрямую со мной — человеком, который анализирует, создаёт и проверяет проект.",
  },
  {
    icon: "🧭",
    title: "Реалистичный объём",
    description:
      "Я объясняю, что стоит реализовать сейчас, что можно упростить и какие ограничения важно учесть.",
  },
  {
    icon: "✓",
    title: "Практическая проверка",
    description:
      "Перед публикацией я проверяю согласованные функции, формы и основные сценарии на телефоне и компьютере.",
  },
  {
    icon: "🔑",
    title: "Доступы к проекту",
    description:
      "После проверки и публикации вы получаете доступ к вещам, которые относятся к вашему проекту.",
  },
];

const process = [
  {
    number: "01",
    title: "Задача",
    description:
      "Вы объясняете мне, чем занимается ваш бизнес и чего должен достичь сайт.",
  },
  {
    number: "02",
    title: "Разбор",
    description:
      "Я анализирую требования и прямо говорю, что стоит создавать, что можно упростить и где есть ограничения.",
  },
  {
    number: "03",
    title: "Создание проекта",
    description:
      "Я создаю проект, проверяю функции и показываю вам прогресс по ходу работы.",
  },
  {
    number: "04",
    title: "Проверка и публикация",
    description:
      "После проверки мы публикуем сайт, а вы получаете доступ ко всему, что относится к вашему проекту.",
  },
];

const services = [
  {
    title: "Сайт-визитка",
    description:
      "Сайт для представления бизнеса, услуг и способов связи. Количество страниц и способ обновления контента определяются до начала работы.",
  },
  {
    title: "Интернет-магазин",
    description:
      "Каталог, корзина, способы оплаты, доставка и управление товарами — только те функции, которые согласованы для проекта.",
  },
  {
    title: "Лендинг",
    description:
      "Одностраничный сайт с понятной структурой, основным предложением и удобным способом связаться.",
  },
  {
    title: "Редизайн сайта",
    description:
      "Разбираю существующий сайт и обновляю согласованные части: структуру, интерфейс, мобильную версию или техническую основу.",
  },
];

const faqs = [
  {
    question: "Сколько времени занимает создание сайта?",
    answer:
      "Срок зависит от количества страниц, готовности контента, интеграций и скорости согласования. После разбора требований я называю реалистичную оценку для конкретного проекта.",
  },
  {
    question: "Какую информацию нужно предоставить?",
    answer:
      "Полезны описание бизнеса, цель сайта, примеры, тексты, логотип и изображения, если они уже есть. Техническое задание не обязательно — я помогу разложить требования по шагам.",
  },
  {
    question: "Работаете ли вы за пределами Кишинева?",
    answer:
      "Да. Я нахожусь в Кишинёве и могу вести проект онлайн для клиента из любого региона Молдовы.",
  },
  {
    question: "Можно ли платить частями?",
    answer:
      "Условия оплаты фиксируются в предложении. Для подходящих проектов можно согласовать оплату двумя частями.",
  },
];

const contactMethods = [
  {
    icon: "📧",
    title: "Email",
    value: "contact@chisinauweb.com",
    link: "mailto:contact@chisinauweb.com",
    description: "Подходит для подробного описания задачи и файлов",
  },
  {
    icon: "📱",
    title: "Телефон / WhatsApp",
    value: "+373 61 211 739",
    link: "tel:+37361211739",
    description: "Доступен Пн-Пт 09:00-18:00",
  },
  {
    icon: "💬",
    title: "Онлайн-форма",
    value: "Заполните форму",
    link: "#formular",
    description: "Опишите бизнес, цель сайта и нужные функции",
  },
];
---

<!doctype html>
<html lang="ru">
  <head>
    <BaseHead
      title="Связаться с Нарцисом | Создание сайтов в Молдове"
      description="Опишите Нарцису задачу по созданию сайта или веб-приложения в Кишинёве и Молдове. Прямая коммуникация на русском или румынском языке."
      canonicalUrl="https://chisinauweb.com/ru/contact/"
      lang="ru"
      ogLocale="ru_MD"
      hreflangRo="https://chisinauweb.com/contact/"
      hreflangRu="https://chisinauweb.com/ru/contact/"
      image="/assets/og-image-contact.webp"
      jsonLd={jsonLd}
    />
    <!-- Cloudflare Turnstile -->
    <script src="https://challenges.cloudflare.com/turnstile/v0/g/8fc8ed1d8752/api.js" defer
    ></script>
    
  </head>
  <body>
    <div class="dev-grid-pattern"></div>
    <Header lang="ru" />

    <!-- Hero Section -->
    <section class="dev-hero">
      <div class="container">
        <div class="dev-hero-content">
          <span class="dev-section-tag">Контакты</span>
          <h1>Расскажите мне о вашем проекте</h1>
          <p>
            Если вам нужно создание сайта в Кишинёве или другом регионе
            Молдовы, кратко опишите бизнес, задачу и желаемый результат.
            Техническое задание на этом этапе не требуется.
          </p>
        </div>
        <div class="dev-hero-intro">
          <p>
            Я Нарцис, независимый веб-разработчик в Кишинёве. Работаю с
            <strong>сайтами-визитками</strong>, <strong
              >интернет-магазинами</strong
            >, лендингами и более сложными веб-приложениями. Вы общаетесь
            напрямую со мной, без аккаунт-менеджера или агентских слоёв.
          </p>
          <p>
            Можно заполнить форму, отправить email или написать в WhatsApp. Я
            разберу описание и прямо скажу, какой вариант реалистичен, что можно
            упростить и какие детали нужно уточнить перед оценкой.
          </p>
        </div>
      </div>
    </section>

    <!-- Contact Methods Section -->
    <section class="dev-section dev-section-alt">
      <div class="container">
        <div class="dev-section-header">
          <span class="dev-section-tag">Как связаться</span>
          <h2>Выберите удобный способ</h2>
          <p>Сообщение попадает напрямую человеку, который будет разбирать проект.</p>
        </div>
        <div class="dev-contact-methods">
          {
            contactMethods.map((method) => (
              <div class="dev-contact-method">
                <div class="icon">{method.icon}</div>
                <h3>{method.title}</h3>
                <a href={method.link}>{method.value}</a>
                <p>{method.description}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Contact Form Section -->
    <section class="dev-section" id="formular">
      <div class="container">
        <div class="dev-contact-grid">
          <form
            class="dev-form"
            id="contactForm"
            method="post"
            action="/api/contact"
            novalidate
          >
            <input type="hidden" name="lang" value="ru" />
            <div class="dev-form-field">
              <label for="name">Имя и фамилия *</label>
              <input
                type="text"
                id="name"
                name="name"
                maxlength="120"
                placeholder="Ваше имя"
                required
              />
            </div>

            <div class="dev-form-field">
              <label for="email">Email *</label>
              <input
                type="email"
                id="email"
                name="email"
                maxlength="254"
                placeholder="nume@domeniu.md"
                required
              />
              <div class="dev-form-help">
                Я использую этот адрес, чтобы ответить по вашему запросу
              </div>
            </div>

            <div class="dev-form-field">
              <label for="phone">Телефон (опционально)</label>
              <input
                type="tel"
                id="phone"
                name="phone"
                maxlength="60"
                placeholder="+373 6xx xxx xx"
                inputmode="tel"
              />
            </div>

            <div class="dev-form-field">
              <label for="subject">Тема *</label>
              <input
                type="text"
                id="subject"
                name="subject"
                maxlength="180"
                placeholder="Сайт для кафе в Кишиневе"
                required
              />
            </div>

            <div class="dev-form-field">
              <label>Тип проекта</label>
              <div
                class="dev-chip-group"
                role="radiogroup"
                aria-label="Тип проекта"
              >
                <button
                  type="button"
                  class="dev-chip active"
                  data-value="Сайт-визитка">Сайт-визитка</button
                >
                <button
                  type="button"
                  class="dev-chip"
                  data-value="Интернет-магазин">Интернет-магазин</button
                >
                <button type="button" class="dev-chip" data-value="Лендинг"
                  >Лендинг</button
                >
                <button type="button" class="dev-chip" data-value="Редизайн"
                  >Редизайн</button
                >
                <button type="button" class="dev-chip" data-value="Другое"
                  >Другое</button
                >
              </div>
              <input
                type="hidden"
                name="project_type"
                id="project_type"
                value="Сайт-визитка"
              />
            </div>

            <div class="dev-form-field">
              <label>Ориентировочный бюджет (EUR)</label>
              <div class="dev-range-wrap">
                <input
                  type="range"
                  class="dev-range"
                  id="budget"
                  name="budget"
                  min="50"
                  max="2000"
                  step="50"
                  value="300"
                />
                <span class="dev-range-badge" id="budgetBadge">€300</span>
              </div>
            </div>

            <div class="dev-form-field">
              <label for="message">Сообщение *</label>
              <textarea
                id="message"
                name="message"
                maxlength="6000"
                placeholder="Детали о вашем проекте..."
                required></textarea>
              <div class="dev-form-help">
                Полезные детали: страницы, функции, примеры, сроки
              </div>
            </div>

            <div class="dev-form-field">
              <label class="dev-checkbox">
                <input type="checkbox" name="consent" id="consent" required />
                <span
                  >Я согласен(а) на обработку данных согласно GDPR и хочу, чтобы
                  со мной связались.</span
                >
              </label>
            </div>

            <div class="dev-form-field">
              <div
                class="cf-turnstile"
                data-sitekey="0x4AAAAAAB0f_L28X_bHlrIA"
                data-theme="dark"
              >
              </div>
            </div>

            <button type="submit" class="dev-submit">Отправить сообщение</button
            >
            <span
              class="dev-form-help dev-form-status"
              id="formStatus"
              role="status"
              aria-live="polite"
            ></span>
          </form>

          <aside class="dev-info-card">
            <h3>Контактные данные</h3>
            <ul class="dev-info-list">
              <li>
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"></path>
                  <path
                    d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"
                  ></path>
                </svg>
                <span>Кишинёв, Молдова</span>
              </li>
              <li>
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path
                    d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"
                  ></path>
                </svg>
                <a href="tel:+37361211739">+373 61 211 739</a>
              </li>
              <li>
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path
                    d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"
                  ></path>
                </svg>
                <a href="mailto:contact@chisinauweb.com"
                  >contact@chisinauweb.com</a
                >
              </li>
              <li>
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <circle cx="12" cy="12" r="10"></circle>
                  <path d="M12 6v6l4 2"></path>
                </svg>
                <span>Пн–Пт 09:00–18:00</span>
              </li>
            </ul>

            <div class="dev-info-divider"></div>
            <p>
              Предпочитаете WhatsApp? Напишите мне напрямую и кратко опишите задачу.
            </p>
            <a
              href="https://api.whatsapp.com/send?phone=37361211739"
              target="_blank"
              rel="noopener noreferrer"
              class="dev-btn-secondary"
            >
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path
                  d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
                ></path>
              </svg>
              Открыть WhatsApp
            </a>
          </aside>
        </div>
      </div>
    </section>

    <!-- Features Section -->
    <section class="dev-section dev-section-alt">
      <div class="container">
        <div class="dev-section-header">
          <span class="dev-section-tag">Что ожидать</span>
          <h2>Работа напрямую с разработчиком</h2>
          <p>Понятная коммуникация, реалистичный объём и проверка перед публикацией.</p>
        </div>
        <div class="dev-features-grid">
          {
            features.map((f) => (
              <div class="dev-feature-card">
                <div class="dev-feature-icon">{f.icon}</div>
                <h3>{f.title}</h3>
                <p>{f.description}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Process Section -->
    <section class="dev-section">
      <div class="container">
        <div class="dev-section-header">
          <span class="dev-section-tag">Процесс</span>
          <h2>Как мы работаем вместе</h2>
          <p>Четыре понятных шага от задачи до опубликованного проекта.</p>
        </div>
        <div class="dev-process-grid">
          {
            process.map((p) => (
              <div class="dev-process-step">
                <div class="dev-process-num">{p.number}</div>
                <h3>{p.title}</h3>
                <p>{p.description}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Services Section -->
    <section class="dev-section dev-section-alt">
      <div class="container">
        <div class="dev-section-header">
          <span class="dev-section-tag">Услуги</span>
          <h2>С чем я могу помочь</h2>
          <p>Сайты и веб-приложения с объёмом, согласованным под реальную задачу.</p>
        </div>
        <div class="dev-services-list">
          {
            services.map((s) => (
              <div class="dev-service-item">
                <h3>{s.title}</h3>
                <p>{s.description}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="dev-section">
      <div class="container">
        <div class="dev-section-header">
          <span class="dev-section-tag">FAQ</span>
          <h2>Часто задаваемые вопросы</h2>
          <p>Ответы на самые распространенные вопросы</p>
        </div>
        <div class="dev-faq-list">
          {
            faqs.map((faq) => (
              <details class="dev-faq-item">
                <summary>{faq.question}</summary>
                <p>{faq.answer}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <Footer lang="ru" />
    <script src="/script.js" defer></script>
  </body>
</html>
