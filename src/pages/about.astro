---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/dev-pages.css";

const directCards = [
  {
    title: "Comunicare directă",
    description:
      "Discuți direct cu persoana care lucrează la proiect, fără account manager și fără informație pierdută între mai multe persoane.",
  },
  {
    title: "Decizii practice",
    description:
      "Încep de la ce trebuie să facă site-ul pentru afacere, nu de la o listă inutilă de efecte sau tehnologii.",
  },
  {
    title: "AI folosit cu responsabilitate",
    description:
      "Folosesc instrumente moderne pentru a lucra mai eficient, dar verificarea și responsabilitatea rezultatului nu sunt delegate unui model AI.",
  },
  {
    title: "Proiecte reale",
    description:
      "Portofoliul conține produse și website-uri care există, nu machete cumpărate sau rezultate inventate.",
  },
];

const collaborationSteps = [
  {
    title: "Îmi explici afacerea și obiectivul",
    description:
      "Îmi explici ce face afacerea ta și ce trebuie să realizeze site-ul.",
  },
  {
    title: "Clarific soluția și limitele",
    description:
      "Analizez cerințele și îți spun direct ce merită construit, ce poate fi simplificat și care sunt limitele.",
  },
  {
    title: "Construiesc și verific",
    description:
      "Construiesc proiectul, verific funcțiile și îți arăt progresul pe parcurs.",
  },
  {
    title: "Publicăm și predau accesul",
    description:
      "După verificare, publicăm site-ul și primești acces la lucrurile care țin de proiectul tău.",
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "AboutPage",
      name: "Despre Narcis — dezvoltator web independent în Chișinău",
      description:
        "Cum lucrează Narcis, dezvoltator web independent în Chișinău, și cum folosește responsabil JavaScript, TypeScript, React, Astro, Cloudflare și instrumente AI.",
      url: "https://chisinauweb.com/about/",
      inLanguage: "ro-MD",
      mainEntity: { "@id": "https://chisinauweb.com/about/#narcis" },
    },
    {
      "@type": "Person",
      "@id": "https://chisinauweb.com/about/#narcis",
      name: "Narcis",
      jobTitle: "Dezvoltator web independent",
      description:
        "Dezvoltator web independent în Chișinău care construiește site-uri și aplicații web.",
      url: "https://chisinauweb.com/about/",
      email: "contact@chisinauweb.com",
      telephone: "+37361211739",
      knowsAbout: [
        "JavaScript",
        "TypeScript",
        "React",
        "Astro",
        "Cloudflare Workers",
        "Baze de date",
        "Integrări de plată",
      ],
      worksFor: {
        "@type": "Organization",
        name: "ChisinauWeb.com",
        url: "https://chisinauweb.com/",
      },
    },
  ],
};
---

<!doctype html>
<html lang="ro">
  <head>
    <BaseHead
      title="Despre Narcis | Dezvoltator web în Chișinău"
      description="Sunt Narcis, dezvoltator web independent în Chișinău. Construiesc site-uri și aplicații web și folosesc transparent instrumente AI, cu verificare și responsabilitate."
      canonicalUrl="https://chisinauweb.com/about/"
      hreflangRo="https://chisinauweb.com/about/"
      hreflangRu="https://chisinauweb.com/ru/about/"
      image="/assets/og-image.webp"
      jsonLd={jsonLd}
    />
  </head>
  <body>
    <div class="dev-grid-pattern"></div>
    <Header lang="ro" />

    <section class="dev-hero" id="acasa">
      <div class="container">
        <div class="dev-hero-grid">
          <div class="dev-hero-content">
            <span class="dev-section-tag">Despre ChisinauWeb</span>
            <h1>Sunt Narcis, dezvoltator web independent în Chișinău.</h1>
            <p class="dev-hero-subtitle">
              Construiesc site-uri și aplicații web pentru afaceri și proiecte
              care au nevoie de ceva clar, rapid și utilizabil.
            </p>
            <p>
              Nu sunt o agenție mare și nu pretind că în spatele acestui site
              există o echipă de zeci de persoane. Când îmi scrii, vorbești
              direct cu omul care analizează, construiește, verifică și publică
              proiectul.
            </p>
            <div class="dev-hero-actions">
              <a href="/contact/" class="dev-btn dev-btn-primary">
                Descrie proiectul
              </a>
              <a href="/#portofoliu" class="dev-btn dev-btn-secondary">
                Vezi proiectele
              </a>
            </div>
          </div>

          <aside class="dev-scope-card" aria-label="Tehnologii și mod de lucru">
            <div class="dev-scope-header">
              <span class="dev-scope-eyebrow">Lucrez cu</span>
              <span class="dev-scope-count">doar când au sens</span>
            </div>
            <div class="dev-scope-body">
              {["JavaScript și TypeScript", "React și Astro", "Cloudflare Workers", "Baze de date și plăți"].map((item, index) => (
                <div class="dev-scope-item">
                  <span class="dev-scope-number">{String(index + 1).padStart(2, "0")}</span>
                  <strong>{item}</strong>
                </div>
              ))}
            </div>
            <p class="dev-scope-footer">
              Tehnologia este o unealtă; proiectul și utilizatorul decid ce merită folosit.
            </p>
          </aside>
        </div>
      </div>
    </section>

    <section class="dev-section">
      <div class="container">
        <div class="dev-section-header">
          <span class="dev-section-tag">Parcurs</span>
          <h2>Cum am ajuns să fac asta</h2>
        </div>
        <div class="dev-content-text">
          <p>
            Am început să învăț serios dezvoltare web în 2019, prin parcursuri
            structurate, cursuri și multă practică. Am studiat JavaScript, React
            și dezvoltare full-stack, apoi am continuat în principal construind
            proiecte reale și rezolvând problemele care apar atunci când un
            produs trebuie să funcționeze în afara unui tutorial.
          </p>
          <p>
            În prezent lucrez cu JavaScript, TypeScript, React, Astro,
            Cloudflare Workers, baze de date, formulare, autentificare,
            integrări de plată și procese de publicare. Nu folosesc toate aceste
            tehnologii în fiecare proiect. Aleg doar ceea ce are sens pentru
            problema respectivă.
          </p>
        </div>
      </div>
    </section>

    <section class="dev-section dev-section-alt">
      <div class="container">
        <div class="dev-section-header">
          <span class="dev-section-tag">Transparență</span>
          <h2>Folosesc AI și spun asta deschis</h2>
        </div>
        <div class="dev-content-text">
          <p>
            Folosesc instrumente AI în fiecare zi pentru dezvoltare. Nu pretind
            că scriu fiecare linie fără ajutor și nici nu cred că aceasta este
            singura măsură a unui produs bun. AI mă ajută să analizez mai
            repede, să explorez soluții, să reduc munca repetitivă și să verific
            mai multe variante.
          </p>
          <p>
            Totuși, un instrument AI nu înțelege singur afacerea clientului și
            nu își asumă responsabilitatea pentru rezultat. Rolul meu este să
            înțeleg ce trebuie construit, să transform cerințele într-un plan
            clar, să ghidez implementarea, să verific modificările, să testez
            funcțiile și să repar ceea ce nu merge. AI îmi oferă mai multă
            putere de lucru; responsabilitatea pentru produs rămâne la mine.
          </p>
          <p>
            Nu folosesc AI pentru a livra orbește primul rezultat generat. Îl
            folosesc ca pe un set de unelte puternice pe care trebuie să le
            conduc, să le verific și să le corectez.
          </p>
        </div>
      </div>
    </section>

    <section class="dev-section">
      <div class="container">
        <div class="dev-section-header">
          <span class="dev-section-tag">Practic</span>
          <h2>Cum lucrez</h2>
        </div>
        <div class="dev-content-text">
          <p>
            Punctul meu forte este că pot lua o idee încă neclară, cu multe
            părți în mișcare, și o pot duce către un produs care poate fi
            folosit în realitate. Îmi place să găsesc traseul practic dintre
            „ar fi bine să avem asta” și o versiune care funcționează pe
            telefon, pe desktop și în producție.
          </p>
          <p>
            Lucrez direct și explic lucrurile fără să ascund problemele în
            spatele jargonului. Dacă o funcție nu merită costul, spun asta. Dacă
            o soluție are o limită, o explic. Dacă proiectul trebuie simplificat
            pentru a putea fi lansat, propun varianta realistă.
          </p>
          <p>
            Nu public cifre despre clienți, satisfacție sau rezultate pe care nu
            le pot demonstra. Prefer să arăt proiectele reale, să explic ce am
            construit și să spun clar ce este finalizat și ce se află încă în
            dezvoltare.
          </p>
        </div>
      </div>
    </section>

    <section class="dev-section dev-section-alt">
      <div class="container">
        <div class="dev-section-header">
          <span class="dev-section-tag">Colaborare</span>
          <h2>Ce înseamnă să lucrezi direct cu mine</h2>
        </div>
        <div class="dev-info-grid">
          {
            directCards.map((card) => (
              <article class="dev-info-card">
                <span class="dev-card-title">{card.title}</span>
                <p>{card.description}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="dev-section" id="proces">
      <div class="container">
        <div class="dev-section-header">
          <span class="dev-section-tag">Proces</span>
          <h2>Cum lucrăm împreună</h2>
          <p>Discuție directă, progres vizibil și verificare înainte de publicare.</p>
        </div>
        <div class="dev-process-grid">
          {
            collaborationSteps.map((step, index) => (
              <article class="dev-process-step">
                <div class="dev-process-number">{index + 1}</div>
                <span class="dev-card-title">{step.title}</span>
                <p>{step.description}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="dev-cta" id="contact">
      <div class="container">
        <div class="dev-cta-content">
          <h2>Spune-mi ce încerci să construiești</h2>
          <p>
            Nu trebuie să pregătești un document tehnic. Explică-mi afacerea,
            problema și ce ai vrea să poată face site-ul. Îți voi răspunde
            direct cu o variantă realistă, ce presupune și ce ar trebui făcut
            mai întâi.
          </p>
          <div class="dev-hero-actions">
            <a href="/contact/" class="dev-btn dev-btn-primary dev-btn-lg">
              Descrie proiectul
            </a>
            <a href="/#portofoliu" class="dev-btn dev-btn-secondary dev-btn-lg">
              Vezi proiectele
            </a>
          </div>
        </div>
      </div>
    </section>

    <Footer lang="ro" />
    <script src="/script.js" defer></script>
  </body>
</html>
