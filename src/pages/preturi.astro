---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/dev-pages.css";
import { roLandingCards } from "../data/landingPages.ro";

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Acasă",
          item: "https://chisinauweb.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Prețuri",
          item: "https://chisinauweb.com/preturi/",
        },
      ],
    },
    {
      "@type": "Service",
      serviceType: "Creare site web",
      name: "Preț creare site Moldova 2026",
      description:
        "Preț creare site în Moldova: landing page, site de prezentare și mini-magazin, cu pachete orientative de la 50€.",
      provider: {
        "@type": "Person",
        name: "Narcis",
        jobTitle: "Dezvoltator web independent",
        url: "https://chisinauweb.com/about/",
        worksFor: {
          "@type": "Organization",
          name: "ChisinauWeb.com",
          url: "https://chisinauweb.com/",
        },
      },
      areaServed: { "@type": "Country", name: "Moldova" },
      url: "https://chisinauweb.com/preturi/",
      offers: {
        "@type": "AggregateOffer",
        lowPrice: "50",
        highPrice: "300",
        offerCount: "3",
        priceCurrency: "EUR",
        availability: "https://schema.org/InStock",
      },
    },
    {
      "@type": "OfferCatalog",
      name: "Pachete creare site web - Moldova",
      url: "https://chisinauweb.com/preturi/",
      itemListElement: [
        {
          "@type": "Offer",
          name: "Basic",
          url: "https://chisinauweb.com/preturi/#pachet-basic",
          price: "50",
          priceCurrency: "EUR",
          availability: "https://schema.org/InStock",
          itemOffered: {
            "@type": "Service",
            name: "Landing page (1 pagină)",
            areaServed: { "@type": "Country", name: "Moldova" },
          },
        },
        {
          "@type": "Offer",
          name: "Standard",
          url: "https://chisinauweb.com/preturi/#pachet-standard",
          price: "150",
          priceCurrency: "EUR",
          availability: "https://schema.org/InStock",
          itemOffered: {
            "@type": "Service",
            name: "Site de prezentare (până la 5 pagini)",
            areaServed: { "@type": "Country", name: "Moldova" },
          },
        },
        {
          "@type": "Offer",
          name: "Pro",
          url: "https://chisinauweb.com/preturi/#pachet-pro",
          price: "300",
          priceCurrency: "EUR",
          availability: "https://schema.org/InStock",
          itemOffered: {
            "@type": "Service",
            name: "Site avansat / mini-magazin",
            areaServed: { "@type": "Country", name: "Moldova" },
          },
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Care este prețul pentru creare site în Moldova în 2026?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Prețul pentru creare site în Moldova pornește de la 50€ pentru un landing page, 150€ pentru un site de prezentare și 300€ pentru un mini-magazin. Costul final depinde de numărul de pagini, design, conținut și funcționalități.",
          },
        },
        {
          "@type": "Question",
          name: "Pot plăti în MDL sau în două tranșe?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Da. Facturarea se poate face în EUR sau echivalent MDL. Pentru pachetele Standard și Pro accept plata în două tranșe: 50% avans și 50% la predare.",
          },
        },
        {
          "@type": "Question",
          name: "Ce include SEO on-page?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Meta-taguri, structură corectă (H1–H3), optimizare viteză, schema JSON-LD și configurări de bază pentru indexare.",
          },
        },
        {
          "@type": "Question",
          name: "Domeniul și găzduirea sunt incluse?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Nu. Îți recomand opțiuni potrivite proiectului și te ajut cu configurarea DNS, SSL și a adreselor de e-mail, dacă sunt necesare.",
          },
        },
        {
          "@type": "Question",
          name: "După lansare, pot modifica singur conținutul?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Pachetele Standard și Pro includ un sistem de administrare a conținutului atunci când acesta este potrivit proiectului. Pachetul Pro include și o sesiune de predare.",
          },
        },
        {
          "@type": "Question",
          name: "Care este diferența dintre preț creare website și cost creare site?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Ambele formulări se referă la costul construirii unui website. Estimarea depinde de tipul proiectului: landing page de la 50€, site de prezentare de la 150€ și mini-magazin online de la 300€.",
          },
        },
        {
          "@type": "Question",
          name: "Cât costă un site magazin online?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Un mini-magazin online pornește de la 300€ și include catalog, coș, livrare și setări de bază pentru comenzi. Pentru mai multe produse, integrări sau automatizări, estimarea se face după brief.",
          },
        },
      ],
    },
  ],
};

const packages = [
  {
    id: "pachet-basic",
    name: "Basic",
    price: "50€",
    description: "Landing page (1 pagină) – soluția rapidă și ieftină",
    features: [
      "Design responsiv mobil/tabletă",
      "Formular de contact, hartă Google",
      "SSL, optimizare viteză de bază",
      "SEO on-page de bază (Titlu, Meta, H1-H3)",
      "1 revizuire inclusă",
      "Termen stabilit după primirea conținutului",
    ],
    note: "Domeniu & găzduire nu sunt incluse. Te putem ajuta cu setarea.",
    featured: false,
  },
  {
    id: "pachet-standard",
    name: "Standard",
    price: "150€",
    description: "Site de prezentare (până la 5 pagini) + setup esențial",
    features: [
      "Design modern & UX orientat pe conversie",
      "CMS ușor (administrare conținut)",
      "SEO on-page extins + schema JSON-LD",
      "Configurare GA4 & Search Console",
      "2–3 revizuiri incluse",
      "Termen stabilit în oferta proiectului",
    ],
    note: "Ideal pentru afaceri locale care vor vizibilitate în căutări.",
    featured: true,
  },
  {
    id: "pachet-pro",
    name: "Pro",
    price: "300€",
    description: "Site avansat (până la 12 pagini) sau mini-magazin",
    features: [
      "Design personalizat + componente adaptate proiectului",
      "Mini-magazin (până la 10 produse), coș, livrare & plăți",
      "SEO avansat (structură, viteză, rich results)",
      "RO + RU (multi-language) – opțional",
      "5 revizuiri incluse + training 1 oră",
      "Termen stabilit după definirea integrărilor",
    ],
    note: "Include 1 lună mentenanță de bază post-lansare.",
    featured: false,
  },
];

const factors = [
  {
    title: "Numărul de pagini",
    description:
      "Un site de prezentare cu 3-5 pagini este mai simplu decât unul cu 10-15 pagini, ceea ce influențează timpul de lucru și bugetul.",
  },
  {
    title: "Design & identitate",
    description:
      "Template adaptat sau design personalizat? Cu cât crește nivelul de personalizare, cu atât crește și prețul.",
  },
  {
    title: "Funcționalități speciale",
    description:
      "Formulare avansate, rezervări, integrare plăți sau mini-magazin adaugă dezvoltare suplimentară.",
  },
  {
    title: "SEO & conținut",
    description:
      "Optimizarea SEO, textele copywriting și imaginile pot influența costul și rezultatele în Google.",
  },
];

const addons = [
  {
    title: "Logo & identitate vizuală",
    description: "De la 30€ – variantă principală + kit pentru web.",
  },
  {
    title: "Copywriting SEO",
    description: "De la 10€/pagină – texte optimizate pentru RO/RU.",
  },
  {
    title: "Multi-language RO/RU",
    description: "De la 30€ – pagini traduse + switcher.",
  },
  {
    title: "Mentenanță",
    description: "De la 25€/lună – actualizări, securitate, backup.",
  },
];

const faqs = [
  {
    question: "Care este prețul pentru creare site în Moldova în 2026?",
    answer:
      "Prețul pentru creare site în Moldova pornește de la 50€ pentru un landing page, 150€ pentru un site de prezentare și 300€ pentru un mini-magazin. Costul final depinde de numărul de pagini, design, conținut și funcționalități.",
  },
  {
    question: "Pot plăti în MDL sau în două tranșe?",
    answer:
      "Da. Facturarea se poate face în EUR sau echivalent MDL. Pentru pachetele Standard și Pro accept plata în două tranșe: 50% avans și 50% la predare.",
  },
  {
    question: "Ce include SEO on-page?",
    answer:
      "Meta-taguri, structură corectă pe pagină (H1–H3), optimizare viteză, schema JSON-LD (acolo unde e relevant) și configurări de bază pentru indexare.",
  },
  {
    question: "Domeniul și găzduirea sunt incluse?",
    answer:
      "Nu. Îți recomand opțiuni potrivite proiectului și te ajut la configurare (DNS, SSL și e-mailuri, dacă sunt necesare).",
  },
  {
    question: "După lansare, pot modifica singur conținutul?",
    answer:
      "Pachetele Standard și Pro includ un sistem de administrare a conținutului atunci când acesta este potrivit proiectului. Pachetul Pro include și o sesiune de predare.",
  },
  {
    question: "Care este diferența dintre preț creare website și cost creare site?",
    answer:
      "Ambele formulări se referă la costul construirii unui website. Estimarea depinde de tipul proiectului: landing page de la 50€, site de prezentare de la 150€ și mini-magazin online de la 300€.",
  },
  {
    question: "Cât costă un site magazin online?",
    answer:
      "Un mini-magazin online pornește de la 300€ și include catalog, coș, livrare și setări de bază pentru comenzi. Pentru mai multe produse, integrări sau automatizări, estimarea se face după brief.",
  },
];
---

<!doctype html>
<html lang="ro">
  <head>
    <BaseHead
      title="Preț creare site Moldova 2026 | Landing 50 EUR, site 150 EUR"
      description="Vezi cât costă un site în Moldova: landing page de la 50 EUR, site de prezentare de la 150 EUR și mini-magazin de la 300 EUR. Ofertă gratuită."
      canonicalUrl="https://chisinauweb.com/preturi/"
      hreflangRo="https://chisinauweb.com/preturi/"
      hreflangRu="https://chisinauweb.com/ru/preturi/"
      image="/assets/og-image-preturi.webp"
      jsonLd={jsonLd}
    />
    
  </head>
  <body>
    <div class="dev-grid-pattern"></div>
    <Header lang="ro" />

    <!-- Hero -->
    <section class="dev-hero">
      <div class="container">
        <div class="dev-hero-content">
          <span class="dev-section-tag">Prețuri</span>
          <h1>Preț creare site Moldova 2026: cât costă un site web?</h1>
          <p>
            Compară rapid costul pentru landing page, site de prezentare și
            mini-magazin: Basic 50€, Standard 150€, Pro 300€.
          </p>
          <p>Prețuri orientative pentru web design în Chișinău și toată Moldova.</p>
          <div class="dev-hero-actions">
            <a href="/contact/" class="dev-btn dev-btn-primary">
              Cere preț exact
            </a>
            <a href="/serviciiBlog/magazin-online/" class="dev-btn dev-btn-secondary">
              Vezi magazin online de la 300 EUR
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Quick Estimate -->
    <section class="dev-section dev-section-alt" id="estimare-rapida">
      <div class="container">
        <div class="dev-section-header">
          <span class="dev-section-tag">Estimare rapidă</span>
          <h2>Alege prețul orientativ în 30 de secunde</h2>
          <p>Folosește scenariul cel mai apropiat de proiectul tău, apoi cere oferta finală.</p>
        </div>
        <div class="dev-pricing-grid">
          <article class="dev-price-card">
            <span class="dev-card-title">Landing simplu</span>
            <div class="dev-price">~50€</div>
            <p>1 pagină, prezentare rapidă, formular de contact.</p>
            <a href="/contact/" class="dev-btn dev-btn-secondary dev-btn-block">
              Vreau Basic
            </a>
          </article>
          <article class="dev-price-card featured">
            <span class="dev-card-title">Site de prezentare</span>
            <div class="dev-price">~150€</div>
            <p>3-5 pagini, structură completă, SEO on-page esențial.</p>
            <a href="/contact/" class="dev-btn dev-btn-primary dev-btn-block">
              Vreau Standard
            </a>
          </article>
          <article class="dev-price-card">
            <span class="dev-card-title">Mini-magazin</span>
            <div class="dev-price">~300€</div>
            <p>Catalog, coș, livrare și setări pentru vânzări online.</p>
            <a href="/contact/" class="dev-btn dev-btn-secondary dev-btn-block">
              Vreau Pro
            </a>
          </article>
        </div>
        <p class="dev-inline-note">
          Estimare orientativă. Pentru detalii, citește și ghidul despre
          <a href="/blog/cat-costa-site-moldova-2026/">ghidul complet de costuri</a>.
        </p>
      </div>
    </section>

    <section class="dev-section" id="pret-creare-site-web">
      <div class="container">
        <div class="dev-section-header">
          <span class="dev-section-tag">Preț creare site web</span>
          <h2>Cât costă un site web în Moldova?</h2>
          <p>
            Prețul pentru creare site web depinde de conținut și funcții. Ca
            reper, o pagină simplă pornește de la 50 EUR, un site de prezentare
            de la 150 EUR, iar un mini-magazin online de la 300 EUR.
          </p>
        </div>
        <div class="dev-info-grid">
          <article class="dev-info-card">
            <span class="dev-card-title">Preț site de prezentare</span>
            <p>
              De la 150 EUR pentru 3-5 pagini, structură de servicii, formular,
              SEO on-page și pregătire pentru căutări locale în Moldova.
            </p>
            <a href="/site-de-prezentare/" class="dev-link-accent">site de prezentare</a>
          </article>
          <article class="dev-info-card">
            <span class="dev-card-title">Preț magazin online</span>
            <p>
              De la 300 EUR pentru mini-magazin cu catalog, coș, livrare,
              setări de comandă și bază SEO pentru produse.
            </p>
            <a href="/serviciiBlog/magazin-online/" class="dev-link-accent">magazin online</a>
          </article>
          <article class="dev-info-card">
            <span class="dev-card-title">Preț creare site Chișinău</span>
            <p>
              Pentru afaceri locale, estimarea include structură comercială,
              CTA-uri clare, optimizare mobilă și context pentru Chișinău/Moldova.
            </p>
            <a href="/creare-site-chisinau/" class="dev-link-accent">creare site Chișinău</a>
          </article>
        </div>
      </div>
    </section>

    <section class="dev-section dev-section-alt" id="de-ce-preturi-mai-mici">
      <div class="container">
        <div class="dev-section-header">
          <span class="dev-section-tag">Comparație</span>
          <h2>De ce unele agenții pornesc de la 290-990 EUR?</h2>
          <p>
            Diferența vine de obicei din mărimea echipei, procesele interne,
            brandingul agenției și nivelul de personalizare. Eu lucrez direct,
            fără straturi de account management, și păstrez aceste pachete
            orientative pentru proiecte cu un domeniu clar. Cerințele care ies
            din pachet sunt estimate separat înainte de lucru.
          </p>
        </div>
        <div class="dev-info-grid">
          <div class="dev-info-card">
            <span class="dev-card-title">Când ajunge Basic</span>
            <p>Ai nevoie de o pagină rapidă pentru ofertă, contact, reclamă sau validare de idee.</p>
          </div>
          <div class="dev-info-card">
            <span class="dev-card-title">Când alegi Standard</span>
            <p>Vrei un site de prezentare cu servicii, despre, contact și bază SEO pentru Google.</p>
          </div>
          <div class="dev-info-card">
            <span class="dev-card-title">Când alegi Pro</span>
            <p>Ai nevoie de mini-magazin, mai multe pagini, traduceri RO/RU sau funcții custom.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Breadcrumbs -->
    <nav class="dev-breadcrumbs" aria-label="breadcrumb">
      <div class="container">
        <ol>
          <li><a href="/">Acasă</a></li>
          <li aria-hidden="true">/</li>
          <li><span aria-current="page">Prețuri</span></li>
        </ol>
      </div>
    </nav>

    <!-- Pricing Section -->
    <section class="dev-section dev-section-alt" id="preturi">
      <div class="container">
        <div class="dev-section-header">
          <span class="dev-section-tag">Pachete</span>
          <h2>Pachete pentru creare site web, pagină web și mini-magazin</h2>
          <p>Pentru afaceri mici, proiecte locale și lansări rapide cu structură clară.</p>
        </div>
        <div class="dev-pricing-grid">
          {
            packages.map((pkg) => (
              <article
                class={`dev-price-card ${pkg.featured ? "featured" : ""}`}
                id={pkg.id}
              >
                <span class="dev-card-title">{pkg.name}</span>
                <div class="dev-price">{pkg.price}</div>
                <p>{pkg.description}</p>
                <ul class="dev-price-features">
                  {pkg.features.map((f) => (
                    <li>{f}</li>
                  ))}
                </ul>
                <p class="dev-price-note">* {pkg.note}</p>
                <a href="/contact/" class="dev-btn dev-btn-primary">
                  Solicită ofertă
                </a>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Factors Section -->
    <section class="dev-section" id="preturi-explicate">
      <div class="container">
        <div class="dev-section-header">
          <span class="dev-section-tag">Informații</span>
          <h2>Ce influențează prețul unui site web?</h2>
          <p>Factorii principali care intră în calculul costului final al unei pagini web sau al unui site complet.</p>
        </div>
        <div class="dev-info-grid">
          {
            factors.map((f) => (
              <div class="dev-info-card">
                <span class="dev-card-title">{f.title}</span>
                <p>{f.description}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="dev-section dev-section-alt">
      <div class="container">
        <div class="dev-section-header">
          <span class="dev-section-tag">Tipuri de proiecte</span>
          <h2>Detalii pentru fiecare nevoie importantă</h2>
          <p>
            Vezi ce include un site la comandă, un site de prezentare, serviciul
            de creare site în Chișinău sau un proiect de web design în Moldova.
            Fiecare pagină explică limitele și pașii practici ai serviciului.
          </p>
        </div>
        <div class="dev-info-grid">
          {
            roLandingCards.map((page) => (
              <article class="dev-info-card">
                <span class="dev-card-title">{page.title}</span>
                <p>{page.description}</p>
                <a href={page.href} class="dev-link-accent">Detalii despre {page.title}</a>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Addons Section -->
    <section class="dev-section dev-section-alt" id="adaugiri">
      <div class="container">
        <div class="dev-section-header">
          <span class="dev-section-tag">Extra</span>
          <h2>Adăugiri opționale</h2>
          <p>Extinde pachetul ales, când ai nevoie</p>
        </div>
        <div class="dev-info-grid">
          {
            addons.map((a) => (
              <div class="dev-info-card">
                <span class="dev-card-title">{a.title}</span>
                <p>{a.description}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="dev-section" id="faq">
      <div class="container">
        <div class="dev-section-header">
          <span class="dev-section-tag">FAQ</span>
          <h2>Întrebări frecvente</h2>
          <p>Detalii practice despre pachetele de preț</p>
        </div>
        <div class="dev-faq-list">
          {
            faqs.map((faq) => (
              <details class="dev-faq-item">
                <summary>{faq.question}</summary>
                <p>{faq.answer}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="dev-cta" id="contact">
      <div class="container">
        <div class="dev-cta-content">
          <h2>Ai nevoie de un preț exact pentru site-ul tău?</h2>
          <p>
            Trimite-mi pe scurt obiectivele, tipul de site și numărul de pagini.
            După ce analizez cerințele îți propun o estimare realistă.
          </p>
          <a
            href="/contact/"
            class="dev-btn dev-btn-primary dev-btn-lg"
          >
            Descrie proiectul
          </a>
        </div>
      </div>
    </section>

    <Footer lang="ro" />
    <script src="/script.js" defer></script>
  </body>
</html>
