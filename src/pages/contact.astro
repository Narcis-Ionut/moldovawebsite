---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/dev-pages.css";
import { SITE_URL } from "../consts";

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ContactPage",
      name: "Contact",
      url: "https://chisinauweb.com/contact/",
      inLanguage: "ro-MD",
      about: {
        "@type": "Person",
        name: "Narcis",
        jobTitle: "Dezvoltator web independent",
        url: "https://chisinauweb.com/about/",
        worksFor: {
          "@type": "Organization",
          name: "ChisinauWeb.com",
          url: "https://chisinauweb.com/",
        },
      },
    },
  ],
};

const features = [
  {
    icon: "💬",
    title: "Comunicare directă",
    description:
      "Discuți direct cu mine, persoana care analizează și construiește proiectul. Nu există un account manager între cerința ta și implementare.",
  },
  {
    icon: "🧭",
    title: "Estimare după cerințe",
    description:
      "Îți explic ce merită construit, ce poate fi simplificat și de ce depind costul și termenul înainte să începem.",
  },
  {
    icon: "🔍",
    title: "Bază tehnică SEO",
    description:
      "Pentru site-urile publice configurez elementele tehnice de bază: structură semantică, metadate, sitemap, accesibilitate și performanță.",
  },
  {
    icon: "🔑",
    title: "Predare clară",
    description:
      "După verificare primești acces la domeniu, hosting și celelalte servicii care țin de proiectul tău. Mentenanța ulterioară se stabilește separat.",
  },
];

const process = [
  {
    number: "01",
    title: "Îmi explici proiectul",
    description:
      "Îmi explici ce face afacerea ta și ce trebuie să realizeze site-ul.",
  },
  {
    number: "02",
    title: "Analizez cerințele",
    description:
      "Analizez cerințele și îți spun direct ce merită construit, ce poate fi simplificat și care sunt limitele.",
  },
  {
    number: "03",
    title: "Construiesc și verific",
    description:
      "Construiesc proiectul, verific funcțiile și îți arăt progresul pe parcurs.",
  },
  {
    number: "04",
    title: "Publicăm și predau accesul",
    description:
      "După verificare, publicăm site-ul și primești acces la lucrurile care țin de proiectul tău.",
  },
];

const services = [
  {
    title: "Site de prezentare",
    description:
      "Un website clar pentru servicii, companie sau activitate independentă, cu paginile și formularele necesare publicului tău.",
  },
  {
    title: "Magazin online",
    description:
      "Catalog, coș, comenzi și plăți atunci când modelul afacerii le cere. Integrările exacte se aleg după modul real de lucru.",
  },
  {
    title: "Landing page",
    description:
      "O pagină concentrată pe o ofertă sau campanie, cu informație scurtă, acțiuni clare și măsurare configurată unde este necesar.",
  },
  {
    title: "Redesign site existent",
    description:
      "Refac structura, interfața sau partea tehnică a unui site existent după ce verific ce poate fi păstrat și ce trebuie schimbat.",
  },
];

const faqs = [
  {
    question: "Cât durează realizarea unui site?",
    answer:
      "Depinde de numărul de pagini, conținut, funcții și integrări. După ce văd cerințele pot propune un termen realist și pot explica ce îl poate influența.",
  },
  {
    question: "Ce informații trebuie să îți ofer?",
    answer:
      "Sunt utile descrierea afacerii, ce trebuie să facă site-ul, conținutul disponibil, logo-ul, imaginile și câteva exemple relevante. Putem stabili împreună ce lipsește.",
  },
  {
    question: "Lucrezi și în afara Chișinăului?",
    answer:
      "Da. Comunicarea și verificarea proiectului pot avea loc online, așa că pot lucra cu afaceri din toată Moldova și din alte țări.",
  },
  {
    question: "Pot plăti în rate?",
    answer:
      "Pentru proiectele standard și profesionale, termenii publicați prevăd de regulă două tranșe: 50% la început și 50% la predare. Condițiile exacte apar în oferta proiectului.",
  },
];

const contactMethods = [
  {
    icon: "📧",
    title: "Email",
    value: "contact@chisinauweb.com",
    link: "mailto:contact@chisinauweb.com",
    description: "Potrivit pentru brief și materiale",
  },
  {
    icon: "📱",
    title: "Telefon / WhatsApp",
    value: "+373 61 211 739",
    link: "tel:+37361211739",
    description: "Pentru o discuție scurtă",
  },
  {
    icon: "💬",
    title: "Formular online",
    value: "Completează formularul",
    link: "#formular",
    description: "Îmi oferă contextul necesar",
  },
];
---

<!doctype html>
<html lang="ro">
  <head>
    <BaseHead
      title="Contact Narcis | Creare site web în Moldova"
      description="Descrie proiectul tău de creare site web sau aplicație. Discuți direct cu Narcis, dezvoltator web independent în Chișinău."
      canonicalUrl="https://chisinauweb.com/contact/"
      hreflangRo="https://chisinauweb.com/contact/"
      hreflangRu="https://chisinauweb.com/ru/contact/"
      image="/assets/og-image-contact.webp"
      jsonLd={jsonLd}
    />
    <!-- Cloudflare Turnstile -->
    <script src="https://challenges.cloudflare.com/turnstile/v0/g/8fc8ed1d8752/api.js" defer
    ></script>
    
  </head>
  <body>
    <div class="dev-grid-pattern"></div>
    <Header lang="ro" />

    <!-- Hero Section -->
    <section class="dev-hero">
      <div class="container">
        <div class="dev-hero-content">
          <span class="dev-section-tag">Contact</span>
          <h1>Spune-mi ce încerci să construiești</h1>
          <p>
            Nu trebuie să pregătești un document tehnic. Explică-mi afacerea,
            problema și ce ai vrea să poată face site-ul.
          </p>
        </div>
        <div class="dev-hero-intro">
          <p>
            Construiesc site-uri și aplicații web pentru afaceri și proiecte
            din Chișinău, din restul Moldovei sau de oriunde putem comunica
            online. Fie că ai nevoie de un
            <strong>site de prezentare simplu</strong>, un <strong
              >magazin online</strong
            > sau de un produs web mai complex, îți spun direct ce presupune și
            ce ar trebui făcut mai întâi.
          </p>
          <p>
            Completează formularul, sună-mă sau trimite-mi un email. Cu cât
            descrii mai clar problema și rezultatul dorit, cu atât pot evalua
            mai util varianta realistă.
          </p>
        </div>
      </div>
    </section>

    <!-- Contact Methods Section -->
    <section class="dev-section dev-section-alt">
      <div class="container">
        <div class="dev-section-header">
          <span class="dev-section-tag">Cum mă contactezi</span>
          <h2>Alege metoda preferată</h2>
          <p>Alege canalul care îți este mai comod</p>
        </div>
        <div class="dev-contact-methods">
          {
            contactMethods.map((method) => (
              <div class="dev-contact-method">
                <div class="icon">{method.icon}</div>
                <h3>{method.title}</h3>
                <a href={method.link}>{method.value}</a>
                <p>{method.description}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Contact Form Section -->
    <section class="dev-section" id="formular">
      <div class="container">
        <div class="dev-contact-grid">
          <form
            class="dev-form"
            id="contactForm"
            method="post"
            action="/api/contact"
            novalidate
          >
            <input type="hidden" name="lang" value="ro" />
            <div class="dev-form-field">
              <label for="name">Nume și prenume *</label>
              <input
                type="text"
                id="name"
                name="name"
                maxlength="120"
                placeholder="Numele tău"
                required
              />
            </div>

            <div class="dev-form-field">
              <label for="email">Email *</label>
              <input
                type="email"
                id="email"
                name="email"
                maxlength="254"
                placeholder="nume@domeniu.md"
                required
              />
              <div class="dev-form-help">Te vom contacta pe această adresă</div>
            </div>

            <div class="dev-form-field">
              <label for="phone">Telefon (opțional)</label>
              <input
                type="tel"
                id="phone"
                name="phone"
                maxlength="60"
                placeholder="+373 6xx xxx xx"
                inputmode="tel"
              />
            </div>

            <div class="dev-form-field">
              <label for="subject">Subiect *</label>
              <input
                type="text"
                id="subject"
                name="subject"
                maxlength="180"
                placeholder="Site de prezentare pentru cafenea în Chișinău"
                required
              />
            </div>

            <div class="dev-form-field">
              <label>Tip proiect</label>
              <div
                class="dev-chip-group"
                role="radiogroup"
                aria-label="Tip proiect"
              >
                <button
                  type="button"
                  class="dev-chip active"
                  data-value="Site de prezentare">Site de prezentare</button
                >
                <button
                  type="button"
                  class="dev-chip"
                  data-value="Magazin online">Magazin online</button
                >
                <button type="button" class="dev-chip" data-value="Landing page"
                  >Landing page</button
                >
                <button type="button" class="dev-chip" data-value="Redesign"
                  >Redesign</button
                >
                <button type="button" class="dev-chip" data-value="Altceva"
                  >Altceva</button
                >
              </div>
              <input
                type="hidden"
                name="project_type"
                id="project_type"
                value="Site de prezentare"
              />
            </div>

            <div class="dev-form-field">
              <label>Buget estimativ (EUR)</label>
              <div class="dev-range-wrap">
                <input
                  type="range"
                  class="dev-range"
                  id="budget"
                  name="budget"
                  min="50"
                  max="2000"
                  step="50"
                  value="300"
                />
                <span class="dev-range-badge" id="budgetBadge">€300</span>
              </div>
            </div>

            <div class="dev-form-field">
              <label for="message">Mesaj *</label>
              <textarea
                id="message"
                name="message"
                maxlength="6000"
                placeholder="Detalii despre proiectul tău..."
                required></textarea>
              <div class="dev-form-help">
                Detalii utile: pagini, funcții, exemple, termene
              </div>
            </div>

            <div class="dev-form-field">
              <label class="dev-checkbox">
                <input type="checkbox" name="consent" id="consent" required />
                <span
                  >Sunt de acord cu prelucrarea datelor conform politicii GDPR
                  și doresc să fiu contactat.</span
                >
              </label>
            </div>

            <div class="dev-form-field">
              <div
                class="cf-turnstile"
                data-sitekey="0x4AAAAAAB0f_L28X_bHlrIA"
                data-theme="dark"
              >
              </div>
            </div>

            <button type="submit" class="dev-submit">Trimite mesajul</button>
            <span
              class="dev-form-help dev-form-status"
              id="formStatus"
              role="status"
              aria-live="polite"
            ></span>
          </form>

          <aside class="dev-info-card">
            <h3>Date de contact</h3>
            <ul class="dev-info-list">
              <li>
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"></path>
                  <path
                    d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"
                  ></path>
                </svg>
                <span>Chișinău, Moldova</span>
              </li>
              <li>
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path
                    d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"
                  ></path>
                </svg>
                <a href="tel:+37361211739">+373 61 211 739</a>
              </li>
              <li>
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path
                    d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"
                  ></path>
                </svg>
                <a href="mailto:contact@chisinauweb.com"
                  >contact@chisinauweb.com</a
                >
              </li>
              <li>
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <circle cx="12" cy="12" r="10"></circle>
                  <path d="M12 6v6l4 2"></path>
                </svg>
                <span>L–V 09:00–18:00</span>
              </li>
            </ul>

            <div class="dev-info-divider"></div>
            <p>Preferi WhatsApp? Scrie-mi direct și descrie pe scurt proiectul.</p>
            <a
              href="https://api.whatsapp.com/send?phone=37361211739"
              target="_blank"
              rel="noopener noreferrer"
              class="dev-btn-secondary"
            >
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path
                  d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
                ></path>
              </svg>
              Deschide WhatsApp
            </a>
          </aside>
        </div>
      </div>
    </section>

    <!-- Features Section -->
    <section class="dev-section dev-section-alt">
      <div class="container">
        <div class="dev-section-header">
          <span class="dev-section-tag">Lucru direct</span>
          <h2>Avantajele tale</h2>
          <p>Ce poți aștepta când lucrezi direct cu mine</p>
        </div>
        <div class="dev-features-grid">
          {
            features.map((f) => (
              <div class="dev-feature-card">
                <div class="dev-feature-icon">{f.icon}</div>
                <h3>{f.title}</h3>
                <p>{f.description}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Process Section -->
    <section class="dev-section">
      <div class="container">
        <div class="dev-section-header">
          <span class="dev-section-tag">Proces</span>
          <h2>Cum lucrăm împreună</h2>
          <p>Patru pași de la contextul inițial la predarea proiectului</p>
        </div>
        <div class="dev-process-grid">
          {
            process.map((p) => (
              <div class="dev-process-step">
                <div class="dev-process-num">{p.number}</div>
                <h3>{p.title}</h3>
                <p>{p.description}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Services Section -->
    <section class="dev-section dev-section-alt">
      <div class="container">
        <div class="dev-section-header">
          <span class="dev-section-tag">Servicii</span>
          <h2>Ce pot construi?</h2>
          <p>Servicii web adaptate problemei și conținutului disponibil</p>
        </div>
        <div class="dev-services-list">
          {
            services.map((s) => (
              <div class="dev-service-item">
                <h3>{s.title}</h3>
                <p>{s.description}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="dev-section">
      <div class="container">
        <div class="dev-section-header">
          <span class="dev-section-tag">FAQ</span>
          <h2>Întrebări frecvente</h2>
          <p>Răspunsuri la cele mai comune întrebări</p>
        </div>
        <div class="dev-faq-list">
          {
            faqs.map((faq) => (
              <details class="dev-faq-item">
                <summary>{faq.question}</summary>
                <p>{faq.answer}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <Footer lang="ro" />
    <script src="/script.js" defer></script>
  </body>
</html>
