---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import "../../styles/dev-ru-blog-services.css";
import FormattedDate from "../../components/FormattedDate.astro";
import { blogPosts } from "../../data/blogPosts";

const posts = [...blogPosts].sort(
  (a, b) => b.pubDate.valueOf() - a.pubDate.valueOf(),
);

const pageTitle = "Blog creare site web ieftin în Moldova | Ghiduri și prețuri";
const pageDescription =
  "Articole despre creare site web ieftin în Moldova, web design accesibil, SEO on-page și prețuri pentru site de prezentare sau magazin online.";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: pageTitle,
  description: pageDescription,
  url: "https://chisinauweb.com/blog/",
  inLanguage: "ro-MD",
  publisher: {
    "@type": "Organization",
    name: "ChisinauWeb.com",
    url: "https://chisinauweb.com/",
  },
  author: {
    "@type": "Person",
    name: "Narcis",
    url: "https://chisinauweb.com/about/",
    jobTitle: "Dezvoltator web independent",
  },
};
---

<!doctype html>
<html lang="ro">
  <head>
    <BaseHead
      title={pageTitle}
      description={pageDescription}
      canonicalUrl="https://chisinauweb.com/blog/"
      hreflangRo="https://chisinauweb.com/blog/"
      hreflangRu="https://chisinauweb.com/ru/blog/"
      image="/assets/og-image.webp"
      jsonLd={jsonLd}
    />
  </head>
  <body class="dev-ru-theme">
    <Header lang="ro" />

    <!-- Hero Section -->
    <section class="hero" id="acasa">
      <div class="container grid">
        <div class="hero-content">
          <h1>Blog: creare site web ieftin în Moldova</h1>
          <p class="subheading">
            Ghiduri practice despre web design accesibil în Chișinău și toată
            Moldova: site de prezentare, magazin online, SEO on-page și
            mentenanță.
          </p>
          <p class="subheading">
            Dacă vrei creare site web ieftin în Moldova, aici găsești
            explicații simple despre prețuri, tehnologii și pașii corecți.
          </p>
          <div class="hero-actions">
            <a href="/preturi/" class="btn btn-primary">Vezi prețuri</a>
            <a href="/contact/" class="btn btn-secondary">Cere ofertă</a>
          </div>
          <ul class="hero-bullets">
            <li>Articole clare, fără termeni complicați</li>
            <li>Exemple locale și recomandări practice</li>
            <li>Limite și costuri explicate direct</li>
          </ul>
          <p class="subheading">
            Dacă ai întrebări despre costuri, scrie-mi și îți explic ce se
            potrivește proiectului, fără jargon inutil.
          </p>
        </div>

        <div class="hero-image" aria-hidden="true">
          <div class="hero-bg-shape"></div>
          <div class="hero-device">
            <svg
              viewBox="0 0 500 300"
              xmlns="http://www.w3.org/2000/svg"
              role="img"
              aria-label="Ilustrație blog web design"
            >
              <defs>
                <linearGradient
                  id="gradient"
                  x1="0%"
                  y1="0%"
                  x2="100%"
                  y2="100%"
                >
                  <stop offset="0%" stop-color="#0A2463"></stop>
                  <stop offset="100%" stop-color="#63B3ED"></stop>
                </linearGradient>
                <clipPath id="screenClip">
                  <rect x="50" y="30" width="400" height="240" rx="10"></rect>
                </clipPath>
              </defs>
              <rect
                x="50"
                y="30"
                width="400"
                height="240"
                rx="10"
                fill="url(#gradient)"></rect>
              <image
                x="50"
                y="30"
                width="400"
                height="240"
                href="/assets/hero-screen.webp"
                preserveAspectRatio="xMidYMid slice"
                clip-path="url(#screenClip)"
              />
              <rect
                x="50"
                y="30"
                width="400"
                height="240"
                rx="10"
                fill="#000"
                opacity="0.12"
                clip-path="url(#screenClip)"></rect>
              <circle cx="250" cy="150" r="40" fill="white" opacity="0.8"
              ></circle>
              <rect
                x="150"
                y="145"
                height="10"
                width="200"
                fill="white"
                opacity="0.6"></rect>
              <rect
                x="180"
                y="167"
                height="6"
                width="140"
                fill="white"
                opacity="0.4"></rect>
            </svg>
          </div>
        </div>
      </div>
    </section>

    <!-- How to use the blog -->
    <section class="process">
      <div class="container">
        <div class="section-title">
          <h2>Cum folosești articolele din blog</h2>
          <p>
            Dacă ești la început și cauți <strong
              >creare site web ieftin în Moldova</strong
            >, parcurge pașii de mai jos pentru a-ți clarifica rapid bugetul și
            direcția.
          </p>
        </div>

        <div class="process-steps">
          <div class="step">
            <div class="step-number">1</div>
            <h3 class="step-title">Stabilește tipul de site</h3>
            <p class="step-desc">
              Alege între site de prezentare, landing page sau magazin online,
              în funcție de obiectivele tale.
            </p>
          </div>

          <div class="step">
            <div class="step-number">2</div>
            <h3 class="step-title">Înțelege prețurile</h3>
            <p class="step-desc">
              Articolele despre costuri explică ce include fiecare pachet și cum
              se schimbă estimarea când apar pagini, conținut sau funcții noi.
            </p>
          </div>

          <div class="step">
            <div class="step-number">3</div>
            <h3 class="step-title">Optimizează pentru Google</h3>
            <p class="step-desc">
              Urmează recomandările de SEO on-page pentru structură, viteză și
              conținut relevant în căutări locale.
            </p>
          </div>

          <div class="step">
            <div class="step-number">4</div>
            <h3 class="step-title">Aplică și cere ofertă</h3>
            <p class="step-desc">
              După ce ai claritate, scrie-mi pentru o estimare legată de
              cerințele și materialele proiectului tău.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- What you'll find -->
    <section class="services" id="despre-blog">
      <div class="container grid">
        <div class="section-title">
          <h2>Ce găsești în blog</h2>
          <p>
            Public articole despre <strong>creare site web</strong>,
            <strong>prețuri</strong>, optimizare SEO și soluții potrivite pentru
            afaceri mici din Moldova.
          </p>
          <p>
            Scopul meu este să explic clar ce contează când alegi un
            furnizor de <strong>web design accesibil</strong> și cum îți optimizezi
            bugetul.
          </p>
          <p>
            Indiferent dacă ești la început sau vrei să îmbunătățești un site
            existent, găsești pași practici, exemple locale și recomandări
            concrete. Astfel, iei decizii rapide și eviți costurile inutile.
          </p>
        </div>

        <div class="service-card">
          <div class="service-icon">01</div>
          <h3 class="service-title">Prețuri reale</h3>
          <p class="service-desc">
            Prezint pachetele publicate, ce includ și ce trebuie estimat
            separat.
          </p>
        </div>

        <div class="service-card">
          <div class="service-icon">02</div>
          <h3 class="service-title">SEO on-page</h3>
          <p class="service-desc">
            Sfaturi pentru structură, conținut, indexare și performanță, fără
            promisiuni despre o anumită poziție în Google.
          </p>
        </div>

        <div class="service-card">
          <div class="service-icon">03</div>
          <h3 class="service-title">Site de prezentare</h3>
          <p class="service-desc">
            Ghiduri pentru pagini ușor de folosit, care comunică clar serviciile
            tale.
          </p>
        </div>

        <div class="service-card">
          <div class="service-icon">04</div>
          <h3 class="service-title">Magazin online</h3>
          <p class="service-desc">
            Recomandări despre produse, plăți și experiența de cumpărare.
          </p>
        </div>
      </div>
    </section>

    <!-- Articles -->
    <section class="portfolio" id="articole">
      <div class="container">
        <div class="section-title">
          <h2>Articole recente despre creare site web</h2>
          <p>
            Citește ghiduri despre costuri, proces și optimizare tehnică.
          </p>
          <p>
            Fiecare articol afișează data publicării, iar ghidurile revizuite
            păstrează și data ultimei actualizări.
          </p>
        </div>

        <div class="portfolio-grid">
          {
            posts.map((post) => (
              <article class="portfolio-card">
                <div class="portfolio-image">
                  <img
                    src={post.heroImage}
                    alt={post.title}
                    loading="lazy"
                    width="400"
                    height="250"
                  />
                  <div class="portfolio-overlay">
                    <span class="portfolio-category">Articol</span>
                  </div>
                </div>
                <div class="portfolio-content">
                  <h3>{post.title}</h3>
                  <p>{post.description}</p>
                  <p class="date">
                    <FormattedDate date={post.pubDate} />
                  </p>
                  <ul class="portfolio-features">
                    <li>✓ Web design accesibil</li>
                    <li>✓ SEO on-page</li>
                    <li>✓ Prețuri transparente</li>
                  </ul>
                  <a href={`/blog/${post.slug}/`} class="portfolio-link">
                    Citește: {post.title} →
                  </a>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="faq">
      <div class="container">
        <div class="section-title">
          <h2>Întrebări frecvente despre blog</h2>
          <p>Răspunsuri rapide înainte să începi documentarea.</p>
        </div>

        <div class="faq-list">
          <details>
            <summary>Publici ghiduri despre prețuri?</summary>
            <p>
              Da. Vei găsi articole despre cât costă un site în Moldova și ce
              include fiecare pachet.
            </p>
          </details>

          <details>
            <summary>Găsesc sfaturi pentru SEO on-page?</summary>
            <p>
              Da. Explic structura paginilor, viteza, meta-tagurile și alte
              elemente tehnice care ajută indexarea.
            </p>
          </details>

          <details>
            <summary>Pot solicita o ofertă după ce citesc?</summary>
            <p>
              Sigur. Dacă un articol te ajută să-ți clarifici nevoile, îmi poți
              descrie proiectul pentru o estimare.
            </p>
          </details>

          <details>
            <summary>Abordezi și mentenanța site-ului?</summary>
            <p>
              Da. Explic ce poate include mentenanța, costul de pornire și ce
              trebuie stabilit separat.
            </p>
          </details>
        </div>
      </div>
    </section>

    <!-- Final CTA -->
    <section class="cta-section">
      <div class="container grid">
        <div class="cta-container">
          <h2>Ai nevoie de un site web accesibil?</h2>
          <p class="subheading">
            Spune-mi ce trebuie să facă site-ul și ce materiale ai deja. Îți
            explic varianta realistă pentru bugetul tău.
          </p>
          <p class="subheading">Putem comunica în română sau rusă.</p>
          <a href="/contact/" class="btn btn-primary">Descrie proiectul</a>
        </div>
      </div>
    </section>

    <Footer lang="ro" />

    <script src="/script.js" defer></script>
  </body>
</html>
