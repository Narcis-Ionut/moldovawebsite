---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { roLandingCards } from "../data/landingPages.ro";
import { portfolioRo } from "../data/portfolio";

const faqs = [
  {
    question: "Cât costă crearea unui site web în Moldova?",
    answer:
      "Un landing page pornește de la 50 EUR, un site de prezentare de la 150 EUR, iar un mini-magazin online de la 300 EUR. Oferta finală depinde de structură, conținut și funcționalități.",
  },
  {
    question: "Lucrezi în Chișinău și în toată Moldova?",
    answer:
      "Da. Sunt dezvoltator web independent în Chișinău și pot colabora online cu afaceri din toată Moldova sau din alte piețe.",
  },
  {
    question: "Site-ul include optimizare pentru mobil și Google?",
    answer:
      "Includ design responsive și elementele tehnice SEO de bază: structură semantică, meta-taguri, canonical și performanță verificată. Acestea nu garantează o anumită poziție în Google.",
  },
  {
    question: "Construiești și magazine online sau aplicații web?",
    answer:
      "Da. Pot construi cataloage, fluxuri de comandă, conturi, plăți, baze de date și alte funcții atunci când sunt definite și verificate în proiect.",
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://chisinauweb.com/#website",
      name: "ChisinauWeb.com",
      url: "https://chisinauweb.com/",
      inLanguage: "ro-MD",
      publisher: { "@id": "https://chisinauweb.com/#business" },
    },
    {
      "@type": "Person",
      "@id": "https://chisinauweb.com/about/#narcis",
      name: "Narcis",
      jobTitle: "Dezvoltator web independent",
      description:
        "Dezvoltator web independent în Chișinău, operatorul ChisinauWeb.com.",
      url: "https://chisinauweb.com/about/",
      email: "contact@chisinauweb.com",
      telephone: "+37361211739",
      worksFor: { "@id": "https://chisinauweb.com/#business" },
    },
    {
      "@type": "ProfessionalService",
      "@id": "https://chisinauweb.com/#business",
      name: "ChisinauWeb.com",
      description:
        "Serviciu de dezvoltare web operat de Narcis, dezvoltator web independent în Chișinău: site la comandă, site de prezentare, magazin online, web design, SEO on-page și mentenanță.",
      areaServed: [
        { "@type": "City", name: "Chișinău" },
        { "@type": "Country", name: "Moldova" },
      ],
      url: "https://chisinauweb.com/",
      email: "contact@chisinauweb.com",
      telephone: "+37361211739",
      founder: { "@id": "https://chisinauweb.com/about/#narcis" },
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.question,
        acceptedAnswer: { "@type": "Answer", text: faq.answer },
      })),
    },
  ],
};

const linkedServices = [
  {
    icon: "D",
    title: "Web design Moldova",
    description:
      "Structură vizuală, UX și interfețe responsive pentru site-uri și produse web.",
    href: "/serviciiBlog/design-web/",
  },
  {
    icon: "W",
    title: "Dezvoltare web",
    description:
      "Site-uri și aplicații construite cu tehnologii potrivite funcțiilor reale ale proiectului.",
    href: "/serviciiBlog/dezvoltare-web/",
  },
  {
    icon: "S",
    title: "SEO on-page Moldova",
    description:
      "Meta-taguri, structură, date tehnice și conținut organizat pentru indexare și utilizare clară.",
    href: "/serviciiBlog/seo-on-page/",
  },
  {
    icon: "M",
    title: "Creare magazin online Moldova",
    description:
      "Catalog, comandă, plăți și livrare stabilite după produsele și procesul afacerii.",
    href: "/serviciiBlog/magazin-online/",
  },
  {
    icon: "Î",
    title: "Mentenanță website",
    description:
      "Evaluare, actualizări și intervenții tehnice cu un scop agreat, fără promisiuni de suport nelimitat.",
    href: "/serviciiBlog/mentenanta/",
  },
];

const collaborationSteps = [
  {
    number: "01",
    title: "Înțeleg afacerea și obiectivul",
    description:
      "Îmi explici ce face afacerea ta și ce trebuie să realizeze site-ul.",
  },
  {
    number: "02",
    title: "Clarific soluția și limitele",
    description:
      "Analizez cerințele și îți spun direct ce merită construit, ce poate fi simplificat și care sunt limitele.",
  },
  {
    number: "03",
    title: "Construiesc și verific",
    description:
      "Construiesc proiectul, verific funcțiile și îți arăt progresul pe parcurs.",
  },
  {
    number: "04",
    title: "Publicăm și predau accesul",
    description:
      "După verificare, publicăm site-ul și primești acces la lucrurile care țin de proiectul tău.",
  },
];
---

<!doctype html>
<html lang="ro">
  <head>
    <BaseHead
      title="Creare website Moldova | Site web de la 50 EUR"
      description="Creare site web în Moldova direct cu un dezvoltator independent din Chișinău: site de prezentare, magazin online, aplicații web și SEO on-page."
      canonicalUrl="https://chisinauweb.com/"
      hreflangRo="https://chisinauweb.com/"
      hreflangRu="https://chisinauweb.com/ru/"
      jsonLd={jsonLd}
    />
  </head>
  <body>
    <Header lang="ro" />

    <section class="nf-hero" id="acasa">
      <div class="container">
        <div class="nf-hero-grid">
          <div class="nf-hero-content">
            <div class="nf-hero-badge">Dezvoltator web independent în Chișinău</div>
            <h1>
              Creare site web în Moldova și
              <span class="trust-accent">site la comandă</span>
              pentru afaceri reale
            </h1>
            <p class="nf-hero-subtitle">
              Sunt Narcis. Construiesc site-uri de prezentare, magazine online
              și aplicații web pentru proiecte care au nevoie de structură
              clară, funcții utile și o experiență bună pe telefon și desktop.
              Lucrezi direct cu dezvoltatorul care analizează, construiește și
              verifică proiectul.
            </p>
            <p>
              Dezvoltare web modernă, inclusiv instrumente AI folosite
              transparent și verificate înainte de publicare.
            </p>
            <div class="nf-hero-actions">
              <a href="/contact/" class="nf-btn nf-btn-primary nf-btn-lg">
                Descrie proiectul
              </a>
              <a href="/preturi/" class="nf-btn nf-btn-ghost nf-btn-lg">
                Preț creare site în Moldova
              </a>
              <a href="#portofoliu" class="nf-btn nf-btn-ghost nf-btn-lg">
                Vezi proiectele
              </a>
            </div>
            <div class="nf-hero-stats">
              <div class="nf-stat">
                <div class="nf-stat-value">Independent</div>
                <div class="nf-stat-label">dezvoltator în Chișinău</div>
              </div>
              <div class="nf-stat">
                <div class="nf-stat-value">Direct</div>
                <div class="nf-stat-label">fără account manager</div>
              </div>
              <div class="nf-stat">
                <div class="nf-stat-value">RO + RU</div>
                <div class="nf-stat-label">comunicare locală</div>
              </div>
            </div>
          </div>

          <aside class="nf-proof-panel" aria-label="Exemplu de pachet pentru un proiect web">
            <div class="nf-proof-top">
              <span class="nf-proof-status">Punct de pornire</span>
              <span>Chișinău · Moldova</span>
            </div>
            <div class="nf-proof-card">
              <span class="nf-proof-label">Site de prezentare</span>
              <h2>Pentru servicii și afaceri locale</h2>
              <div class="nf-proof-price">de la 150 EUR</div>
              <ul class="nf-proof-list">
                <li>Structură adaptată afacerii</li>
                <li>Design responsive</li>
                <li>Formular și contact direct</li>
                <li>SEO tehnic de bază</li>
                <li>Publicare și acces la proiect</li>
              </ul>
            </div>
            <div class="nf-proof-bottom">
              <div class="nf-proof-metric">
                <strong>Preț explicat</strong>
                <span>după cerințele reale</span>
              </div>
              <div class="nf-proof-metric">
                <strong>Proces direct</strong>
                <span>brief → lucru → verificare</span>
              </div>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <section class="nf-section nf-section-alt" id="servicii">
      <div class="container">
        <div class="nf-section-header">
          <span class="nf-section-tag">Servicii</span>
          <h2>Site-uri și aplicații web construite pentru utilizare reală</h2>
          <p>
            Aleg structura și tehnologia după ceea ce trebuie să facă proiectul,
            nu după o listă de efecte sau promisiuni generale.
          </p>
        </div>
        <div class="nf-services-grid">
          {
            linkedServices.map((service) => (
              <article class="nf-service-card">
                <div class="nf-service-icon">{service.icon}</div>
                <span class="nf-card-title">{service.title}</span>
                <p>{service.description}</p>
                <a href={service.href} class="nf-portfolio-link">
                  Vezi {service.title}
                </a>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="nf-section" id="tipuri-site">
      <div class="container">
        <div class="nf-section-header">
          <span class="nf-section-tag">Alege formatul</span>
          <h2>Ce fel de website se potrivește proiectului tău</h2>
          <p>
            Poți porni de la o pagină simplă, un site de prezentare sau o
            soluție la comandă. Fiecare pagină explică livrabilele și limitele
            practice.
          </p>
        </div>
        <div class="nf-services-grid">
          {
            roLandingCards.map((page, index) => (
              <article class="nf-service-card">
                <div class="nf-service-icon">{String(index + 1).padStart(2, "0")}</div>
                <span class="nf-card-title">{page.title}</span>
                <p>{page.description}</p>
                <a href={page.href} class="nf-portfolio-link">Vezi {page.title}</a>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="nf-section" id="portofoliu">
      <div class="container">
        <div class="nf-section-header">
          <span class="nf-section-tag">Portofoliu</span>
          <h2>Proiecte reale, fără rezultate inventate</h2>
          <p>
            Produse și website-uri care există și pot fi deschise direct.
            Descrierile de mai jos se limitează la funcțiile implementate.
          </p>
        </div>
        <div class="nf-portfolio-grid">
          {
            portfolioRo.map((item) => (
              <article class="nf-card">
                <div class="nf-card-image">
                  <img
                    src={item.image}
                    alt={item.imageAlt}
                    loading="lazy"
                    width="400"
                    height="220"
                  />
                  <div class="nf-card-overlay">
                    <span class="nf-card-category">{item.category}</span>
                  </div>
                </div>
                <div class="nf-card-content">
                  <span class="nf-card-title">{item.title}</span>
                  <p>{item.description}</p>
                  <ul class="nf-portfolio-features">
                    {item.features.map((feature) => <li>{feature}</li>)}
                  </ul>
                  <a
                    href={item.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="nf-portfolio-link"
                  >
                    Vizitează {item.title}
                  </a>
                </div>
              </article>
            ))
          }
        </div>
        <div class="nf-center-cta">
          <a href="/contact/" class="nf-btn nf-btn-primary nf-btn-lg">
            Descrie proiectul
          </a>
        </div>
      </div>
    </section>

    <section class="nf-section nf-section-alt" id="proces">
      <div class="container">
        <div class="nf-section-header">
          <span class="nf-section-tag">Proces</span>
          <h2>Cum lucrăm împreună</h2>
          <p>
            Patru pași simpli, cu discuție directă și limite explicate înainte
            de publicare.
          </p>
        </div>
        <div class="nf-process-grid">
          {
            collaborationSteps.map((step) => (
              <article class="nf-process-step">
                <div class="nf-process-number">{step.number}</div>
                <span class="nf-card-title">{step.title}</span>
                <p>{step.description}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="nf-section" id="preturi">
      <div class="container">
        <div class="nf-section-header">
          <span class="nf-section-tag">Prețuri</span>
          <h2>Prețuri de pornire pentru creare site web</h2>
          <p>
            Prețul final depinde de conținut, funcții, limbi și integrări. Nu
            adaug funcții care nu ajută proiectul doar pentru a mări pachetul.
          </p>
        </div>
        <div class="nf-pricing-grid">
          <div class="nf-pricing-card">
            <span class="nf-card-title">Site de prezentare · de la 150 EUR</span>
            <p>Pentru servicii, companii și profesioniști care au nevoie de o prezență clară.</p>
            <ul class="nf-pricing-features">
              <li>Structură cu paginile necesare</li>
              <li>Design responsive</li>
              <li>Formular și date de contact</li>
              <li>SEO on-page de bază</li>
              <li>Publicare și acces</li>
            </ul>
            <a href="/site-de-prezentare/" class="nf-btn nf-btn-outline nf-btn-block">
              Vezi site de prezentare
            </a>
          </div>
          <div class="nf-pricing-card nf-pricing-featured">
            <span class="nf-card-title">Mini-magazin online · de la 300 EUR</span>
            <p>Pentru un catalog mic și un flux de comandă definit clar.</p>
            <ul class="nf-pricing-features">
              <li>Catalog și pagini de produs</li>
              <li>Coș sau formular de comandă</li>
              <li>Plăți și livrare stabilite în brief</li>
              <li>Interfață pentru mobil</li>
              <li>Testarea fluxului de comandă</li>
            </ul>
            <a href="/serviciiBlog/magazin-online/" class="nf-btn nf-btn-primary nf-btn-block">
              Vezi magazin online
            </a>
          </div>
          <div class="nf-pricing-card">
            <span class="nf-card-title">SEO și mentenanță</span>
            <p>SEO on-page de la 50 EUR; mentenanță de la 25 EUR/lună.</p>
            <ul class="nf-pricing-features">
              <li>Audit și priorități tehnice</li>
              <li>Meta-taguri și structură</li>
              <li>Corecții de performanță agreate</li>
              <li>Mentenanță ofertată după evaluare</li>
              <li>Fără garanții de poziționare</li>
            </ul>
            <a href="/preturi/" class="nf-btn nf-btn-outline nf-btn-block">
              Vezi toate prețurile
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="nf-section nf-section-alt" id="faq">
      <div class="container">
        <div class="nf-section-header">
          <span class="nf-section-tag">FAQ</span>
          <h2>Întrebări frecvente</h2>
          <p>Răspunsuri directe despre preț, proces și limite.</p>
        </div>
        <div class="nf-faq-list">
          {
            faqs.map((faq) => (
              <details class="nf-faq-item">
                <summary>{faq.question}</summary>
                <p>{faq.answer}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <section class="cta-section">
      <div class="container">
        <div class="cta-content">
          <h2>Spune-mi ce încerci să construiești</h2>
          <p>
            Nu trebuie să pregătești un document tehnic. Explică afacerea,
            problema și ce ai vrea să poată face site-ul.
          </p>
          <a href="/contact/" class="nf-btn nf-btn-primary nf-btn-xl">
            Descrie proiectul
          </a>
        </div>
      </div>
    </section>

    <Footer lang="ro" />
    <script src="/script.js" defer></script>
  </body>
</html>
