---
import BaseHead from "./BaseHead.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import "../styles/dev-pages.css";
import type { LandingPageData } from "../data/landingPages.types";
import { CONTACT_EMAIL, CONTACT_PHONE, SITE_URL } from "../consts";

interface Props {
  lang: "ro" | "ru";
  page: LandingPageData;
}

const { lang, page } = Astro.props;

const ui =
  lang === "ro"
    ? {
        homeLabel: "Acasă",
        painTag: "Obiectiv",
        painTitle: "Ce trebuie să rezolve website-ul",
        painIntro:
          "Pornim de la problemele reale ale afacerii și construim un traseu clar spre contact, programare sau comandă.",
        deliverTag: "Inclus",
        deliverTitle: "Ce primești în proiect",
        deliverIntro:
          "Structura, designul și partea tehnică sunt livrate ca un singur proiect coerent, gata de lansare.",
        processTag: "Proces",
        processTitle: "Cum lansăm proiectul",
        processIntro:
          "Păstrăm procesul simplu: clarificăm, construim, verificăm și lansăm.",
        packagesTag: "Pachete",
        packagesTitle: "Alege punctul potrivit de pornire",
        packagesIntro:
          "Prețuri orientative, cu scop și livrabile clare înainte să înceapă lucrul.",
        proofTag: "Portofoliu",
        proofTitle: "Proiecte construite pentru afaceri reale",
        proofIntro:
          "Exemple de site-uri și aplicații livrate pentru proiecte locale și internaționale.",
        faqTag: "FAQ",
        faqTitle: "Întrebări frecvente",
        faqIntro:
          "Răspunsuri directe despre cost, proces, funcționalități și lansare.",
        relatedTag: "Legături utile",
        relatedTitle: "Servicii și pagini utile",
        relatedIntro:
          "Compară pachetele, vezi serviciile conexe sau trimite direct brief-ul proiectului.",
        ctaTitle: "Spune-ne ce vrei să construiești",
        ctaIntro:
          "Primești o recomandare clară pentru structură, termen și buget, fără obligații.",
        visitProject: "Vezi proiectul",
        scopeEyebrow: "Planul proiectului",
        scopeCount: "obiective prioritare",
        scopeFooter: "Fiecare obiectiv este legat de un rezultat măsurabil pentru afacere.",
      }
    : {
        homeLabel: "Главная",
        painTag: "Задача",
        painTitle: "Какие задачи должен решить сайт",
        painIntro:
          "Отталкиваемся от реальных задач бизнеса и строим понятный путь к заявке, записи или заказу.",
        deliverTag: "Результат",
        deliverTitle: "Что входит в проект",
        deliverIntro:
          "Структура, дизайн и техническая часть работают как единый проект, готовый к запуску.",
        processTag: "Процесс",
        processTitle: "Как мы запускаем проект",
        processIntro:
          "Процесс остается простым: уточняем задачу, создаем, проверяем и запускаем.",
        packagesTag: "Пакеты",
        packagesTitle: "Выберите подходящий старт",
        packagesIntro:
          "Ориентиры по цене с понятным объемом работ до начала проекта.",
        proofTag: "Портфолио",
        proofTitle: "Проекты для реального бизнеса",
        proofIntro:
          "Примеры сайтов и приложений, созданных для локальных и международных проектов.",
        faqTag: "FAQ",
        faqTitle: "Частые вопросы",
        faqIntro:
          "Прямые ответы о цене, процессе, функциях и запуске.",
        relatedTag: "Полезные переходы",
        relatedTitle: "Услуги и полезные страницы",
        relatedIntro:
          "Сравните пакеты, посмотрите связанные услуги или сразу отправьте бриф.",
        ctaTitle: "Расскажите, что хотите создать",
        ctaIntro:
          "Вы получите понятную рекомендацию по структуре, срокам и бюджету без обязательств.",
        visitProject: "Открыть проект",
        scopeEyebrow: "План проекта",
        scopeCount: "приоритетные задачи",
        scopeFooter: "Каждая задача связана с измеримым результатом для бизнеса.",
      };

const painIntro = `${page.breadcrumbLabel}: ${ui.painIntro}`;
const deliverIntro = `${page.serviceDescription} ${ui.deliverIntro}`;
const processIntro = `${page.breadcrumbLabel}: ${ui.processIntro}`;
const relatedIntro = `${page.breadcrumbLabel}: ${ui.relatedIntro}`;
const getRelatedAnchorText = (link: LandingPageData["relatedLinks"][number]) => {
  const isService = link.href.includes("/serviciiBlog/");
  if (lang === "ro") {
    return `${isService ? "Vezi serviciul" : "Vezi pagina"}: ${link.title}`;
  }

  return `${isService ? "Открыть услугу" : "Открыть страницу"}: ${link.title}`;
};

const offerUrl = page.primaryCta.href.startsWith("http")
  ? page.primaryCta.href
  : `${SITE_URL}${page.primaryCta.href}`;
const pricedOffers = (page.packages ?? [])
  .filter((pkg) => typeof pkg.priceValue === "number")
  .map((pkg) => ({
    "@type": "Offer",
    name: pkg.name,
    description: pkg.description,
    price: pkg.priceValue,
    priceCurrency: "EUR",
    url: offerUrl,
    availability: "https://schema.org/InStock",
  }));

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: ui.homeLabel,
          item: lang === "ro" ? "https://moldovawebsite.md/" : "https://moldovawebsite.md/ru/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: page.breadcrumbLabel,
          item: page.canonicalUrl,
        },
      ],
    },
    {
      "@type": "WebPage",
      name: page.title,
      description: page.description,
      url: page.canonicalUrl,
      inLanguage: lang === "ro" ? "ro-MD" : "ru-MD",
    },
    {
      "@type": "Service",
      serviceType: page.serviceType,
      name: page.serviceName,
      description: page.serviceDescription,
      provider: {
        "@type": "ProfessionalService",
        name: "moldovawebsite.md",
        url: SITE_URL,
        email: CONTACT_EMAIL,
        telephone: CONTACT_PHONE,
        address: {
          "@type": "PostalAddress",
          addressLocality: lang === "ro" ? "Chisinau" : "Кишинев",
          addressCountry: "MD",
        },
      },
      areaServed: {
        "@type": "Country",
        name: lang === "ro" ? "Moldova" : "Молдова",
      },
      availableLanguage: ["ro", "ru"],
      url: page.canonicalUrl,
      offers:
        pricedOffers.length > 0
          ? pricedOffers
          : {
              "@type": "Offer",
              url: offerUrl,
              priceCurrency: "EUR",
              availability: "https://schema.org/InStock",
            },
    },
    {
      "@type": "FAQPage",
      mainEntity: page.faqs.map((faq) => ({
        "@type": "Question",
        name: faq.question,
        acceptedAnswer: {
          "@type": "Answer",
          text: faq.answer,
        },
      })),
    },
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <BaseHead
      title={page.title}
      description={page.description}
      canonicalUrl={page.canonicalUrl}
      hreflangRo={page.hreflangRo}
      hreflangRu={page.hreflangRu}
      lang={lang}
      ogLocale={lang === "ro" ? "ro_MD" : "ru_MD"}
      jsonLd={jsonLd}
    />
  </head>
  <body class="dev-theme">
    <div class="dev-grid-pattern"></div>
    <Header lang={lang} />

    <section class="dev-hero">
      <div class="container">
        <div class="dev-hero-grid">
          <div class="dev-hero-content">
            <span class="dev-hero-badge">{page.heroTag}</span>
            <h1>{page.h1}</h1>
            <p class="dev-hero-subtitle">{page.intro}</p>
            <p>{page.lead}</p>
            <div class="dev-hero-actions">
              <a href={page.primaryCta.href} class="dev-btn dev-btn-primary">
                {page.primaryCta.title}
              </a>
              <a href={page.secondaryCta.href} class="dev-btn dev-btn-secondary">
                {page.secondaryCta.title}
              </a>
            </div>
            <div class="dev-chip-group">
              {page.highlights.map((highlight) => (
                <span class="dev-chip active">{highlight}</span>
              ))}
            </div>
            <div class="dev-hero-stats">
              {page.stats.map((stat) => (
                <div class="dev-stat">
                  <div class="dev-stat-value">{stat.value}</div>
                  <div class="dev-stat-label">{stat.label}</div>
                </div>
              ))}
            </div>
          </div>

          <aside class="dev-scope-card" aria-label={ui.scopeEyebrow}>
            <div class="dev-scope-header">
              <span class="dev-scope-eyebrow">{ui.scopeEyebrow}</span>
              <span class="dev-scope-count">
                {page.painPoints.length} {ui.scopeCount}
              </span>
            </div>
            <div class="dev-scope-body">
              {page.painPoints.map((item, index) => (
                <div class="dev-scope-item">
                  <span class="dev-scope-number">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <strong>{item.title}</strong>
                </div>
              ))}
            </div>
            <p class="dev-scope-footer">{ui.scopeFooter}</p>
          </aside>
        </div>
      </div>
    </section>

    <nav class="dev-breadcrumbs" aria-label="breadcrumb">
      <div class="container">
        <ol>
          <li>
            <a href={lang === "ro" ? "/" : "/ru/"}>{ui.homeLabel}</a>
          </li>
          <li aria-hidden="true">/</li>
          <li>
            <span aria-current="page">{page.breadcrumbLabel}</span>
          </li>
        </ol>
      </div>
    </nav>

    {page.packages && page.packages.length > 0 && (
      <section class="dev-section dev-section-alt" id="pachete">
        <div class="container">
          <div class="dev-section-header">
            <span class="dev-section-tag">{ui.packagesTag}</span>
            <h2>{ui.packagesTitle}</h2>
            <p>{ui.packagesIntro}</p>
          </div>
          <div class="dev-pricing-grid">
            {page.packages.map((pkg) => (
              <article class={`dev-price-card ${pkg.featured ? "featured" : ""}`}>
                <span class="dev-card-title">{pkg.name}</span>
                <div class="dev-price">{pkg.price}</div>
                <p>{pkg.description}</p>
                <ul class="dev-price-features">
                  {pkg.features.map((feature) => <li>{feature}</li>)}
                </ul>
                {pkg.note && <p class="dev-price-note">{pkg.note}</p>}
                <a href={page.primaryCta.href} class="dev-btn dev-btn-primary">
                  {page.primaryCta.title}
                </a>
              </article>
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="dev-section">
      <div class="container">
        <div class="dev-section-header">
          <span class="dev-section-tag">{ui.painTag}</span>
          <h2>{ui.painTitle}</h2>
          <p>{painIntro}</p>
        </div>
        <div class="dev-info-grid">
          {page.painPoints.map((item) => (
            <div class="dev-info-card">
              <span class="dev-card-title">{item.title}</span>
              <p>{item.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {page.caseStudies && page.caseStudies.length > 0 && (
      <section class="dev-section dev-section-alt" id="portofoliu">
        <div class="container">
          <div class="dev-section-header">
            <span class="dev-section-tag">{ui.proofTag}</span>
            <h2>{ui.proofTitle}</h2>
            <p>{ui.proofIntro}</p>
          </div>
          <div class="dev-portfolio-grid">
            {page.caseStudies.map((item) => (
              <article class="dev-portfolio-card">
                <div class="dev-portfolio-image">
                  <img
                    src={item.image}
                    alt={item.title}
                    loading="lazy"
                    width="400"
                    height="250"
                  />
                  <div class="dev-portfolio-overlay">
                    <span class="dev-portfolio-category">{item.category}</span>
                  </div>
                </div>
                <div class="dev-portfolio-content">
                  <span class="dev-card-title">{item.title}</span>
                  <p>{item.description}</p>
                  <ul class="dev-portfolio-features">
                    {item.features.map((feature) => <li>{feature}</li>)}
                  </ul>
                  {item.href && (
                    <a
                      href={item.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="dev-portfolio-link"
                    >
                      {ui.visitProject}: {item.title}
                    </a>
                  )}
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="dev-section dev-section-alt">
      <div class="container">
        <div class="dev-section-header">
          <span class="dev-section-tag">{ui.deliverTag}</span>
          <h2>{ui.deliverTitle}</h2>
          <p>{deliverIntro}</p>
        </div>
        <div class="dev-services-grid">
          {page.deliverables.map((item) => (
            <div class="dev-service-card">
              <div class="dev-service-icon">{item.title.slice(0, 1)}</div>
              <span class="dev-card-title">{item.title}</span>
              <p>{item.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="dev-section">
      <div class="container">
        <div class="dev-section-header">
          <span class="dev-section-tag">{ui.processTag}</span>
          <h2>{ui.processTitle}</h2>
          <p>{processIntro}</p>
        </div>
        <div class="dev-process-grid">
          {page.process.map((item, index) => (
            <div class="dev-process-step">
              <div class="dev-process-number">{index + 1}</div>
              <span class="dev-card-title">{item.title}</span>
              <p>{item.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="dev-section dev-section-alt">
      <div class="container">
        <div class="dev-section-header">
          <span class="dev-section-tag">{ui.faqTag}</span>
          <h2>{ui.faqTitle}</h2>
          <p>{ui.faqIntro}</p>
        </div>
        <div class="dev-faq-list">
          {page.faqs.map((faq) => (
            <details class="dev-faq-item">
              <summary>{faq.question}</summary>
              <p>{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="dev-section">
      <div class="container">
        <div class="dev-section-header">
          <span class="dev-section-tag">{ui.relatedTag}</span>
          <h2>{ui.relatedTitle}</h2>
          <p>{relatedIntro}</p>
        </div>
        <div class="dev-info-grid">
          {page.relatedLinks.map((link) => (
            <article class="dev-info-card">
              <span class="dev-card-title">{link.title}</span>
              <p>{link.description}</p>
              <a href={link.href} class="dev-link-accent">
                {getRelatedAnchorText(link)}
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="dev-cta">
      <div class="container">
        <div class="dev-cta-content">
          <h2>{ui.ctaTitle}</h2>
          <p>{ui.ctaIntro}</p>
          <a href={page.primaryCta.href} class="dev-btn dev-btn-primary dev-btn-lg">
            {page.primaryCta.title}
          </a>
        </div>
      </div>
    </section>

    <Footer lang={lang} />
    <script src="/script.js" defer></script>
  </body>
</html>
