{
  "name": "moldovawebsitefull",
  "compatibility_date": "2025-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./dist/_worker.js/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/seo-moldova",
      "/seo-moldova/*",
      "/ru/seo-moldova",
      "/ru/seo-moldova/*",
      "/blog/using-mdx",
      "/blog/using-mdx/*"
    ]
  },
  "routes": [
    {
      "pattern": "chisinauweb.com",
      "zone_name": "chisinauweb.com",
      "custom_domain": true
    }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "CONTACT_FROM": "ChisinauWeb.com <noreply@chisinauweb.com>",
    "CONTACT_TO": "narcis.gusa@gmail.com",
    "REPLY_TO": "contact@chisinauweb.com"
  },
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["noreply@chisinauweb.com"]
    }
  ],
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true
}
